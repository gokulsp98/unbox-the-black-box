---
import BaseLayout from './BaseLayout.astro';
import Nav from '../components/Nav.astro';

interface Props {
  title: string;
  inlineStyle?: string;
}

const { title, inlineStyle } = Astro.props;
const siteUrl = 'https://gokulsp98.github.io';
const base = import.meta.env.BASE_URL;
const ogImagePath = `${siteUrl}${base}og/home.png`;
---
<BaseLayout
  title={title}
  inlineStyle={inlineStyle}
  description="Complex tech topics broken into clear, visual, story-driven episodes. How Your Code Runs, How FastAPI Works, How Claude Code Works — and more."
  ogImagePath={ogImagePath}
  canonicalPath={base}
  ogType="website"
>
  <Nav />
  <slot />
</BaseLayout>
