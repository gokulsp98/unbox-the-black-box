---
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { claudeCodeSeries } from '../../data/series';
const inlineStyle = `
::selection{background:#7b68ee;color:#fff}

.cc7-hero{background:linear-gradient(135deg,#7b68ee 0%,#4682b4 100%)}

.cc7-num{color:#7b68ee;background:#eeeafd}

/* ── Hero Art: Orbit Loop ── */
.orbit-art{margin:2.5rem auto 0;animation:fadeInUp 1.5s ease;max-width:16rem;text-align:center}
.orbit-wrap{width:10rem;height:10rem;position:relative;margin:0 auto 1.5rem}
.orbit-track{position:absolute;inset:0;border-radius:50%;border:0.125rem solid rgba(255,255,255,0.12)}
.orbit-track-inner{position:absolute;inset:1.75rem;border-radius:50%;border:0.125rem solid rgba(255,255,255,0.08)}
.orbit-center{position:absolute;inset:3rem;border-radius:50%;background:rgba(255,255,255,0.08);display:flex;align-items:center;justify-content:center}
.orbit-center-icon{font-family:'Fira Code',monospace;font-size:1.1rem;font-weight:900;color:#fff;animation:centerPulse 3s ease-in-out infinite}
@keyframes centerPulse{0%,100%{opacity:0.8}50%{opacity:1}}
.orbit-spinner{position:absolute;inset:0;animation:orbitSpin 10s linear infinite}
.orbit-dot{position:absolute;width:0.5rem;height:0.5rem;border-radius:50%;top:50%;left:50%;margin-top:-0.25rem;margin-left:-0.25rem}
.orbit-dot-1{transform:rotate(0deg) translateY(-5rem);background:#55efc4;box-shadow:0 0 0.375rem rgba(85,239,196,0.5)}
.orbit-dot-2{transform:rotate(120deg) translateY(-5rem);background:#74b9ff;box-shadow:0 0 0.375rem rgba(116,185,255,0.5)}
.orbit-dot-3{transform:rotate(240deg) translateY(-5rem);background:#dfe6e9;box-shadow:0 0 0.375rem rgba(223,230,233,0.4)}
@keyframes orbitSpin{to{transform:rotate(360deg)}}
.orbit-labels{display:flex;gap:0.625rem;justify-content:center;flex-wrap:wrap}
.orbit-lbl{font-family:'Fira Code',monospace;font-size:0.6rem;font-weight:700;padding:0.25rem 0.625rem;border-radius:2rem;color:#fff;animation:fadeInUp 2s ease}
.orbit-lbl-cache{background:rgba(85,239,196,0.25);border:0.0625rem solid rgba(85,239,196,0.4)}
.orbit-lbl-compact{background:rgba(116,185,255,0.25);border:0.0625rem solid rgba(116,185,255,0.4)}
.orbit-lbl-repeat{background:rgba(223,230,233,0.15);border:0.0625rem solid rgba(223,230,233,0.3)}

/* ── Section 01: Side-by-Side Flow Comparison ── */
.vflow-compare{display:grid;grid-template-columns:1fr 1fr;gap:1.5rem;max-width:50rem;margin:2rem auto;padding:0 1.5rem}
.vflow-section{background:#fff;border-radius:1rem;padding:1.25rem;border:0.0625rem solid #eee}
.vflow-title{font-family:'Fira Code',monospace;font-size:0.7rem;font-weight:700;color:#7b68ee;letter-spacing:0.125rem;text-align:center;margin-bottom:1.25rem}
.vflow-col{display:flex;flex-direction:column;align-items:center;gap:0}
.vflow-node{background:#eeeafd;border-radius:0.75rem;padding:0.625rem 1rem;text-align:center;width:100%}
.vflow-node-label{font-family:'Fira Code',monospace;font-size:0.5rem;font-weight:700;color:#7b68ee;letter-spacing:0.0625rem;margin-bottom:0.0625rem}
.vflow-node-text{font-size:0.8rem;font-weight:800;color:#2d3436}
.vflow-node-sub{font-family:'Fira Code',monospace;font-size:0.55rem;color:#888;margin-top:0.0625rem}
.vflow-node-server{background:linear-gradient(135deg,#7b68ee,#4682b4)}
.vflow-node-server .vflow-node-label{color:rgba(255,255,255,0.7)}
.vflow-node-server .vflow-node-text{color:#fff}
.vflow-node-server .vflow-node-sub{color:rgba(255,255,255,0.7)}
.vflow-arrow{display:flex;flex-direction:column;align-items:center;padding:0.125rem 0;position:relative;height:2rem}
.vflow-arrow-line{width:0.125rem;height:1.125rem;background:linear-gradient(to bottom,#7b68ee,rgba(123,104,238,0.3))}
.vflow-arrow-head{width:0;height:0;border-left:0.25rem solid transparent;border-right:0.25rem solid transparent;border-top:0.3125rem solid #7b68ee}
.vflow-arrow-tag{font-family:'Fira Code',monospace;font-size:0.45rem;font-weight:700;color:#7b68ee;position:absolute;right:-3.5rem;top:50%;transform:translateY(-50%);white-space:nowrap}
.vflow-dot{position:absolute;width:0.25rem;height:0.25rem;border-radius:50%;background:#7b68ee;box-shadow:0 0 0.25rem rgba(123,104,238,0.6);left:50%;margin-left:-0.125rem;animation:dotDrop 2s ease-in-out infinite}
@keyframes dotDrop{0%{top:0;opacity:0}15%{opacity:1}85%{opacity:1}100%{top:0.875rem;opacity:0}}
.vflow-cache-badge{display:inline-block;font-family:'Fira Code',monospace;font-size:0.5rem;font-weight:700;color:#00b894;background:rgba(0,184,148,0.15);padding:0.125rem 0.5rem;border-radius:1rem;margin-top:0.25rem;border:0.0625rem solid rgba(0,184,148,0.3)}
.vflow-cache-badge-warm{animation:cacheGlow 2.5s ease-in-out infinite}
@keyframes cacheGlow{0%,100%{box-shadow:none}50%{box-shadow:0 0 0.5rem rgba(0,184,148,0.25)}}

/* ── Section 02: Compaction Visual ── */
.compact-vis{max-width:50rem;margin:2rem auto;padding:0 1.5rem}
.compact-title{font-family:'Fira Code',monospace;font-size:0.75rem;font-weight:700;color:#7b68ee;letter-spacing:0.125rem;text-align:center;margin-bottom:1.5rem}
.compact-before-after{display:grid;grid-template-columns:1fr auto 1fr;gap:1rem;align-items:start}
.compact-panel{border-radius:1rem;padding:1.25rem;border:0.0625rem solid #eee;background:#fff}
.compact-panel-label{font-family:'Fira Code',monospace;font-size:0.6rem;font-weight:700;letter-spacing:0.125rem;margin-bottom:0.75rem;text-align:center}
.compact-panel-before .compact-panel-label{color:#e17055}
.compact-panel-after .compact-panel-label{color:#00b894}
.compact-msgs{display:flex;flex-direction:column;gap:0.3125rem}
.compact-msg{font-family:'Fira Code',monospace;font-size:0.6rem;padding:0.375rem 0.625rem;border-radius:0.375rem}
.compact-msg-user{background:#eeeafd;color:#7b68ee}
.compact-msg-ai{background:#e4eff6;color:#4682b4}
.compact-msg-tool{background:#e2f3f0;color:#3d9e91}
.compact-msg-summary{background:linear-gradient(135deg,#eeeafd,#e4eff6);color:#7b68ee;font-weight:700;border:0.0625rem solid rgba(123,104,238,0.15)}
.compact-arrow-mid{display:flex;flex-direction:column;align-items:center;justify-content:center;padding-top:3rem}
.compact-arrow-icon{font-size:1.25rem;color:#7b68ee}
.compact-arrow-text{font-family:'Fira Code',monospace;font-size:0.5rem;font-weight:700;color:#7b68ee;margin-top:0.25rem}
.compact-meter{margin-top:0.75rem;background:#f5f5f5;border-radius:1rem;height:0.375rem;overflow:hidden}
.compact-meter-fill{height:100%;border-radius:1rem}
.compact-meter-fill-full{width:95%;background:linear-gradient(90deg,#ffeaa7,#e17055)}
.compact-meter-fill-low{width:15%;background:linear-gradient(90deg,#55efc4,#00b894)}
.compact-meter-label{font-family:'Fira Code',monospace;font-size:0.5rem;color:#888;margin-top:0.1875rem;text-align:right}

/* ── Section 03: Side-by-Side Cards ── */
.versus{max-width:50rem;margin:2rem auto;padding:0 1.5rem}
.versus-title{font-family:'Fira Code',monospace;font-size:0.75rem;font-weight:700;color:#7b68ee;letter-spacing:0.125rem;text-align:center;margin-bottom:1.5rem}
.versus-row{display:grid;grid-template-columns:1fr 1fr;gap:1.5rem}
.versus-card{border-radius:1rem;padding:1.5rem;border:0.0625rem solid #eee;background:#fff;position:relative;overflow:hidden}
.versus-card::before{content:'';position:absolute;top:0;left:0;right:0;height:0.1875rem}
.versus-card-cache::before{background:linear-gradient(90deg,#00b894,#55efc4)}
.versus-card-compact::before{background:linear-gradient(90deg,#7b68ee,#a29bfe)}
.versus-icon{width:2.25rem;height:2.25rem;border-radius:0.625rem;display:flex;align-items:center;justify-content:center;margin-bottom:0.75rem}
.versus-icon-cache{background:#e8f8f5}
.versus-icon-compact{background:#eeeafd}
.versus-icon svg{width:1.125rem;height:1.125rem}
.versus-card-title{font-family:'Fira Code',monospace;font-size:0.85rem;font-weight:800;color:#2d3436;margin-bottom:0.75rem}
.versus-item{margin-bottom:0.5rem}
.versus-item-label{font-family:'Fira Code',monospace;font-size:0.55rem;font-weight:700;color:#888;letter-spacing:0.0625rem;margin-bottom:0.125rem}
.versus-item-val{font-size:0.85rem;color:#2d3436;line-height:1.5}
.versus-item-val-cache{color:#00b894;font-weight:600}
.versus-item-val-compact{color:#7b68ee;font-weight:600}

/* ── Section 04: Lifecycle Steps ── */
.lifecycle-steps{max-width:40rem;margin:2rem auto;padding:0 1.5rem}
.lcs-title{font-family:'Fira Code',monospace;font-size:0.75rem;font-weight:700;color:#7b68ee;letter-spacing:0.125rem;text-align:center;margin-bottom:1.5rem}
.lcs-grid{display:grid;grid-template-columns:1fr 1fr;gap:0.75rem}
.lcs-card{background:#fff;border-radius:0.875rem;padding:1rem;border:0.0625rem solid #eee;display:flex;gap:0.75rem;align-items:flex-start}
.lcs-num{font-family:'Fira Code',monospace;font-size:0.6rem;font-weight:900;width:1.5rem;height:1.5rem;border-radius:50%;display:flex;align-items:center;justify-content:center;flex-shrink:0}
.lcs-1 .lcs-num{color:#e17055;background:rgba(225,112,85,0.12)}
.lcs-2 .lcs-num{color:#00b894;background:rgba(0,184,148,0.12)}
.lcs-3 .lcs-num{color:#ffc048;background:rgba(255,192,72,0.12)}
.lcs-4 .lcs-num{color:#7b68ee;background:rgba(123,104,238,0.12)}
.lcs-5 .lcs-num{color:#e17055;background:rgba(225,112,85,0.12)}
.lcs-6 .lcs-num{color:#00b894;background:rgba(0,184,148,0.12)}
.lcs-name{font-family:'Fira Code',monospace;font-size:0.75rem;font-weight:800;color:#2d3436;margin-bottom:0.125rem}
.lcs-desc{font-size:0.8rem;color:#888;line-height:1.5}
.lcs-loop{grid-column:1/-1;text-align:center;padding:0.75rem}
.lcs-loop-tag{font-family:'Fira Code',monospace;font-size:0.65rem;font-weight:700;color:#7b68ee;background:#eeeafd;padding:0.375rem 1.25rem;border-radius:2rem;display:inline-block}

/* ── Section 05: Tips Cards ── */
.tips{max-width:50rem;margin:2rem auto;padding:0 1.5rem}
.tips-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(13rem,1fr));gap:1rem}
.tip-card{background:#fff;border-radius:1rem;padding:1.25rem 1.5rem;border:0.0625rem solid #eee;border-top:0.1875rem solid;transition:transform 0.3s,box-shadow 0.3s}
.tip-card:hover{transform:translateY(-0.25rem);box-shadow:0 0.5rem 1.5rem rgba(0,0,0,0.06)}
.tip-cache{border-top-color:#00b894}
.tip-tokens{border-top-color:#4682b4}
.tip-compact{border-top-color:#7b68ee}
.tip-cost{border-top-color:#ffc048}
.tip-icon-wrap{width:2.25rem;height:2.25rem;border-radius:0.625rem;display:flex;align-items:center;justify-content:center;margin-bottom:0.75rem}
.tip-cache .tip-icon-wrap{background:#e8f8f5}
.tip-tokens .tip-icon-wrap{background:#e4eff6}
.tip-compact .tip-icon-wrap{background:#eeeafd}
.tip-cost .tip-icon-wrap{background:#fff8e7}
.tip-icon-wrap svg{width:1.125rem;height:1.125rem}
.tip-title{font-family:'Fira Code',monospace;font-size:0.8rem;font-weight:800;color:#2d3436;margin-bottom:0.375rem}
.tip-desc{font-size:0.85rem;color:#888;line-height:1.7}

/* ── Series Recap Cards ── */
.recap-cards{max-width:50rem;margin:2rem auto;padding:0 1.5rem}
.recap-grid{display:flex;flex-direction:column;gap:0.75rem}
.rc-card{background:#fff;border-radius:0.875rem;padding:1rem 1.25rem;border:0.0625rem solid #eee;display:flex;gap:1rem;align-items:flex-start;transition:transform 0.3s}
.rc-card:hover{transform:translateX(0.25rem)}
.rc-ep{font-family:'Fira Code',monospace;font-size:0.6rem;font-weight:900;border-radius:0.375rem;padding:0.25rem 0.5rem;flex-shrink:0}
.rc-ep1{color:#7b68ee;background:#eeeafd}
.rc-ep2{color:#4682b4;background:#e4eff6}
.rc-ep3{color:#3d9e91;background:#e2f3f0}
.rc-ep4{color:#7b68ee;background:#eeeafd}
.rc-ep5{color:#3d9e91;background:#e2f3f0}
.rc-ep6{color:#4682b4;background:#e4eff6}
.rc-ep7{color:#7b68ee;background:#eeeafd}
.rc-text{font-size:0.85rem;color:#555;line-height:1.7}
.rc-text strong{color:#2d3436;font-weight:800}

/* ── Quiz overrides ── */
.quiz-ep7 .quiz-q-num{color:#7b68ee;background:#eeeafd}
.quiz-ep7 .quiz-reveal-btn{color:#7b68ee}
.quiz-ep7 .quiz-opt-letter{color:#7b68ee}
.quiz-ep7 .quiz-option:hover{border-color:#7b68ee;background:#f8f7ff}
.quiz-ep7 .quiz-answer-highlight{background:#eeeafd;border-left:0.25rem solid #7b68ee}
.quiz-ep7 .quiz-subtitle{color:#888;font-size:0.95rem;margin-bottom:2rem}

@keyframes fadeInUp{from{opacity:0;transform:translateY(1.5rem)}to{opacity:1;transform:translateY(0)}}
@media(max-width:40rem){
 .vflow-compare{grid-template-columns:1fr}
 .vflow-arrow-tag{font-size:0.4rem;right:-2.75rem}
 .compact-before-after{grid-template-columns:1fr;gap:0.75rem}
 .compact-arrow-mid{flex-direction:row;padding:0.5rem 0}
 .versus-row{grid-template-columns:1fr}
 .lcs-grid{grid-template-columns:1fr}
 .tips-grid{grid-template-columns:1fr}
 .rc-card{flex-direction:column;gap:0.5rem}
}
`;
const bodyHtml = `
<!-- ── Hero ── -->
<section class="hero cc7-hero">
  <div class="hero-badge">Episode 7 of 7</div>
  <h1>The Complete Picture</h1>
  <p style="color:rgba(255,255,255,0.95)">Putting it all together — the full lifecycle of a Claude Code conversation.</p>
  <div class="orbit-art">
    <div class="orbit-wrap">
      <div class="orbit-track"></div>
      <div class="orbit-track-inner"></div>
      <div class="orbit-center"><span class="orbit-center-icon">&#x221E;</span></div>
      <div class="orbit-spinner">
        <div class="orbit-dot orbit-dot-1"></div>
        <div class="orbit-dot orbit-dot-2"></div>
        <div class="orbit-dot orbit-dot-3"></div>
      </div>
    </div>
    <div class="orbit-labels">
      <span class="orbit-lbl orbit-lbl-cache">Cache</span>
      <span class="orbit-lbl orbit-lbl-compact">Compact</span>
      <span class="orbit-lbl orbit-lbl-repeat">Repeat</span>
    </div>
  </div>
</section>

<!-- ── Section 01: The Normal Flow ── -->
<section class="section reveal">
  <span class="section-num cc7-num">01</span>
  <h2>The Normal Flow</h2>
  <p>Here's what happens during a typical conversation, message by message:</p>
</section>

<!-- Side-by-side: Cold Start vs Cache Warm -->
<div class="vflow-compare reveal">
  <div class="vflow-section">
    <div class="vflow-title">MESSAGE 1 — COLD START</div>
    <div class="vflow-col">
      <div class="vflow-node">
        <div class="vflow-node-label">CLIENT</div>
        <div class="vflow-node-text">Your Terminal</div>
        <div class="vflow-node-sub">system prompt + message</div>
      </div>
      <div class="vflow-arrow">
        <div class="vflow-arrow-line"></div>
        <div class="vflow-dot"></div>
        <div class="vflow-arrow-head"></div>
        <div class="vflow-arrow-tag">full payload</div>
      </div>
      <div class="vflow-node vflow-node-server">
        <div class="vflow-node-label">SERVER</div>
        <div class="vflow-node-text">Claude API</div>
        <div class="vflow-node-sub">tokenize &#8594; process &#8594; respond</div>
        <div class="vflow-cache-badge">cache write (1.25&#215;)</div>
      </div>
      <div class="vflow-arrow">
        <div class="vflow-arrow-line"></div>
        <div class="vflow-dot" style="animation-delay:1.2s"></div>
        <div class="vflow-arrow-head"></div>
        <div class="vflow-arrow-tag">response</div>
      </div>
      <div class="vflow-node">
        <div class="vflow-node-label">CLIENT</div>
        <div class="vflow-node-text">Terminal Updated</div>
        <div class="vflow-node-sub">saved to session file</div>
      </div>
    </div>
  </div>

  <div class="vflow-section">
    <div class="vflow-title">MESSAGE 2+ — CACHE WARM</div>
    <div class="vflow-col">
      <div class="vflow-node">
        <div class="vflow-node-label">CLIENT</div>
        <div class="vflow-node-text">Your Terminal</div>
        <div class="vflow-node-sub">all previous + new message</div>
      </div>
      <div class="vflow-arrow">
        <div class="vflow-arrow-line"></div>
        <div class="vflow-dot"></div>
        <div class="vflow-arrow-head"></div>
        <div class="vflow-arrow-tag">full history</div>
      </div>
      <div class="vflow-node vflow-node-server">
        <div class="vflow-node-label">SERVER</div>
        <div class="vflow-node-text">Claude API</div>
        <div class="vflow-node-sub">prefix match &#8594; skip cached</div>
        <div class="vflow-cache-badge vflow-cache-badge-warm">cache hit (0.1&#215;)</div>
      </div>
      <div class="vflow-arrow">
        <div class="vflow-arrow-line"></div>
        <div class="vflow-dot" style="animation-delay:1.2s"></div>
        <div class="vflow-arrow-head"></div>
        <div class="vflow-arrow-tag">response</div>
      </div>
      <div class="vflow-node">
        <div class="vflow-node-label">CLIENT</div>
        <div class="vflow-node-text">Terminal Updated</div>
        <div class="vflow-node-sub">TTL resets to 5 min</div>
      </div>
    </div>
  </div>
</div>

<!-- ── Section 02: When Compaction Kicks In ── -->
<section class="section reveal">
  <span class="section-num cc7-num">02</span>
  <h2>When Compaction Kicks In</h2>
  <p>As the conversation grows, tokens accumulate. At some point, the context approaches the model's limit.</p>
</section>

<div class="compact-vis reveal">
  <div class="compact-title">WHAT COMPACTION LOOKS LIKE</div>
  <div class="compact-before-after">
    <div class="compact-panel compact-panel-before">
      <div class="compact-panel-label">BEFORE — ~95% FULL</div>
      <div class="compact-msgs">
        <div class="compact-msg compact-msg-user">You: "Read src/index.ts"</div>
        <div class="compact-msg compact-msg-tool">Tool: [250 lines of code]</div>
        <div class="compact-msg compact-msg-ai">Claude: "Here's what I found..."</div>
        <div class="compact-msg compact-msg-user">You: "Now fix the bug"</div>
        <div class="compact-msg compact-msg-tool">Tool: [diff output]</div>
        <div class="compact-msg compact-msg-ai">Claude: "Done, I changed..."</div>
        <div class="compact-msg compact-msg-user">You: "Run the tests"</div>
        <div class="compact-msg compact-msg-tool">Tool: [test results]</div>
        <div class="compact-msg compact-msg-ai">Claude: "All 42 tests pass."</div>
        <div class="compact-msg compact-msg-user">You: "Now refactor..."</div>
      </div>
      <div class="compact-meter"><div class="compact-meter-fill compact-meter-fill-full"></div></div>
      <div class="compact-meter-label">~950K tokens</div>
    </div>

    <div class="compact-arrow-mid">
      <div class="compact-arrow-icon">&#10132;</div>
      <div class="compact-arrow-text">compact</div>
    </div>

    <div class="compact-panel compact-panel-after">
      <div class="compact-panel-label">AFTER — ~6% FULL</div>
      <div class="compact-msgs">
        <div class="compact-msg compact-msg-summary">Summary: User explored src/index.ts, fixed a bug, ran tests (all pass), began refactoring...</div>
        <div class="compact-msg compact-msg-user">You: "Now refactor..."</div>
        <div class="compact-msg compact-msg-ai">Claude: "Sure, continuing..."</div>
      </div>
      <div class="compact-meter"><div class="compact-meter-fill compact-meter-fill-low"></div></div>
      <div class="compact-meter-label">~60K tokens</div>
    </div>
  </div>
</div>

<!-- ── Section 03: Cache and Compaction Working Together ── -->
<section class="section reveal">
  <span class="section-num cc7-num">03</span>
  <h2>Cache & Compaction Together</h2>
  <p>They solve different problems but work as complementary parts of the same system:</p>
</section>

<div class="versus reveal">
  <div class="versus-title">CACHING vs COMPACTION</div>
  <div class="versus-row">
    <div class="versus-card versus-card-cache">
      <div class="versus-icon versus-icon-cache">
        <svg viewBox="0 0 24 24" fill="none" stroke="#00b894" stroke-width="2" stroke-linecap="round"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
      </div>
      <div class="versus-card-title">Prompt Caching</div>
      <div class="versus-item"><div class="versus-item-label">Solves</div><div class="versus-item-val versus-item-val-cache">Expensive re-processing</div></div>
      <div class="versus-item"><div class="versus-item-label">How</div><div class="versus-item-val">Skip computation for repeated tokens</div></div>
      <div class="versus-item"><div class="versus-item-label">When</div><div class="versus-item-val">Every request (after the first)</div></div>
      <div class="versus-item"><div class="versus-item-label">Cost</div><div class="versus-item-val versus-item-val-cache">Reduces by ~76%+</div></div>
      <div class="versus-item"><div class="versus-item-label">Trade-off</div><div class="versus-item-val">None — fully transparent</div></div>
    </div>
    <div class="versus-card versus-card-compact">
      <div class="versus-icon versus-icon-compact">
        <svg viewBox="0 0 24 24" fill="none" stroke="#7b68ee" stroke-width="2" stroke-linecap="round"><path d="M21 3H3v18h18V3zM9 9h6M9 12h6M9 15h4"/><path d="M15 3v18"/></svg>
      </div>
      <div class="versus-card-title">Compaction</div>
      <div class="versus-item"><div class="versus-item-label">Solves</div><div class="versus-item-val versus-item-val-compact">Running out of space</div></div>
      <div class="versus-item"><div class="versus-item-label">How</div><div class="versus-item-val">Summarize old messages</div></div>
      <div class="versus-item"><div class="versus-item-label">When</div><div class="versus-item-val">At ~95% context capacity</div></div>
      <div class="versus-item"><div class="versus-item-label">Cost</div><div class="versus-item-val versus-item-val-compact">Resets token count</div></div>
      <div class="versus-item"><div class="versus-item-label">Trade-off</div><div class="versus-item-val">Loses detail from old messages</div></div>
    </div>
  </div>
</div>

<!-- ── Section 04: The Full Lifecycle ── -->
<section class="section reveal">
  <span class="section-num cc7-num">04</span>
  <h2>The Full Lifecycle</h2>
  <p>A long Claude Code session follows this cycle:</p>
</section>

<div class="lifecycle-steps reveal">
  <div class="lcs-title">SESSION LIFECYCLE</div>
  <div class="lcs-grid">
    <div class="lcs-card lcs-1">
      <div class="lcs-num">1</div>
      <div>
        <div class="lcs-name">Cold Start</div>
        <div class="lcs-desc">First message, full processing, cache write</div>
      </div>
    </div>
    <div class="lcs-card lcs-2">
      <div class="lcs-num">2</div>
      <div>
        <div class="lcs-name">Warm Phase</div>
        <div class="lcs-desc">Cache hits, costs stay low (0.1&#215;)</div>
      </div>
    </div>
    <div class="lcs-card lcs-3">
      <div class="lcs-num">3</div>
      <div>
        <div class="lcs-name">Growth</div>
        <div class="lcs-desc">Tokens climb as conversation grows</div>
      </div>
    </div>
    <div class="lcs-card lcs-4">
      <div class="lcs-num">4</div>
      <div>
        <div class="lcs-name">Compaction</div>
        <div class="lcs-desc">At ~95% full, old messages summarized</div>
      </div>
    </div>
    <div class="lcs-card lcs-5">
      <div class="lcs-num">5</div>
      <div>
        <div class="lcs-name">Cache Reset</div>
        <div class="lcs-desc">Cache invalidated, fresh write</div>
      </div>
    </div>
    <div class="lcs-card lcs-6">
      <div class="lcs-num">6</div>
      <div>
        <div class="lcs-name">Warm Again</div>
        <div class="lcs-desc">Cache rebuilds, costs drop again</div>
      </div>
    </div>
  </div>
  <div class="lcs-loop">
    <div class="lcs-loop-tag">&#8634; cycle repeats indefinitely</div>
  </div>
</div>

<!-- ── Section 05: Optimization Tips ── -->
<section class="section reveal">
  <span class="section-num cc7-num">05</span>
  <h2>Optimization Tips</h2>
  <p>Understanding these mechanics lets you work more efficiently:</p>
</section>

<div class="tips reveal">
  <div class="tips-grid">
    <div class="tip-card tip-cache">
      <div class="tip-icon-wrap">
        <svg viewBox="0 0 24 24" fill="none" stroke="#00b894" stroke-width="2" stroke-linecap="round"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
      </div>
      <div class="tip-title">Keep the Cache Warm</div>
      <div class="tip-desc">Send messages at least every 5 minutes during active work. The cache TTL resets with each request — just keep working naturally.</div>
    </div>
    <div class="tip-card tip-tokens">
      <div class="tip-icon-wrap">
        <svg viewBox="0 0 24 24" fill="none" stroke="#4682b4" stroke-width="2" stroke-linecap="round"><path d="M21 12a9 9 0 11-9-9"/><path d="M21 3v6h-6"/></svg>
      </div>
      <div class="tip-title">Reduce Token Accumulation</div>
      <div class="tip-desc">Read only the parts of files you need. Use targeted searches instead of broad file reads.</div>
    </div>
    <div class="tip-card tip-compact">
      <div class="tip-icon-wrap">
        <svg viewBox="0 0 24 24" fill="none" stroke="#7b68ee" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
      </div>
      <div class="tip-title">Work With Compaction</div>
      <div class="tip-desc">Restate important context rather than assuming it. Consider new sessions for new tasks.</div>
    </div>
    <div class="tip-card tip-cost">
      <div class="tip-icon-wrap">
        <svg viewBox="0 0 24 24" fill="none" stroke="#ffc048" stroke-width="2" stroke-linecap="round"><path d="M12 1v22M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6"/></svg>
      </div>
      <div class="tip-title">Manage Costs</div>
      <div class="tip-desc">Most cost is input tokens. Caching reduces this by ~76%+. Shorter, focused sessions cost less.</div>
    </div>
  </div>
</div>

<!-- ── RECAP — The Complete Series ── -->
<section class="section reveal">
  <span class="section-num">RECAP</span>
  <h2>The Complete Series</h2>
  <p>Over seven episodes, we covered how Claude Code actually works:</p>
</section>

<div class="recap-cards reveal">
  <div class="recap-grid">
    <div class="rc-card">
      <span class="rc-ep rc-ep1">EP 1</span>
      <span class="rc-text"><strong>LLMs predict the next token</strong> — one token at a time, choosing from probability distributions. Claude is one model, not separate text/code versions.</span>
    </div>
    <div class="rc-card">
      <span class="rc-ep rc-ep2">EP 2</span>
      <span class="rc-text"><strong>Claude Code is a CLI tool</strong> — it wraps the Claude API with file access, command execution, and session management. Same model underneath.</span>
    </div>
    <div class="rc-card">
      <span class="rc-ep rc-ep3">EP 3</span>
      <span class="rc-text"><strong>Sessions are local, the server is stateless</strong> — conversation history lives in local JSONL files. Every request re-sends the full history.</span>
    </div>
    <div class="rc-card">
      <span class="rc-ep rc-ep4">EP 4</span>
      <span class="rc-text"><strong>Costs grow with conversation length</strong> — because the full history is re-sent every time, input token costs accumulate with each message.</span>
    </div>
    <div class="rc-card">
      <span class="rc-ep rc-ep5">EP 5</span>
      <span class="rc-text"><strong>Prompt caching makes re-processing cheap</strong> — prefix-based matching lets the server skip computation for repeated tokens. 90% discount on cache reads.</span>
    </div>
    <div class="rc-card">
      <span class="rc-ep rc-ep6">EP 6</span>
      <span class="rc-text"><strong>Compaction prevents overflow</strong> — when the context window fills up, old messages are summarized to free space. Loses detail but keeps going.</span>
    </div>
    <div class="rc-card">
      <span class="rc-ep rc-ep7">EP 7</span>
      <span class="rc-text"><strong>It all works together</strong> — caching and compaction form a cycle: cache warms, conversation grows, compaction resets, and the cycle repeats.</span>
    </div>
  </div>
</div>

<!-- ── Quiz ── -->
<section class="section reveal quiz-ep7">
  <span class="section-num cc7-num">CHECKPOINT</span>
  <h2>Probe Your Thinking</h2>
  <p class="quiz-subtitle">No pressure. Just see what stuck.</p>

  <div class="quiz-grid">

  <!-- Q1 -->
  <div class="quiz-card">
    <div class="quiz-card-header">
      <span class="quiz-q-num">Q 01</span>
    </div>
    <p class="quiz-question">What happens to the prompt cache immediately after compaction?</p>
    <ul class="quiz-options">
      <li><button class="quiz-option" data-correct="true" type="button"><span class="quiz-opt-letter">A</span>It's invalidated — the token sequence changed, so the prefix no longer matches</button></li>
      <li><button class="quiz-option" type="button"><span class="quiz-opt-letter">B</span>It stays warm because the summary contains the same information</button></li>
      <li><button class="quiz-option" type="button"><span class="quiz-opt-letter">C</span>It's partially preserved — only the summarized portion is invalidated</button></li>
      <li><button class="quiz-option" type="button"><span class="quiz-opt-letter">D</span>It expires naturally after the 5-minute TTL</button></li>
    </ul>
    <button class="quiz-reveal-btn" type="button" aria-expanded="false">Show Answer <span class="quiz-chevron">&#9662;</span></button>
    <div class="quiz-answer">
      <div class="quiz-answer-inner">
        <div class="quiz-answer-highlight">&#10003; Correct: <strong>(A) Cache is invalidated</strong></div>
        <p class="quiz-answer-text">Compaction replaces old messages with a summary, completely changing the token sequence. Since prompt caching is prefix-based, the old prefix no longer matches, and the entire cache is invalidated.</p>
      </div>
    </div>
  </div>

  <!-- Q2 -->
  <div class="quiz-card">
    <div class="quiz-card-header">
      <span class="quiz-q-num">Q 02</span>
    </div>
    <p class="quiz-question">In the session lifecycle, what triggers the transition from "warm phase" to "compaction"?</p>
    <ul class="quiz-options">
      <li><button class="quiz-option" type="button"><span class="quiz-opt-letter">A</span>A specific number of messages (e.g., every 50 messages)</button></li>
      <li><button class="quiz-option" type="button"><span class="quiz-opt-letter">B</span>The cache TTL expiring after 5 minutes of inactivity</button></li>
      <li><button class="quiz-option" data-correct="true" type="button"><span class="quiz-opt-letter">C</span>The total token count approaching ~95% of the context window limit</button></li>
      <li><button class="quiz-option" type="button"><span class="quiz-opt-letter">D</span>The server running low on memory</button></li>
    </ul>
    <button class="quiz-reveal-btn" type="button" aria-expanded="false">Show Answer <span class="quiz-chevron">&#9662;</span></button>
    <div class="quiz-answer">
      <div class="quiz-answer-inner">
        <div class="quiz-answer-highlight">&#10003; Correct: <strong>(C) Token count approaching ~95%</strong></div>
        <p class="quiz-answer-text">Compaction is triggered by total token count, not message count. When the conversation reaches approximately 95% of the context window (e.g., ~950K of 1M tokens), Claude Code initiates compaction.</p>
      </div>
    </div>
  </div>

  <!-- Q3 -->
  <div class="quiz-card">
    <div class="quiz-card-header">
      <span class="quiz-q-num">Q 03</span>
    </div>
    <p class="quiz-question">Why is the fresh cache write after compaction much cheaper than it would have been before?</p>
    <ul class="quiz-options">
      <li><button class="quiz-option" type="button"><span class="quiz-opt-letter">A</span>The server gives a discount after compaction</button></li>
      <li><button class="quiz-option" data-correct="true" type="button"><span class="quiz-opt-letter">B</span>Compaction drastically reduces the token count, so fewer tokens to cache</button></li>
      <li><button class="quiz-option" type="button"><span class="quiz-opt-letter">C</span>Cache writes are always cheap — only 0.1× the base price</button></li>
      <li><button class="quiz-option" type="button"><span class="quiz-opt-letter">D</span>The summary tokens are exempt from cache write costs</button></li>
    </ul>
    <button class="quiz-reveal-btn" type="button" aria-expanded="false">Show Answer <span class="quiz-chevron">&#9662;</span></button>
    <div class="quiz-answer">
      <div class="quiz-answer-inner">
        <div class="quiz-answer-highlight">&#10003; Correct: <strong>(B) Fewer tokens to cache</strong></div>
        <p class="quiz-answer-text">Compaction might reduce the conversation from ~950K tokens to ~60K tokens. The cache write (at 1.25× base price) is on a much smaller token count, making it far cheaper than caching the pre-compaction conversation.</p>
      </div>
    </div>
  </div>

  <!-- Q4 -->
  <div class="quiz-card">
    <div class="quiz-card-header">
      <span class="quiz-q-num">Q 04</span>
    </div>
    <p class="quiz-question">Which optimization tip is INCORRECT?</p>
    <ul class="quiz-options">
      <li><button class="quiz-option" type="button"><span class="quiz-opt-letter">A</span>Send messages at least every 5 minutes to keep the cache warm</button></li>
      <li><button class="quiz-option" type="button"><span class="quiz-opt-letter">B</span>Use targeted file reads instead of reading entire large files</button></li>
      <li><button class="quiz-option" data-correct="true" type="button"><span class="quiz-opt-letter">C</span>Avoid starting new sessions — always continue existing ones to save money</button></li>
      <li><button class="quiz-option" type="button"><span class="quiz-opt-letter">D</span>Restate important context rather than assuming it from early messages</button></li>
    </ul>
    <button class="quiz-reveal-btn" type="button" aria-expanded="false">Show Answer <span class="quiz-chevron">&#9662;</span></button>
    <div class="quiz-answer">
      <div class="quiz-answer-inner">
        <div class="quiz-answer-highlight">&#10003; Correct: <strong>(C) Avoid starting new sessions</strong></div>
        <p class="quiz-answer-text">Starting a new session for a new task is often better than continuing a long one. Long sessions accumulate tokens faster, trigger more compactions (losing context), and cost more due to growing input sizes.</p>
      </div>
    </div>
  </div>

  </div>
</section>

<!-- ── Finale Banner ── -->
<section class="next-part reveal" style="background:linear-gradient(135deg,#7b68ee,#4682b4)">
  <h2>Series Complete!</h2>
  <p>You've finished all 7 episodes of "How Claude Code Works." You now understand the complete lifecycle — from tokens and sessions to caching, compaction, and beyond.</p>
