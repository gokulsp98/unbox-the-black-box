---
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { claudeCodeSeries } from '../../data/series';
const inlineStyle = `
::selection{background:#4682b4;color:#fff}

.cc2-hero{background:linear-gradient(135deg,#4682b4 0%,#3d9e91 100%)}

.cc2-num{color:#4682b4;background:#e4eff6}

/* ── Hero Art: CLI Window ── */
.cli-art{margin:2.5rem auto 0;animation:fadeInUp 1.5s ease;max-width:18rem}
.cli-window{background:#1e272e;border-radius:0.75rem;overflow:hidden;border:0.0625rem solid #485460;box-shadow:0 0.5rem 1.5rem rgba(0,0,0,0.3)}
.cli-bar{background:#2d3436;padding:0.5rem 0.75rem;display:flex;gap:0.375rem;align-items:center}
.cli-dot{width:0.5rem;height:0.5rem;border-radius:50%}
.cli-dot-r{background:#ff6b6b}.cli-dot-y{background:#feca57}.cli-dot-g{background:#55efc4}
.cli-bar-title{font-family:'Fira Code',monospace;font-size:0.6rem;color:#636e72;margin-left:0.5rem}
.cli-body{padding:0.875rem;font-family:'Fira Code',monospace;font-size:0.7rem;line-height:1.8}
.cli-prompt{color:#55efc4}
.cli-cmd{color:#dfe6e9}
.cli-output{color:#4682b4}
.cli-cursor{display:inline-block;width:0.5rem;height:0.875rem;background:#55efc4;animation:cursorBlink 1s step-end infinite;vertical-align:text-bottom}
@keyframes cursorBlink{0%,100%{opacity:1}50%{opacity:0}}

/* ── Model Tier Cards ── */
.tier-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1.25rem;max-width:50rem;margin:2rem auto;padding:0 1.5rem}
.tier-card{background:#1e272e;border-radius:1rem;padding:1.5rem;border:0.0625rem solid #485460;transition:transform 0.3s;text-align:center}
.tier-card:hover{transform:translateY(-0.25rem)}
.tier-badge{font-family:'Fira Code',monospace;font-size:0.65rem;font-weight:700;padding:0.25rem 0.75rem;border-radius:0.375rem;display:inline-block;margin-bottom:0.75rem;letter-spacing:0.0625rem}
.tb-opus{background:rgba(162,155,254,0.3);color:#a29bfe;border:0.0625rem solid #a29bfe}
.tb-sonnet{background:rgba(116,185,255,0.3);color:#4682b4;border:0.0625rem solid #4682b4}
.tb-haiku{background:rgba(85,239,196,0.3);color:#55efc4;border:0.0625rem solid #55efc4}
.tier-name{font-family:'Fira Code',monospace;font-size:1.1rem;font-weight:800;color:#fff;margin-bottom:0.25rem}
.tier-tagline{font-family:'Fira Code',monospace;font-size:0.7rem;color:#b2bec3;margin-bottom:1rem}
.tier-stat{display:flex;justify-content:space-between;padding:0.375rem 0;border-bottom:0.0625rem solid rgba(255,255,255,0.06);font-family:'Fira Code',monospace;font-size:0.7rem}
.tier-stat:last-child{border-bottom:none}
.tier-stat-label{color:#636e72}
.tier-stat-val{color:#dfe6e9;font-weight:700}
@media(max-width:37.5rem){.tier-grid{grid-template-columns:1fr}}

/* ── Pricing Table ── */
.price-table{max-width:42rem;margin:2rem auto;padding:0 1.5rem}
.pt-box{background:#1e272e;border-radius:1rem;padding:1.5rem;border:0.0625rem solid #485460;overflow-x:auto}
.pt-title{font-family:'Fira Code',monospace;font-size:0.7rem;font-weight:700;color:#b2bec3;letter-spacing:0.125rem;text-align:center;margin-bottom:1rem}
.pt-grid{display:grid;grid-template-columns:7.5rem repeat(3,1fr);gap:0}
.pt-cell{font-family:'Fira Code',monospace;font-size:0.7rem;padding:0.625rem 0.5rem;border-bottom:0.0625rem solid rgba(255,255,255,0.06);display:flex;align-items:center}
.pt-header{color:#636e72;font-weight:700;letter-spacing:0.0625rem;font-size:0.6rem}
.pt-row-label{color:#b2bec3;font-weight:700}
.pt-val{justify-content:center;color:#dfe6e9}
.pt-val-opus{color:#a29bfe}
.pt-val-sonnet{color:#4682b4}
.pt-val-haiku{color:#55efc4}
@media(max-width:37.5rem){.pt-grid{grid-template-columns:5rem repeat(3,1fr)}.pt-cell{font-size:0.6rem;padding:0.5rem 0.25rem}}

/* ── Context Window Gauge ── */
.ctx-gauge{max-width:36rem;margin:2rem auto;padding:0 1.5rem}
.cg-box{background:#1e272e;border-radius:1rem;padding:1.5rem;border:0.0625rem solid #485460}
.cg-title{font-family:'Fira Code',monospace;font-size:0.7rem;font-weight:700;color:#b2bec3;letter-spacing:0.125rem;text-align:center;margin-bottom:1.25rem}
.cg-row{display:flex;align-items:center;gap:0.75rem;margin-bottom:0.875rem}
.cg-label{font-family:'Fira Code',monospace;font-size:0.75rem;font-weight:700;min-width:5rem;text-align:right}
.cg-label-opus{color:#a29bfe}.cg-label-sonnet{color:#4682b4}.cg-label-haiku{color:#55efc4}
.cg-track{flex:1;height:1.5rem;background:rgba(255,255,255,0.06);border-radius:0.375rem;overflow:hidden;position:relative}
.cg-fill{height:100%;border-radius:0.375rem;display:flex;align-items:center;justify-content:center}
.cg-fill-opus{background:linear-gradient(90deg,#a29bfe,#6c5ce7);width:100%}
.cg-fill-sonnet{background:linear-gradient(90deg,#4682b4,#4682b4);width:100%}
.cg-fill-haiku{background:linear-gradient(90deg,#55efc4,#00b894);width:20%}
.cg-val{font-family:'Fira Code',monospace;font-size:0.6rem;font-weight:700;color:rgba(255,255,255,0.9)}
.cg-val-outside{font-family:'Fira Code',monospace;font-size:0.6rem;font-weight:700;color:#55efc4;margin-left:0.5rem}

/* ── CLI vs Web Comparison ── */
.compare-iface{display:grid;grid-template-columns:1fr 1fr;gap:1.25rem;max-width:44rem;margin:2rem auto;padding:0 1.5rem}
.ci-card{border-radius:1rem;padding:1.5rem;transition:transform 0.3s}
.ci-card:hover{transform:translateY(-0.25rem)}
.ci-web{background:#f0efff;border:0.125rem solid #d5ccff}
.ci-cli{background:#e4eff6;border:0.125rem solid #90caf9}
.ci-icon{font-size:2rem;margin-bottom:0.75rem}
.ci-card h4{font-size:1.1rem;font-weight:800;margin-bottom:0.5rem}
.ci-web h4{color:#6c5ce7}
.ci-cli h4{color:#4682b4}
.ci-list{list-style:none;padding:0;margin:0}
.ci-list li{font-size:0.85rem;padding:0.375rem 0;padding-left:1.25rem;position:relative;color:#555;line-height:1.5}
.ci-list li::before{content:'';position:absolute;left:0;top:0.75rem;width:0.375rem;height:0.375rem;border-radius:50%}
.ci-web .ci-list li::before{background:#6c5ce7}
.ci-cli .ci-list li::before{background:#4682b4}
@media(max-width:37.5rem){.compare-iface{grid-template-columns:1fr}}

/* ── Quiz theming: Episode 2 ── */
.quiz-ep2 .quiz-q-num{color:#4682b4;background:#e4eff6}
.quiz-ep2 .quiz-reveal-btn{color:#4682b4}
.quiz-ep2 .quiz-opt-letter{color:#4682b4}
.quiz-ep2 .quiz-option:hover{border-color:#4682b4;background:#f0f8ff}
.quiz-ep2 .quiz-answer-highlight{background:#e4eff6;border-left:0.25rem solid #4682b4}
`;
const bodyHtml = `

<!-- HERO -->
<section class="hero cc2-hero">
  <div class="hero-badge">Episode 2 of 7</div>
  <h1>What is<br>Claude Code?</h1>
  <p style="color:rgba(255,255,255,0.95)">The Claude model family, what they cost, and the CLI tool that puts AI directly in your terminal.</p>

  <div class="cli-art">
    <div class="cli-window">
      <div class="cli-bar">
        <span class="cli-dot cli-dot-r"></span>
        <span class="cli-dot cli-dot-y"></span>
        <span class="cli-dot cli-dot-g"></span>
        <span class="cli-bar-title">Terminal</span>
      </div>
      <div class="cli-body">
        <span class="cli-prompt">$</span> <span class="cli-cmd">claude</span><br>
        <span class="cli-output">&#9654; Reading project files...</span><br>
        <span class="cli-output">&#9654; Ready to help.</span><br>
        <span class="cli-prompt">&gt;</span> <span class="cli-cursor"></span>
      </div>
    </div>
  </div>
</section>

<!-- SECTION 01: MODEL FAMILY -->
<section class="section reveal">
  <span class="section-num cc2-num">01</span>
  <h2>The Claude Model Family</h2>
  <p>Claude isn't one model — it's a family of models, each built for different needs. Think of them as <span class="highlight">tiers</span>:</p>
</section>

<!-- MODEL TIER CARDS -->
<div class="tier-grid reveal">
  <div class="tier-card">
    <span class="tier-badge tb-opus">FLAGSHIP</span>
    <div class="tier-name">Opus 4.7</div>
    <div class="tier-tagline">Most capable</div>
    <div class="tier-stat"><span class="tier-stat-label">Speed</span><span class="tier-stat-val">Slowest</span></div>
    <div class="tier-stat"><span class="tier-stat-label">Quality</span><span class="tier-stat-val">Highest</span></div>
    <div class="tier-stat"><span class="tier-stat-label">Context</span><span class="tier-stat-val">1M tokens</span></div>
    <div class="tier-stat"><span class="tier-stat-label">Best For</span><span class="tier-stat-val">Complex tasks</span></div>
  </div>
  <div class="tier-card">
    <span class="tier-badge tb-sonnet">BALANCED</span>
    <div class="tier-name">Sonnet 4.6</div>
    <div class="tier-tagline">Fast &amp; capable</div>
    <div class="tier-stat"><span class="tier-stat-label">Speed</span><span class="tier-stat-val">Fast</span></div>
    <div class="tier-stat"><span class="tier-stat-label">Quality</span><span class="tier-stat-val">High</span></div>
    <div class="tier-stat"><span class="tier-stat-label">Context</span><span class="tier-stat-val">1M tokens</span></div>
    <div class="tier-stat"><span class="tier-stat-label">Best For</span><span class="tier-stat-val">General use</span></div>
  </div>
  <div class="tier-card">
    <span class="tier-badge tb-haiku">SPEED</span>
    <div class="tier-name">Haiku 4.5</div>
    <div class="tier-tagline">Fastest &amp; cheapest</div>
    <div class="tier-stat"><span class="tier-stat-label">Speed</span><span class="tier-stat-val">Fastest</span></div>
    <div class="tier-stat"><span class="tier-stat-label">Quality</span><span class="tier-stat-val">Good</span></div>
    <div class="tier-stat"><span class="tier-stat-label">Context</span><span class="tier-stat-val">200K tokens</span></div>
    <div class="tier-stat"><span class="tier-stat-label">Best For</span><span class="tier-stat-val">Simple/fast tasks</span></div>
  </div>
</div>

<section class="section reveal">
  <p><span class="highlight">Opus</span> is for when you need the best possible answer — complex reasoning, nuanced writing, hard coding tasks. <span class="highlight">Sonnet</span> is the default for most work — strong enough for nearly everything, at a fraction of Opus's cost. <span class="highlight-orange">Haiku</span> is for speed — simple tasks, classification, and high-volume use cases.</p>
</section>

<!-- SECTION 02: PRICING -->
<section class="section reveal">
  <span class="section-num cc2-num">02</span>
  <h2>What Things Cost</h2>
  <p>Every API call costs money, measured in tokens. Here's the pricing per <span class="highlight">million tokens</span> (MTok):</p>
</section>

<!-- PRICING TABLE -->
<div class="price-table reveal">
  <div class="pt-box">
    <div class="pt-title">PRICING PER MILLION TOKENS</div>
    <div class="pt-grid">
      <div class="pt-cell pt-header"></div>
      <div class="pt-cell pt-header" style="justify-content:center;color:#a29bfe">OPUS 4.7</div>
      <div class="pt-cell pt-header" style="justify-content:center;color:#4682b4">SONNET 4.6</div>
      <div class="pt-cell pt-header" style="justify-content:center;color:#55efc4">HAIKU 4.5</div>

      <div class="pt-cell pt-row-label">Input</div>
      <div class="pt-cell pt-val pt-val-opus">$5.00</div>
      <div class="pt-cell pt-val pt-val-sonnet">$3.00</div>
      <div class="pt-cell pt-val pt-val-haiku">$0.80</div>

      <div class="pt-cell pt-row-label">Cache read</div>
      <div class="pt-cell pt-val pt-val-opus">$0.50</div>
      <div class="pt-cell pt-val pt-val-sonnet">$0.30</div>
      <div class="pt-cell pt-val pt-val-haiku">$0.08</div>

      <div class="pt-cell pt-row-label">Output</div>
      <div class="pt-cell pt-val pt-val-opus">$25.00</div>
      <div class="pt-cell pt-val pt-val-sonnet">$15.00</div>
      <div class="pt-cell pt-val pt-val-haiku">$4.00</div>
    </div>
  </div>
</div>

<section class="section reveal">
  <p>Output tokens cost <span class="highlight-orange">5× more</span> than input tokens. Why? Generating new text (output) requires the model to run its full prediction cycle for every single token. Processing input is comparatively cheaper — the model reads it all at once in a single forward pass.</p>
</section>

<div class="analogy reveal">
  <p><strong>Cache read</strong> — when the same conversation prefix is sent again, Anthropic's servers can reuse previously computed results instead of reprocessing from scratch. Cache reads cost ~10× less than fresh input. We'll cover this in detail in Episode 5.</p>
</div>

<!-- SECTION 03: CONTEXT WINDOWS -->
<section class="section reveal">
  <span class="section-num cc2-num">03</span>
  <h2>Context Windows</h2>
  <p>The <span class="highlight">context window</span> is the maximum amount of text the model can "see" at once — your messages, its responses, system instructions, file contents, everything combined.</p>
</section>

<!-- CONTEXT WINDOW GAUGE -->
<div class="ctx-gauge reveal">
  <div class="cg-box">
    <div class="cg-title">CONTEXT WINDOW SIZE</div>
    <div class="cg-row">
      <span class="cg-label cg-label-opus">Opus</span>
      <div class="cg-track">
        <div class="cg-fill cg-fill-opus"><span class="cg-val">1,000,000 tokens</span></div>
      </div>
    </div>
    <div class="cg-row">
      <span class="cg-label cg-label-sonnet">Sonnet</span>
      <div class="cg-track">
        <div class="cg-fill cg-fill-sonnet"><span class="cg-val">1,000,000 tokens</span></div>
      </div>
    </div>
    <div class="cg-row">
      <span class="cg-label cg-label-haiku">Haiku</span>
      <div class="cg-track">
        <div class="cg-fill cg-fill-haiku"><span class="cg-val" style="font-size:0.55rem">200K</span></div>
      </div>
      <span class="cg-val-outside">200,000 tokens</span>
    </div>
  </div>
</div>

<section class="section reveal">
  <p>1 million tokens is enormous — roughly <span class="highlight">10 full novels</span>, or thousands of code files. But in practice, Claude Code conversations fill up faster than you'd think. Every message, every file read, every tool result accumulates.</p>
  <p>We'll explore this problem in <strong>Episodes 4 and 6</strong>.</p>
</section>

<!-- SECTION 04: WHAT IS CLAUDE CODE -->
<section class="section reveal">
  <span class="section-num cc2-num">04</span>
  <h2>What is Claude Code?</h2>
  <p>Claude Code is a <span class="highlight">command-line tool</span> that puts Claude directly in your terminal. Instead of copy-pasting code into a web chat, Claude Code can:</p>

  <div style="display:grid;gap:0.75rem;margin-top:1rem">
    <div style="background:#e4eff6;padding:1rem 1.5rem;border-radius:0.875rem;border-left:0.25rem solid #4682b4">
      <strong style="color:#4682b4">Read your files</strong> — it sees your actual codebase
    </div>
    <div style="background:#f0efff;padding:1rem 1.5rem;border-radius:0.875rem;border-left:0.25rem solid #6c5ce7">
      <strong style="color:#6c5ce7">Edit your files</strong> — it writes changes directly
    </div>
    <div style="background:#e0fafa;padding:1rem 1.5rem;border-radius:0.875rem;border-left:0.25rem solid #00cec9">
      <strong style="color:#00cec9">Run commands</strong> — it executes terminal commands and reads the output
    </div>
    <div style="background:#e8f8f5;padding:1rem 1.5rem;border-radius:0.875rem;border-left:0.25rem solid #00b894">
      <strong style="color:#00b894">Search your codebase</strong> — it finds relevant code across your project
    </div>
    <div style="background:#fef5e7;padding:1rem 1.5rem;border-radius:0.875rem;border-left:0.25rem solid #e17055">
      <strong style="color:#e17055">Use git</strong> — it creates commits, branches, and pull requests
    </div>
  </div>

  <h3 style="margin-top:2rem;font-size:1.2rem;color:#4682b4">Starting Claude Code</h3>

  <div class="code-block">
    <pre><span class="code-prompt">$</span> <span class="code-keyword">claude</span></pre>
  </div>

  <p>That's it. Just type <code>claude</code> in your terminal. It starts an interactive session where you can type requests and Claude responds — reading files, editing code, and running commands as needed.</p>

  <h3 style="margin-top:2rem;font-size:1.2rem;color:#4682b4">Resuming a Session</h3>

  <div class="code-block">
    <pre><span class="code-prompt">$</span> <span class="code-keyword">claude -r</span></pre>
  </div>

  <p>This shows your recent sessions and lets you pick one to resume. Sessions persist locally so you can continue where you left off.</p>
</section>

<!-- SECTION 05: INTERFACE COMPARISON -->
<section class="section reveal">
  <span class="section-num cc2-num">05</span>
  <h2>The Interface Changes, Not the Intelligence</h2>
  <p>This is the most common misconception: Claude Code does <span class="highlight-orange">not</span> use a different model than claude.ai. It uses the exact same Claude model. The difference is entirely in what surrounds the model:</p>
</section>

<!-- CLI vs WEB COMPARISON -->
<div class="compare-iface reveal">
  <div class="ci-card ci-web">
    <div class="ci-icon">&#127760;</div>
    <h4>claude.ai (Web)</h4>
    <ul class="ci-list">
      <li>You type text, it responds with text</li>
      <li>You can paste code or upload files</li>
      <li>No access to your file system</li>
      <li>No terminal commands</li>
    </ul>
  </div>
  <div class="ci-card ci-cli">
    <div class="ci-icon">&#128187;</div>
    <h4>Claude Code (CLI)</h4>
    <ul class="ci-list">
      <li>Same model, same intelligence</li>
      <li>Reads and edits your files directly</li>
      <li>Runs terminal commands</li>
      <li>Integrates with git</li>
    </ul>
  </div>
</div>

<section class="section reveal">
  <p>Under the hood, Claude Code is an <span class="highlight">API client</span>. It sends your conversation to the Claude API, receives the model's response, and if the model wants to use a tool (like reading a file), Claude Code executes that tool locally and sends the result back.</p>
  <p>The model never directly touches your computer — Claude Code is the middleman that translates between the model's "I want to read this file" and your operating system's actual file read.</p>
</section>

<!-- RECAP -->
<section class="section reveal">
  <span class="section-num">RECAP</span>
  <h2>What We Learned</h2>

  <div style="display:grid;gap:1rem;margin-top:1.25rem">
    <div style="background:#f0efff;padding:1.25rem 1.5rem;border-radius:0.875rem;border-left:0.25rem solid #6c5ce7">
      <strong style="color:#6c5ce7">Three model tiers</strong> — Opus (most capable, $5/$25 per MTok), Sonnet (balanced, $3/$15), Haiku (fastest, $0.80/$4). Output always costs 5× more than input.
    </div>
    <div style="background:#e4eff6;padding:1.25rem 1.5rem;border-radius:0.875rem;border-left:0.25rem solid #4682b4">
      <strong style="color:#4682b4">Context windows</strong> — Opus and Sonnet handle 1M tokens; Haiku handles 200K. That's the total conversation capacity.
    </div>
    <div style="background:#e0fafa;padding:1.25rem 1.5rem;border-radius:0.875rem;border-left:0.25rem solid #00cec9">
      <strong style="color:#00cec9">Claude Code is a CLI tool</strong> — it gives the same Claude model access to your files, terminal, and git. Start with <code>claude</code>, resume with <code>claude -r</code>.
    </div>
    <div style="background:#fef5e7;padding:1.25rem 1.5rem;border-radius:0.875rem;border-left:0.25rem solid #e17055">
      <strong style="color:#e17055">Same model, different tools</strong> — the web app and Claude Code use identical intelligence. The difference is the interface and available tools.
    </div>
  </div>
</section>

<!-- CHECKPOINT QUIZ -->
<section class="section reveal quiz-ep2">
  <span class="section-num cc2-num">CHECKPOINT</span>
  <h2>Probe Your Thinking</h2>
  <p class="quiz-subtitle">No pressure. Just see what stuck.</p>

  <div class="quiz-grid">

  <!-- Q1 -->
  <div class="quiz-card">
    <div class="quiz-card-header">
      <span class="quiz-q-num">Q 01</span>
    </div>
    <p class="quiz-question">Which Claude model has a 200K token context window?</p>
    <ul class="quiz-options">
      <li><button class="quiz-option" type="button"><span class="quiz-opt-letter">A</span>Opus 4.7</button></li>
      <li><button class="quiz-option" type="button"><span class="quiz-opt-letter">B</span>Sonnet 4.6</button></li>
      <li><button class="quiz-option" data-correct="true" type="button"><span class="quiz-opt-letter">C</span>Haiku 4.5</button></li>
      <li><button class="quiz-option" type="button"><span class="quiz-opt-letter">D</span>All three have 200K</button></li>
    </ul>
    <button class="quiz-reveal-btn" type="button" aria-expanded="false">Show Answer <span class="quiz-chevron">&#9662;</span></button>
    <div class="quiz-answer">
      <div class="quiz-answer-inner">
        <div class="quiz-answer-highlight">&#10003; Correct: <strong>(C) Haiku 4.5</strong></div>
        <p class="quiz-answer-text">Opus 4.7 and Sonnet 4.6 both support 1M token context windows. Only Haiku 4.5 has the smaller 200K window — it trades capacity for speed and lower cost.</p>
      </div>
    </div>
  </div>

  <!-- Q2 -->
  <div class="quiz-card">
    <div class="quiz-card-header">
      <span class="quiz-q-num">Q 02</span>
    </div>
    <p class="quiz-question">Why do output tokens cost more than input tokens?</p>
    <ul class="quiz-options">
      <li><button class="quiz-option" type="button"><span class="quiz-opt-letter">A</span>Output tokens use a different, larger model</button></li>
      <li><button class="quiz-option" data-correct="true" type="button"><span class="quiz-opt-letter">B</span>Each output token requires the model to run its full prediction cycle individually</button></li>
      <li><button class="quiz-option" type="button"><span class="quiz-opt-letter">C</span>Output tokens are stored permanently on Anthropic's servers</button></li>
      <li><button class="quiz-option" type="button"><span class="quiz-opt-letter">D</span>It's an arbitrary pricing decision with no technical reason</button></li>
    </ul>
    <button class="quiz-reveal-btn" type="button" aria-expanded="false">Show Answer <span class="quiz-chevron">&#9662;</span></button>
    <div class="quiz-answer">
      <div class="quiz-answer-inner">
        <div class="quiz-answer-highlight">&#10003; Correct: <strong>(B) Each output token requires the full prediction cycle</strong></div>
        <p class="quiz-answer-text">Input tokens are processed in one forward pass — the model reads them all at once. But output tokens must be generated one at a time, each requiring a separate computation cycle. That's 5× more compute-intensive.</p>
      </div>
    </div>
  </div>

  <!-- Q3 -->
  <div class="quiz-card">
    <div class="quiz-card-header">
      <span class="quiz-q-num">Q 03</span>
    </div>
    <p class="quiz-question">How do you start a new Claude Code session?</p>
    <ul class="quiz-options">
      <li><button class="quiz-option" type="button"><span class="quiz-opt-letter">A</span>claude chat</button></li>
      <li><button class="quiz-option" data-correct="true" type="button"><span class="quiz-opt-letter">B</span>claude</button></li>
      <li><button class="quiz-option" type="button"><span class="quiz-opt-letter">C</span>claude --start</button></li>
      <li><button class="quiz-option" type="button"><span class="quiz-opt-letter">D</span>claude-code init</button></li>
    </ul>
    <button class="quiz-reveal-btn" type="button" aria-expanded="false">Show Answer <span class="quiz-chevron">&#9662;</span></button>
    <div class="quiz-answer">
      <div class="quiz-answer-inner">
        <div class="quiz-answer-highlight">&#10003; Correct: <strong>(B) claude</strong></div>
        <p class="quiz-answer-text">Just type <code>claude</code> in your terminal. No subcommand needed. To resume a previous session, use <code>claude -r</code>.</p>
      </div>
    </div>
  </div>

  <!-- Q4 -->
  <div class="quiz-card">
    <div class="quiz-card-header">
      <span class="quiz-q-num">Q 04</span>
    </div>
    <p class="quiz-question">Claude Code uses a specialized "code model" that's different from the Claude model on claude.ai.</p>
    <ul class="quiz-options">
      <li><button class="quiz-option" type="button"><span class="quiz-opt-letter">A</span>True — it uses a code-optimized version</button></li>
      <li><button class="quiz-option" data-correct="true" type="button"><span class="quiz-opt-letter">B</span>False — same model, different interface and tools</button></li>
    </ul>
    <button class="quiz-reveal-btn" type="button" aria-expanded="false">Show Answer <span class="quiz-chevron">&#9662;</span></button>
    <div class="quiz-answer">
      <div class="quiz-answer-inner">
        <div class="quiz-answer-highlight">&#10003; Correct: <strong>(B) False</strong></div>
        <p class="quiz-answer-text">Claude Code is an API client that wraps the same Claude model. The difference is that it provides tools (file reading, editing, terminal commands) that the web app doesn't have. The model's intelligence is identical.</p>
      </div>
    </div>
  </div>
  </div>
</section>

