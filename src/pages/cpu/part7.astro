---
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { cpuSeries } from '../../data/series';
const inlineStyle = `
::selection{background:#6c5ce7;color:#fff}

.part7-hero{background:linear-gradient(135deg,#6c5ce7 0%,#0984e3 40%,#00b894 100%)}

.part7-num{color:#6c5ce7;background:#f0efff}

/* ── Hero Art: 4 Language Orbits ── */
.orbit-art{margin:2.5rem auto 0;position:relative;width:12.5rem;height:12.5rem;animation:fadeInUp 1.5s ease}
.orbit-center{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);font-family:'Fira Code',monospace;font-size:0.8rem;font-weight:700;color:#fff;background:rgba(255,255,255,0.15);border:2px solid rgba(255,255,255,0.3);width:3.5rem;height:3.5rem;border-radius:50%;display:flex;align-items:center;justify-content:center;letter-spacing:1px}
.orbit-ring{position:absolute;top:50%;left:50%;border:1.5px solid rgba(255,255,255,0.12);border-radius:50%}
.orbit-ring-1{width:8.125rem;height:8.125rem;margin:-4.0625rem 0 0 -4.0625rem;animation:orbitSpin 12s linear infinite}
.orbit-ring-2{width:11.25rem;height:11.25rem;margin:-5.625rem 0 0 -5.625rem;animation:orbitSpin 16s linear infinite reverse}
.orbit-dot{position:absolute;font-family:'Fira Code',monospace;font-size:0.6rem;font-weight:700;color:#fff;background:rgba(255,255,255,0.2);border:1.5px solid rgba(255,255,255,0.35);padding:0.25rem 0.5rem;border-radius:0.375rem;white-space:nowrap}
.orbit-ring-1 .orbit-dot:nth-child(1){top:-10px;left:50%;transform:translateX(-50%)}
.orbit-ring-1 .orbit-dot:nth-child(2){bottom:-10px;left:50%;transform:translateX(-50%)}
.orbit-ring-2 .orbit-dot:nth-child(1){top:-10px;left:50%;transform:translateX(-50%)}
.orbit-ring-2 .orbit-dot:nth-child(2){bottom:-10px;left:50%;transform:translateX(-50%)}
@keyframes orbitSpin{from{transform:rotate(0deg)}to{transform:rotate(360deg)}}
.hero-subtitle{font-family:'Fira Code',monospace;font-size:0.8rem;color:rgba(255,255,255,0.6);letter-spacing:2px;text-align:center;margin-top:1rem}

/* ── 4-Language Cards ── */
.lang-cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(13.75rem,1fr));gap:1.25rem;max-width:56.25rem;margin:2rem auto;padding:0 1.5rem}
.lang-card{border-radius:1rem;padding:1.5rem;text-align:center;transition:all 0.3s;position:relative;overflow:hidden}
.lang-card:hover{transform:translateY(-4px)}
.lang-card h4{font-size:1.1rem;font-weight:800;margin-bottom:0.375rem}
.lang-card .lang-when{font-family:'Fira Code',monospace;font-size:0.7rem;margin-bottom:0.75rem;opacity:0.8}
.lang-card .lang-flow{font-family:'Fira Code',monospace;font-size:0.65rem;line-height:1.8;text-align:left;background:rgba(0,0,0,0.06);border-radius:0.625rem;padding:0.75rem 0.875rem;margin-top:0.5rem}
.lc-c{background:#e8f8f5;border:2px solid #b8f0e0}
.lc-java{background:#f0efff;border:2px solid #d5ccff}
.lc-python{background:#fef5e7;border:2px solid #fdd9b5}
.lc-js{background:#e3f2fd;border:2px solid #90caf9}

/* ── Install Grid ── */
.install-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(12.5rem,1fr));gap:1rem;max-width:50rem;margin:2rem auto;padding:0 1.5rem}
.install-card{background:#2d3436;border-radius:0.875rem;padding:1.25rem;text-align:center;border:2px solid #636e72;transition:all 0.3s}
.install-card:hover{transform:translateY(-4px)}
.install-icon{font-size:2rem;margin-bottom:0.5rem;display:block}
.install-lang{font-family:'Fira Code',monospace;font-size:0.85rem;font-weight:700;color:#fff;margin-bottom:0.375rem}
.install-need{font-size:0.75rem;color:#00b894;font-weight:700;padding:0.25rem 0.75rem;border-radius:0.5rem;background:rgba(0,184,148,0.1);display:inline-block}
.install-none{color:#ff6b6b;background:rgba(255,107,107,0.1)}
.c-binary-art{display:flex;align-items:center;justify-content:center;gap:0.5rem;margin:0.625rem auto 0.25rem}
.c-file{width:1.75rem;height:2.125rem;background:linear-gradient(135deg,#00b894,#00cec9);border-radius:0.25rem 0.5rem 0.25rem 0.25rem;position:relative;display:flex;align-items:center;justify-content:center}
.c-file::after{content:'01';font-family:'Fira Code',monospace;font-size:0.45rem;font-weight:700;color:#fff}
.c-file::before{content:'';position:absolute;top:0;right:0;width:0.5rem;height:0.5rem;background:#2d3436;border-radius:0 0 0 0.25rem}
.c-arrow-run{font-size:0.7rem;color:rgba(255,255,255,0.4);animation:arrowPulse 2s ease infinite}
.c-cpu-tiny{font-family:'Fira Code',monospace;font-size:0.5rem;font-weight:700;color:#55efc4;background:rgba(85,239,196,0.15);border:1px solid rgba(85,239,196,0.3);padding:3px 6px;border-radius:0.25rem}

/* ── Why Grid ── */
.why-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(15rem,1fr));gap:1.25rem;max-width:56.25rem;margin:2rem auto;padding:0 1.5rem}
.why-card{border-radius:1rem;padding:1.5rem;transition:all 0.3s}
.why-card:hover{transform:translateY(-4px)}
.why-card h4{font-size:1rem;font-weight:800;margin-bottom:0.5rem}
.why-card p{font-size:0.85rem;line-height:1.6}
.why-card .why-lang{font-family:'Fira Code',monospace;font-size:0.75rem;font-weight:700;margin-bottom:0.5rem;display:inline-block;padding:0.25rem 0.75rem;border-radius:0.5rem}
.wc-green{background:#e8f8f5;border:2px solid #b8f0e0}
.wc-purple{background:#f0efff;border:2px solid #d5ccff}
.wc-blue{background:#e3f2fd;border:2px solid #90caf9}
.wc-amber{background:#fef5e7;border:2px solid #fdd9b5}

/* ── Finale Banner ── */
.finale-banner{background:linear-gradient(135deg,#6c5ce7,#0984e3,#00b894);padding:5rem 1.5rem;text-align:center;color:#fff;position:relative;overflow:hidden}
.finale-banner::before{content:'';position:absolute;width:25rem;height:25rem;border-radius:50%;background:rgba(255,255,255,0.04);top:-6.25rem;right:-6.25rem;animation:float 8s ease-in-out infinite}
.finale-banner h2{color:#fff;font-size:clamp(1.8rem,4vw,2.8rem);margin-bottom:0.75rem}
.finale-banner p{color:rgba(255,255,255,0.9);max-width:34.375rem;margin:0 auto 1.75rem;font-size:1.05rem}
.finale-badge{display:inline-block;background:rgba(255,255,255,0.2);border:1px solid rgba(255,255,255,0.3);padding:0.5rem 1.25rem;border-radius:1.875rem;font-size:0.85rem;font-weight:700;letter-spacing:1px;margin-bottom:1.25rem}

/* ── Quiz theming: Episode 7 ── */
.quiz-ep7 .quiz-q-num{color:#0984e3;background:#e3f2fd}
.quiz-ep7 .quiz-reveal-btn{color:#0984e3}
.quiz-ep7 .quiz-opt-letter{color:#0984e3}
.quiz-ep7 .quiz-option:hover{border-color:#0984e3;background:#f0f7ff}
.quiz-ep7 .quiz-answer-highlight{background:#e3f2fd;border-left:0.25rem solid #0984e3}
`;
const bodyHtml = `

<!-- HERO -->
<section class="hero part7-hero">
  <div class="hero-badge">Episode 7 of 7 &mdash; Finale</div>
  <h1>The Full<br>Picture</h1>
  <p style="color:rgba(255,255,255,0.95)">Four languages. Four paths to binary. One CPU that only understands ones and zeros. Now let's see them all side by side.</p>

  <div class="orbit-art">
    <div class="orbit-center">CPU</div>
    <div class="orbit-ring orbit-ring-1">
      <span class="orbit-dot">C</span>
      <span class="orbit-dot">Java</span>
    </div>
    <div class="orbit-ring orbit-ring-2">
      <span class="orbit-dot">Python</span>
      <span class="orbit-dot">JS</span>
    </div>
  </div>
  <div class="hero-subtitle">every path leads to binary</div>
</section>

<!-- SECTION 18: THE FULL PICTURE -->
<section class="section reveal">
  <span class="section-num part7-num">18</span>
  <h2>Four Paths, One Destination</h2>
  <p>Every one of these languages produces binary — the CPU demands it. But the journey is completely different:</p>
</section>

<!-- 4-LANGUAGE CARDS -->
<div class="lang-cards reveal">
  <div class="lang-card lc-c">
    <h4 style="color:#00b894">C</h4>
    <div class="lang-when">Binary: before you run it</div>
    <p style="font-size:0.85rem;color:#555">Compiled once. Saved to disk. CPU runs it directly. Fastest.</p>
    <div class="lang-flow">
      hello.c<br>
      &darr; gcc (compiler)<br>
      &darr; hello (binary on disk)<br>
      &darr; CPU runs it directly
    </div>
  </div>
  <div class="lang-card lc-java">
    <h4 style="color:#6c5ce7">Java</h4>
    <div class="lang-when">Binary: while it's running (JVM)</div>
    <p style="font-size:0.85rem;color:#555">Bytecode (.class) on disk. JVM creates native binary at runtime via JIT. Fast for long-running compute-heavy tasks.</p>
    <div class="lang-flow">
      Hello.java<br>
      &darr; javac &rarr; .class (bytecode)<br>
      &darr; JVM (with JIT)<br>
      &darr; binary in memory &rarr; CPU
    </div>
  </div>
  <div class="lang-card lc-python">
    <h4 style="color:#e17055">Python</h4>
    <div class="lang-when">Binary: one instruction at a time</div>
    <p style="font-size:0.85rem;color:#555">Bytecode cached as .pyc in __pycache__. Interpreter executes one instruction at a time. Slowest.</p>
    <div class="lang-flow">
      hello.py<br>
      &darr; CPython &rarr; .pyc (bytecode)<br>
      &darr; CPython interpreter<br>
      &darr; executes bytecode instruction by instruction
    </div>
  </div>
  <div class="lang-card lc-js">
    <h4 style="color:#0984e3">JavaScript</h4>
    <div class="lang-when">Binary: inside your browser</div>
    <p style="font-size:0.85rem;color:#555">Source shipped to browser. V8 JIT compiles. No install needed.</p>
    <div class="lang-flow">
      app.js<br>
      &darr; V8 engine (in browser)<br>
      &darr; bytecode &rarr; JIT<br>
      &darr; binary in memory &rarr; CPU
    </div>
  </div>
</div>

<!-- COMPARISON TABLE -->
<section class="section reveal">
  <div class="code-block">
    <pre>
<span class="code-comment">Language      When binary?             Saved to disk?     Speed</span>
<span class="code-comment">────────────  ───────────────────────  ─────────────────  ────────────────────</span>

<span class="code-keyword">C</span>             Before you run it        <span class="code-string">Yes (permanent)</span>    <span class="code-string">Fastest</span>

<span class="code-keyword">Java</span>          While running (JVM)      <span class="code-string">.class on disk;</span>    <span class="code-string">Fast (after warm-up)</span>
                                       <span class="code-string">JIT code in memory</span>

<span class="code-keyword">JavaScript</span>    While running (V8)       <span class="code-string">No (in browser)</span>    <span class="code-string">Fast (V8 JIT)</span>

<span class="code-keyword">Python</span>        While running            <span class="code-string">Bytecode (.pyc)</span>    <span class="code-string">Slowest</span>
              (instruction by instr.)  <span class="code-string">cached on disk</span>
</pre>
  </div>
</section>

<!-- WHAT YOU NEED INSTALLED -->
<section class="section reveal">
  <h3 style="font-size:1.3rem;color:#6c5ce7">What You Need Installed to Run Each</h3>
  <p>This is something people overlook. A C binary runs on its own — you just double-click it. But Java, Python, and JavaScript need a <span class="highlight">runtime</span> installed on the machine:</p>
</section>

<div class="install-grid reveal">
  <div class="install-card">
    <div class="c-binary-art">
      <div class="c-file"></div>
      <span class="c-arrow-run">&#10132;</span>
      <span class="c-cpu-tiny">CPU</span>
    </div>
    <div class="install-lang">C</div>
    <span class="install-need install-none">Nothing needed</span>
    <p style="font-size:0.7rem;color:#b2bec3;margin-top:0.5rem;margin-bottom:0">The binary IS the program</p>
  </div>
  <div class="install-card">
    <span class="install-icon">&#9749;</span>
    <div class="install-lang">Java</div>
    <span class="install-need">JVM required</span>
    <p style="font-size:0.7rem;color:#b2bec3;margin-top:0.5rem;margin-bottom:0">Without JVM, .class is useless</p>
  </div>
  <div class="install-card">
    <span class="install-icon">&#128013;</span>
    <div class="install-lang">Python</div>
    <span class="install-need">Interpreter required</span>
    <p style="font-size:0.7rem;color:#b2bec3;margin-top:0.5rem;margin-bottom:0">Without it, .py is just text</p>
  </div>
  <div class="install-card">
    <span class="install-icon">&#127760;</span>
    <div class="install-lang">JavaScript</div>
    <span class="install-need">A browser</span>
    <p style="font-size:0.7rem;color:#b2bec3;margin-top:0.5rem;margin-bottom:0">Every computer already has one</p>
  </div>
</div>

<section class="section reveal">
  <p>C binaries are self-contained — send the file, it runs. Java and Python need the user to install something first. JavaScript sidesteps this entirely because <span class="highlight-green">every computer already has a browser</span>.</p>
</section>

<!-- PORTABILITY TABLE -->
<section class="section reveal">
  <div class="code-block">
    <pre>
<span class="code-comment">Language      Portability              What to install     Dev Speed</span>
<span class="code-comment">────────────  ───────────────────────  ──────────────────  ─────────</span>

<span class="code-keyword">C</span>             Compile per platform     <span class="code-string">Nothing</span>             Slow

<span class="code-keyword">Java</span>          One file, any platform   <span class="code-string">JVM</span>                 Medium

<span class="code-keyword">JavaScript</span>    Runs in any browser      <span class="code-string">A browser</span>           Fast

<span class="code-keyword">Python</span>        Runs on any platform     <span class="code-string">Python interpreter</span>  Fastest
              with Python installed
</pre>
  </div>
</section>

<div class="analogy reveal">
  <p>The spectrum is always the same tradeoff: <strong>speed vs portability vs ease of use</strong>. No language wins all three. Each one picks a different balance.</p>
</div>

<!-- SECTION 19: WHY THEY ALL EXIST -->
<section class="section reveal">
  <span class="section-num part7-num">19</span>
  <h2>Why They All Exist</h2>
  <p>If one language could do everything, the others would disappear. But each solves a different problem:</p>
</section>

<div class="why-grid reveal">
  <div class="why-card wc-green">
    <span class="why-lang" style="background:#e8f8f5;color:#00b894">C / Rust</span>
    <h4>OS, game engine, embedded system?</h4>
    <p>Maximum speed and hardware control. Binary created once at compile time. CPU runs it directly with zero overhead. Nothing is faster. No runtime needed.</p>
  </div>
  <div class="why-card wc-purple">
    <span class="why-lang" style="background:#f0efff;color:#6c5ce7">Java</span>
    <h4>Banking, enterprise, Android?</h4>
    <p>Portability, reliability, and good performance. JVM creates binary at runtime, JIT closes the gap to C for compute-heavy workloads. One codebase runs everywhere. (Kotlin has been Google's preferred Android language since 2019, though Java still works.)</p>
  </div>
  <div class="why-card wc-blue">
    <span class="why-lang" style="background:#e3f2fd;color:#0984e3">JavaScript</span>
    <h4>Website or web app?</h4>
    <p>The language every browser runs natively (alongside WebAssembly). No installation, no compilation — the browser handles everything. V8's JIT makes it surprisingly fast.</p>
  </div>
  <div class="why-card wc-amber">
    <span class="why-lang" style="background:#fef5e7;color:#e17055">Python</span>
    <h4>Automation, data, AI prototype?</h4>
    <p>Build fast. Runtime speed doesn't matter because the heavy math runs in C libraries underneath. You wrote the entire program in an afternoon.</p>
  </div>
</div>

<section class="section reveal">
  <p style="text-align:center;font-size:1.2rem;font-weight:800;color:#6c5ce7">The choice is never about which language is "best."<br>It's about which tradeoff fits the problem.</p>
</section>

<!-- FINAL RECAP -->
<section class="section reveal">
  <span class="section-num">RECAP</span>
  <h2>The Complete Journey</h2>

  <div style="display:grid;gap:1rem;margin-top:1.25rem">
    <div style="background:#e8f8f5;padding:1.25rem 1.5rem;border-radius:0.875rem;border-left:4px solid #00b894">
      <strong style="color:#00b894">Everything becomes binary</strong> — the CPU only understands binary. This hasn't changed since Episode 1. Every language must produce it.
    </div>
    <div style="background:#fef5e7;padding:1.25rem 1.5rem;border-radius:0.875rem;border-left:4px solid #e17055">
      <strong style="color:#e17055">C</strong> compiles before running. <strong style="color:#6c5ce7">Java</strong> compiles at runtime via JVM. <strong style="color:#e17055">Python</strong> interprets line by line. <strong style="color:#0984e3">JavaScript</strong> lets the browser handle everything.
    </div>
    <div style="background:#e3f2fd;padding:1.25rem 1.5rem;border-radius:0.875rem;border-left:4px solid #0984e3">
      <strong style="color:#0984e3">Python is a glue language</strong> — the heavy work runs in C libraries at native binary speed. Python just orchestrates it.
    </div>
    <div style="background:#f0efff;padding:1.25rem 1.5rem;border-radius:0.875rem;border-left:4px solid #6c5ce7">
      <strong style="color:#6c5ce7">The tradeoff</strong> — speed vs portability vs developer time. No language wins all three. Each picks a different balance.
    </div>
  </div>
</section>

<!-- CHECKPOINT QUIZ -->
<section class="section reveal quiz-ep7">
  <span class="section-num">CHECKPOINT</span>
  <h2>Probe Your Thinking</h2>
  <p class="quiz-subtitle">No pressure. Just see what stuck.</p>

  <div class="quiz-grid">

  <div class="quiz-card">
    <div class="quiz-card-header">
      <span class="quiz-q-num">Q 01</span>
    </div>
    <p class="quiz-question">Which language creates its binary at compile time and saves it permanently to disk?</p>
    <ul class="quiz-options">
      <li><button class="quiz-option" data-correct="true" type="button"><span class="quiz-opt-letter">A</span>C</button></li>
      <li><button class="quiz-option" type="button"><span class="quiz-opt-letter">B</span>Java</button></li>
      <li><button class="quiz-option" type="button"><span class="quiz-opt-letter">C</span>Python</button></li>
      <li><button class="quiz-option" type="button"><span class="quiz-opt-letter">D</span>JavaScript</button></li>
    </ul>
    <button class="quiz-reveal-btn" type="button" aria-expanded="false">Show Answer <span class="quiz-chevron">▾</span></button>
    <div class="quiz-answer">
      <div class="quiz-answer-inner">
        <div class="quiz-answer-highlight">✓ Correct: <strong>(A) C</strong></div>
        <p class="quiz-answer-text">C compiles once to a binary file that's saved on disk. No runtime, no interpreter — just run the binary directly. Java creates binary at runtime via JIT, Python interprets line by line, and JavaScript is JIT-compiled in the browser.</p>
      </div>
    </div>
  </div>

  <div class="quiz-card">
    <div class="quiz-card-header">
      <span class="quiz-q-num">Q 02</span>
    </div>
    <p class="quiz-question">You need maximum performance for a systems-level program. Which language gives you the fastest execution?</p>
    <ul class="quiz-options">
      <li><button class="quiz-option" type="button"><span class="quiz-opt-letter">A</span>Python — it's the most popular</button></li>
      <li><button class="quiz-option" type="button"><span class="quiz-opt-letter">B</span>JavaScript — V8 is very fast</button></li>
      <li><button class="quiz-option" data-correct="true" type="button"><span class="quiz-opt-letter">C</span>C — pre-compiled native binary with no runtime overhead</button></li>
      <li><button class="quiz-option" type="button"><span class="quiz-opt-letter">D</span>Java — JIT makes it the fastest</button></li>
    </ul>
    <button class="quiz-reveal-btn" type="button" aria-expanded="false">Show Answer <span class="quiz-chevron">▾</span></button>
    <div class="quiz-answer">
      <div class="quiz-answer-inner">
        <div class="quiz-answer-highlight">✓ Correct: <strong>(C) C — pre-compiled native binary with no runtime overhead</strong></div>
        <p class="quiz-answer-text">C produces a pre-compiled binary that runs directly on the CPU with zero overhead. No interpreter, no JVM, no JIT warm-up — just raw speed. This is why operating systems, databases, and game engines are written in C/C++.</p>
      </div>
    </div>
  </div>

  <div class="quiz-card">
    <div class="quiz-card-header">
      <span class="quiz-q-num">Q 03</span>
    </div>
    <p class="quiz-question">What do C, Java, Python, and JavaScript all have in common?</p>
    <ul class="quiz-options">
      <li><button class="quiz-option" type="button"><span class="quiz-opt-letter">A</span>They all use JIT compilation</button></li>
      <li><button class="quiz-option" type="button"><span class="quiz-opt-letter">B</span>They all produce the same binary format</button></li>
      <li><button class="quiz-option" data-correct="true" type="button"><span class="quiz-opt-letter">C</span>They all must eventually become binary — the CPU only understands ones and zeros</button></li>
      <li><button class="quiz-option" type="button"><span class="quiz-opt-letter">D</span>They all require an interpreter to run</button></li>
    </ul>
    <button class="quiz-reveal-btn" type="button" aria-expanded="false">Show Answer <span class="quiz-chevron">▾</span></button>
    <div class="quiz-answer">
      <div class="quiz-answer-inner">
        <div class="quiz-answer-highlight">✓ Correct: <strong>(C) They all must eventually become binary — the CPU only understands ones and zeros</strong></div>
        <p class="quiz-answer-text">No matter how different these languages look, they all end up as binary. The only question is WHEN and HOW: C does it before running, Java and JS do it while running, Python does it one line at a time.</p>
      </div>
    </div>
  </div>

  <div class="quiz-card">
    <div class="quiz-card-header">
      <span class="quiz-q-num">Q 04</span>
    </div>
    <p class="quiz-question">Which language would you choose for a quick data analysis script where development speed matters most?</p>
    <ul class="quiz-options">
      <li><button class="quiz-option" type="button"><span class="quiz-opt-letter">A</span>C — it's the fastest execution</button></li>
      <li><button class="quiz-option" type="button"><span class="quiz-opt-letter">B</span>Java — it runs on any platform</button></li>
      <li><button class="quiz-option" data-correct="true" type="button"><span class="quiz-opt-letter">C</span>Python — fastest to write, with powerful data science libraries</button></li>
      <li><button class="quiz-option" type="button"><span class="quiz-opt-letter">D</span>JavaScript — it runs in the browser</button></li>
    </ul>
