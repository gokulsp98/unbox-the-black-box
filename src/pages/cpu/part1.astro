---
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { cpuSeries } from '../../data/series';
const inlineStyle = `
/* ── PAGE-SPECIFIC: CPU Art ── */
.cpu-hero{background:linear-gradient(135deg,#a29bfe 0%,#6c5ce7 40%,#0984e3 100%)}

.cpu-art{margin:2.5rem auto 0;position:relative;width:12.5rem;height:12.5rem;animation:fadeInUp 1.5s ease}
.cpu-chip{width:7.5rem;height:7.5rem;background:linear-gradient(145deg,#2d3436,#636e72);border-radius:0.75rem;position:absolute;top:2.5rem;left:2.5rem;display:flex;align-items:center;justify-content:center;box-shadow:0 8px 30px rgba(0,0,0,0.3);z-index:2}
.cpu-chip::after{content:'CPU';font-family:'Fira Code',monospace;font-size:1.1rem;color:#dfe6e9;font-weight:700;letter-spacing:3px}
.cpu-pin{position:absolute;background:#ffd32a;border-radius:2px}
.pin-top,.pin-bottom{width:4px;height:1rem}
.pin-left,.pin-right{width:1rem;height:4px}
.pin-top{top:1.5rem}.pin-bottom{bottom:1.5rem}.pin-left{left:1.5rem}.pin-right{right:1.5rem}
.pt1{left:3.4375rem}.pt2{left:4.6875rem}.pt3{left:5.9375rem}.pt4{left:7.1875rem}
.pb1{left:3.4375rem}.pb2{left:4.6875rem}.pb3{left:5.9375rem}.pb4{left:7.1875rem}
.pl1{top:3.4375rem}.pl2{top:4.6875rem}.pl3{top:5.9375rem}.pl4{top:7.1875rem}
.pr1{top:3.4375rem}.pr2{top:4.6875rem}.pr3{top:5.9375rem}.pr4{top:7.1875rem}
.cpu-glow{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:11.25rem;height:11.25rem;border-radius:50%;background:radial-gradient(circle,rgba(108,92,231,0.4) 0%,transparent 70%);animation:cpuPulse 3s ease-in-out infinite;z-index:1}
@keyframes cpuPulse{0%,100%{transform:translate(-50%,-50%) scale(1);opacity:0.5}50%{transform:translate(-50%,-50%) scale(1.2);opacity:0.8}}
.cpu-pin{animation:pinBlink 2s ease-in-out infinite alternate}
.pt1,.pl1,.pb3,.pr3{animation-delay:0s}
.pt2,.pl2,.pb2,.pr2{animation-delay:0.3s}
.pt3,.pl3,.pb1,.pr1{animation-delay:0.6s}
.pt4,.pl4,.pb4,.pr4{animation-delay:0.9s}
@keyframes pinBlink{0%{opacity:0.4;background:#ffd32a}100%{opacity:1;background:#55efc4}}
.cpu-info{position:absolute;font-family:'Fira Code',monospace;font-size:0.55rem;font-weight:700;padding:0.25rem 0.5rem;border-radius:0.375rem;background:rgba(255,255,255,0.12);border:1px solid rgba(255,255,255,0.2);color:rgba(255,255,255,0.85);white-space:nowrap;z-index:3;opacity:0;animation:infoFade 8s ease-in-out infinite}
.ci-1{top:0.625rem;right:-2.5rem;animation-delay:0s}
.ci-2{bottom:0.625rem;left:-2.25rem;animation-delay:2s}
.ci-3{top:0.625rem;left:-1.875rem;animation-delay:4s}
.ci-4{bottom:0.625rem;right:-2.75rem;animation-delay:6s}
@keyframes infoFade{0%,8%{opacity:0;transform:translateY(6px)}12%,30%{opacity:1;transform:translateY(0)}38%,100%{opacity:0;transform:translateY(-6px)}}

/* ── PAGE-SPECIFIC: World/Chip Section ── */
.world-section{background:linear-gradient(135deg,#0c2461,#0a3d62);padding:5rem 1.5rem;color:#fff;text-align:center;position:relative;overflow:hidden}
.world-section h2{color:#fff}
.world-section p{color:rgba(255,255,255,0.8)}
.chip-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(13.75rem,1fr));gap:1.25rem;max-width:50rem;margin:2.5rem auto 0}
.chip-card{background:rgba(255,255,255,0.08);border:1px solid rgba(255,255,255,0.15);border-radius:1rem;padding:1.5rem;text-align:left;transition:all 0.3s}
.chip-card:hover{background:rgba(255,255,255,0.14);transform:translateY(-4px)}
.chip-card .label{font-size:0.7rem;font-weight:800;text-transform:uppercase;letter-spacing:2px;margin-bottom:0.5rem;display:block}
.chip-card h4{font-size:1.2rem;font-weight:800;margin-bottom:0.5rem}
.chip-card p{font-size:0.9rem;line-height:1.6;color:rgba(255,255,255,0.7)}
.label-blue{color:#74b9ff}
.label-green{color:#55efc4}
.label-orange{color:#ffeaa7}

@media(max-width:37.5rem){
.chip-grid{grid-template-columns:1fr}
}

/* ── Quiz theming: Episode 1 ── */
.quiz-ep1 .quiz-q-num{color:#6c5ce7;background:#f0efff}
.quiz-ep1 .quiz-reveal-btn{color:#6c5ce7}
.quiz-ep1 .quiz-opt-letter{color:#6c5ce7}
.quiz-ep1 .quiz-option:hover{border-color:#6c5ce7;background:#f8f7ff}
.quiz-ep1 .quiz-answer-highlight{background:#f0efff;border-left:0.25rem solid #6c5ce7}
`;
const bodyHtml = `

<!-- HERO -->
<section class="hero cpu-hero">
  <div class="hero-badge">Episode 1 of 7</div>
  <h1>The Brain of<br>Your Computer</h1>
  <p style="color:rgba(255,255,255,0.95)">Ever wondered what really happens inside that little chip? Let's break it down — no engineering degree needed.</p>

  <div class="cpu-art">
    <div class="cpu-glow"></div>
    <div class="cpu-chip"></div>
    <div class="cpu-pin pin-top pt1"></div><div class="cpu-pin pin-top pt2"></div><div class="cpu-pin pin-top pt3"></div><div class="cpu-pin pin-top pt4"></div>
    <div class="cpu-pin pin-bottom pb1"></div><div class="cpu-pin pin-bottom pb2"></div><div class="cpu-pin pin-bottom pb3"></div><div class="cpu-pin pin-bottom pb4"></div>
    <div class="cpu-pin pin-left pl1"></div><div class="cpu-pin pin-left pl2"></div><div class="cpu-pin pin-left pl3"></div><div class="cpu-pin pin-left pl4"></div>
    <div class="cpu-pin pin-right pr1"></div><div class="cpu-pin pin-right pr2"></div><div class="cpu-pin pin-right pr3"></div><div class="cpu-pin pin-right pr4"></div>
    <span class="cpu-info ci-1">Fetch</span>
    <span class="cpu-info ci-2">Decode</span>
    <span class="cpu-info ci-3">Execute</span>
    <span class="cpu-info ci-4">Store</span>
  </div>
</section>

<!-- SECTION 1: WHAT IS A CPU -->
<section class="section reveal">
  <span class="section-num">01</span>
  <h2>What is a CPU?</h2>
  <p>The <span class="highlight">CPU (Central Processing Unit)</span> is a tiny chip — usually smaller than a postage stamp — that sits at the heart of every computer, phone, and smart device.</p>
  <p>It does one thing: <span class="highlight-orange">follow instructions</span>. Add these two numbers. Compare these values. Jump to the next step. It does billions of these simple operations every second.</p>
  <p>Every app you open, every website you load, every message you send — it all passes through this little chip.</p>
</section>

<!-- ANALOGY -->
<div class="analogy reveal">
  <p>Imagine a <strong>super-fast chef</strong> in a kitchen. The chef can only do simple actions — chop, stir, mix, plate — but does them at incredible speed. A recipe (your software) tells the chef exactly what to do, step by step. The CPU is that chef. The recipe is the program.</p>
</div>

<!-- SECTION 2: CODE TO BINARY -->
<section class="section reveal">
  <span class="section-num">02</span>
  <h2>From Human Language to Machine Language</h2>
  <p>When programmers write code, it looks something like this:</p>

  <div class="code-block">
    <pre><span class="code-comment">// Code written by a human</span>
<span class="code-keyword">if</span> (temperature > 30) {
    <span class="code-string">print("It's hot outside!")</span>
}</pre>
  </div>

  <p>But the CPU doesn't understand English, Python, or JavaScript. It only understands <span class="highlight">binary</span> — a stream of ones and zeros:</p>

  <div class="code-block">
    <pre><span class="code-comment">// What the CPU actually sees</span>
<span class="code-string">01001000 10001001 11100101 01001000
10000011 11101100 00001000 01001000
10111000 00000001 00000000 00000000</span></pre>
  </div>

  <p>So how does human-readable code become this? A program called a <span class="highlight-orange">compiler</span> does the translation.</p>
</section>

<!-- FLOW: SOURCE → BINARY -->
<div class="reveal" style="max-width:50rem;margin:0 auto;padding:0 1.5rem">
  <div class="flow">
    <div class="flow-box fb-purple">Your Code<br><small>human readable</small></div>
    <div class="flow-arrow">&#10132;</div>
    <div class="flow-box fb-orange">Compiler<br><small>translator</small></div>
    <div class="flow-arrow">&#10132;</div>
    <div class="flow-box fb-dark">Binary<br><small>CPU readable</small></div>
  </div>
</div>

<section class="section reveal">
  <p>The output of the compiler — that file full of ones and zeros — is called a <span class="highlight">"binary"</span>. It's called that because it's literally binary data. When you download an app or install software, you're downloading a binary that was compiled for your specific type of CPU.</p>
</section>

<!-- SECTION 3: INSTRUCTION SET -->
<section class="section reveal">
  <span class="section-num">03</span>
  <h2>The Language CPUs Speak</h2>
  <p>Every CPU has a fixed set of commands it understands — this is called its <span class="highlight">instruction set</span>. Think of it as a vocabulary:</p>

  <div class="code-block">
    <pre><span class="code-keyword">ADD</span>       <span class="code-comment">— add two numbers</span>
<span class="code-keyword">MOV</span>       <span class="code-comment">— move data from one place to another</span>
<span class="code-keyword">CMP</span>       <span class="code-comment">— compare two values</span>
<span class="code-keyword">JMP</span>       <span class="code-comment">— jump to another instruction</span>
<span class="code-keyword">LOAD</span>      <span class="code-comment">— read from memory</span>
<span class="code-keyword">STORE</span>     <span class="code-comment">— write to memory</span></pre>
  </div>

  <p>Every program you've ever used — from web browsers to video games — is just a long sequence of these simple commands, running billions of times per second.</p>
</section>

<div class="analogy reveal">
  <p>An instruction set is like a <strong>human language</strong>. English and Japanese are both languages, but a person who only speaks English can't understand Japanese. Similarly, a CPU built for one instruction set <strong>can't run code</strong> compiled for a different one.</p>
</div>

<!-- SECTION 4: THE TWO INSTRUCTION SETS -->
<section class="section reveal">
  <span class="section-num">04</span>
  <h2>Two Languages Rule the World</h2>
  <p>Before we dive in, let's clear up something that confuses many people: a <span class="highlight">chip</span> and an <span class="highlight-orange">instruction set</span> are not the same thing.</p>
</section>

<div class="analogy reveal">
  <p>A <strong>chip</strong> is the physical hardware — the tiny piece of silicon you can hold in your hand. An <strong>instruction set</strong> is the language that chip speaks. Many different chips can speak the <em>same</em> language. An Intel Core i5 from 2015 and an AMD Ryzen 9 from 2024 are completely different chips — but they both speak <strong>x86_64</strong>. So the same binary runs on both.</p>
</div>

<section class="section reveal">
  <p>This also explains <span class="highlight">backward compatibility</span>. Every new x86_64 chip supports the base instructions from 2003 plus optional newer ones:</p>

  <div class="code-block">
    <pre><span class="code-comment">// x86_64 instruction set</span>
<span class="code-keyword">Base instructions</span> (2003)    <span class="code-arrow">←</span>  <span class="code-string">every chip supports these</span>
<span class="code-keyword">SSE4</span> (2007–2008)            <span class="code-arrow">←</span>  <span class="code-string">most chips have it</span>
<span class="code-keyword">AVX</span>  (2011)                 <span class="code-arrow">←</span>  <span class="code-string">optional, common</span>
<span class="code-keyword">AVX-512</span> (2016)              <span class="code-arrow">←</span>  <span class="code-string">optional, only some chips</span></pre>
  </div>

  <p>Compilers use the base instructions by default, so the binary runs on <em>any</em> x86_64 chip — old or new. Newer extensions are opt-in. That's why a program compiled in 2010 still works on a chip from 2025.</p>
  <p>Now, out of all the instruction sets ever created, just <span class="highlight-orange">two</span> dominate almost every device on the planet:</p>
</section>

<div class="compare reveal">
  <div class="compare-card cc-blue">
    <span class="emoji">&#128421;</span>
    <h3>x86_64</h3>
    <p><strong>Where:</strong> Desktops, laptops, servers</p>
    <p><strong>Made by:</strong> Intel &amp; AMD</p>
    <p><strong>Philosophy:</strong> Complex &amp; powerful instructions</p>
    <p><strong>Power:</strong> Higher — needs a fan to cool down</p>
  </div>
  <div class="compare-card cc-red">
    <span class="emoji">&#128241;</span>
    <h3>ARM64</h3>
    <p><strong>Where:</strong> Phones, tablets, newer laptops, cloud servers</p>
    <p><strong>Made by:</strong> Many companies (licensed design)</p>
    <p><strong>Philosophy:</strong> Simple &amp; efficient instructions</p>
    <p><strong>Power:</strong> Lower — runs cool, great battery life</p>
  </div>
</div>

<section class="section reveal">
  <p>A binary compiled for x86_64 <span class="highlight-orange">won't run</span> on an ARM64 chip, and vice versa. They speak different languages. That's why software often needs to be compiled separately for each.</p>
  <p>Together, these two instruction sets cover <span class="highlight">the vast majority of all computing devices</span> in the world.</p>

  <h3 style="margin-top:2.5rem;font-size:1.4rem;color:#6c5ce7">So how many versions of software do you need?</h3>
  <p>A binary needs two things to match: the <span class="highlight">instruction set</span> and the <span class="highlight-orange">operating system</span>. Combine them, and you get one binary per combination:</p>

  <div class="code-block">
    <pre><span class="code-comment">// OS + instruction set = 1 binary</span>

<span class="code-keyword">Linux</span>     + x86_64   <span class="code-arrow">→</span>  <span class="code-string">1 binary</span>   <span class="code-comment">(all Intel/AMD servers)</span>
<span class="code-keyword">Linux</span>     + ARM64    <span class="code-arrow">→</span>  <span class="code-string">1 binary</span>   <span class="code-comment">(cloud servers, Raspberry Pi)</span>
<span class="code-keyword">macOS</span>     + ARM64    <span class="code-arrow">→</span>  <span class="code-string">1 binary</span>   <span class="code-comment">(all modern Macs)</span>
<span class="code-keyword">macOS</span>     + x86_64   <span class="code-arrow">→</span>  <span class="code-string">1 binary</span>   <span class="code-comment">(older Intel Macs)</span>
<span class="code-keyword">Windows</span>   + x86_64   <span class="code-arrow">→</span>  <span class="code-string">1 binary</span>   <span class="code-comment">(all Windows PCs)</span>

<span class="code-comment">Just 5 binaries cover nearly all machines on Earth.</span></pre>
  </div>

  <p>That's it. Not hundreds. Not one per chip model. Just one per OS + instruction set pair.</p>

  <h3 style="margin-top:2.5rem;font-size:1.4rem;color:#00b894">What about the rest?</h3>
  <p>Other instruction sets exist, but they serve niche roles:</p>

  <div style="display:grid;gap:0.75rem;margin-top:1rem">
    <div style="background:#e8f8f5;padding:1.125rem 1.5rem;border-radius:0.875rem;border-left:4px solid #00b894">
      <strong style="color:#00b894">RISC-V</strong> — the rising star. Fully open source — anyone can build a RISC-V chip with zero fees. Growing fast, especially in China and IoT devices. We'll cover this more in Episode 2.
    </div>
    <div style="background:#f0efff;padding:1.125rem 1.5rem;border-radius:0.875rem;border-left:4px solid #6c5ce7">
      <strong style="color:#6c5ce7">MIPS</strong> — once popular in routers and gaming consoles (PlayStation 1 &amp; 2). Mostly fading out now.
    </div>
    <div style="background:#fef5e7;padding:1.125rem 1.5rem;border-radius:0.875rem;border-left:4px solid #e17055">
      <strong style="color:#e17055">POWER</strong> — IBM's instruction set for mainframes and supercomputers. Powerful but rare outside enterprise.
    </div>
  </div>

  <p style="margin-top:1rem">For now, if you're using a computer, phone, or server — it's almost certainly running x86_64 or ARM64.</p>
</section>

<!-- SECTION 5: WHY x86_64 -->
<section class="section reveal">
  <span class="section-num">05</span>
  <h2>Where Do These Names Come From?</h2>
  <p>Both "x86_64" and "ARM64" sound like random codes. But each name tells a story. Let's start with x86_64:</p>
</section>

<div class="timeline reveal" style="max-width:43.75rem;margin:2.5rem auto;padding:0 1.5rem 0 4rem">
  <div class="timeline-item">
    <div class="timeline-year">1978</div>
    <div class="timeline-text">Intel releases the <strong>8086</strong> processor — the original ancestor</div>
  </div>
  <div class="timeline-item">
    <div class="timeline-year">1982</div>
    <div class="timeline-text">Intel 80<strong>286</strong> — people notice the pattern</div>
  </div>
  <div class="timeline-item">
    <div class="timeline-year">1985</div>
    <div class="timeline-text">Intel 80<strong>386</strong> — everyone starts calling the family <strong>"x86"</strong> <span class="timeline-chip">the name sticks</span></div>
  </div>
  <div class="timeline-item">
    <div class="timeline-year">1989</div>
    <div class="timeline-text">Intel 80<strong>486</strong> — last numbered chip</div>
  </div>
  <div class="timeline-item">
    <div class="timeline-year">1993</div>
    <div class="timeline-text">Intel <strong>Pentium</strong> — stopped using numbers, but the instruction set stayed "x86"</div>
  </div>
  <div class="timeline-item" style="margin-top:2.5rem">
    <div class="timeline-year">2003 — The Plot Twist</div>
    <div class="timeline-text"><strong>AMD</strong> (not Intel!) extends x86 to 64-bit and calls it <strong>AMD64</strong>. Intel had to adopt AMD's design. <span class="timeline-chip">ironic</span></div>
  </div>
</div>

<section class="section reveal">
  <p>So <span class="highlight">x86_64</span> literally means: the x86 family, extended to 64-bit. You'll also see it called <strong>amd64</strong> — same thing, named after the company that created the 64-bit extension.</p>

  <h3 style="margin-top:2.5rem;font-size:1.4rem;color:#e17055">And what about ARM64?</h3>
  <p><strong>ARM</strong> stands for <span class="highlight-orange">Advanced RISC Machines</span>. It was created in 1985 by a small British company called Acorn Computers — originally named the <em>Acorn RISC Machine</em>.</p>
  <p>The "64" simply means it's the 64-bit version of the ARM architecture. You'll also see it called <strong>aarch64</strong> (short for "ARM architecture 64-bit") — same thing, different name.</p>
  <p>Unlike x86 which only Intel and AMD can build, ARM Holdings <span class="highlight">licenses</span> their design to anyone willing to pay. That's why dozens of companies — from phone makers to cloud providers — build their own ARM chips.</p>
</section>

<!-- SECTION 6: WHO MAKES CHIPS -->
<section class="world-section reveal">
  <span class="section-num" style="background:rgba(255,255,255,0.15);color:#74b9ff">06</span>
  <h2 style="margin-top:1rem">Who Makes These Chips?</h2>
  <p style="max-width:37.5rem;margin:0 auto 0.5rem">The instruction set is the language. The chip is the physical hardware. Here's who builds them:</p>

  <div class="chip-grid">
    <div class="chip-card">
      <span class="label label-blue">x86_64 CHIPS</span>
      <h4>Intel</h4>
      <p>Core i3, i5, i7, i9, Xeon. The original x86 inventor. Dominates desktops and servers.</p>
    </div>
    <div class="chip-card">
      <span class="label label-blue">x86_64 CHIPS</span>
      <h4>AMD</h4>
      <p>Ryzen, EPYC, Threadripper. Created the 64-bit extension. Strong competitor to Intel.</p>
    </div>
    <div class="chip-card">
      <span class="label label-green">ARM64 CHIPS</span>
      <h4>Qualcomm</h4>
      <p>Snapdragon. Powers most Android phones and many Windows laptops.</p>
    </div>
    <div class="chip-card">
      <span class="label label-green">ARM64 CHIPS</span>
      <h4>Apple</h4>
      <p>M1, M2, M3, M4 series. Custom ARM chips for Mac and iPad.</p>
    </div>
    <div class="chip-card">
      <span class="label label-green">ARM64 CHIPS</span>
      <h4>Samsung</h4>
      <p>Exynos. Used in Samsung Galaxy phones in some regions.</p>
    </div>
    <div class="chip-card">
      <span class="label label-green">ARM64 CHIPS</span>
      <h4>Amazon (AWS)</h4>
      <p>Graviton. ARM chips built for cloud servers — cheaper and energy efficient.</p>
    </div>
  </div>

  <p style="margin-top:2rem;font-size:0.95rem;opacity:0.7">Notice: only <strong>2 companies</strong> make x86 chips, but <strong>many companies</strong> make ARM chips.<br>We'll explore why in Episode 2.</p>
</section>

<!-- RECAP -->
<section class="section reveal">
  <span class="section-num">RECAP</span>
  <h2>What We Learned</h2>

  <div style="display:grid;gap:1rem;margin-top:1.25rem">
    <div style="background:#f0efff;padding:1.25rem 1.5rem;border-radius:0.875rem;border-left:4px solid #6c5ce7">
      <strong style="color:#6c5ce7">The CPU</strong> is a tiny chip that follows billions of simple instructions every second.
    </div>
    <div style="background:#e8f8f5;padding:1.25rem 1.5rem;border-radius:0.875rem;border-left:4px solid #00b894">
      <strong style="color:#00b894">A compiler</strong> translates human-readable code into binary — the only language a CPU understands.
    </div>
    <div style="background:#fef5e7;padding:1.25rem 1.5rem;border-radius:0.875rem;border-left:4px solid #e17055">
      <strong style="color:#e17055">An instruction set</strong> is the vocabulary of commands a CPU knows. Two dominate the world: x86_64 and ARM64.
    </div>
    <div style="background:#ffeef7;padding:1.25rem 1.5rem;border-radius:0.875rem;border-left:4px solid #e84393">
      <strong style="color:#e84393">A binary</strong> is compiled for a specific instruction set + operating system. It won't work on a different combination.
    </div>
  </div>
</section>

<!-- CHECKPOINT QUIZ -->
<section class="section reveal quiz-ep1">
  <span class="section-num">CHECKPOINT</span>
  <h2>Probe Your Thinking</h2>
  <p class="quiz-subtitle">No pressure. Just see what stuck.</p>

  <div class="quiz-grid">

  <div class="quiz-card">
    <div class="quiz-card-header">
      <span class="quiz-q-num">Q 01</span>
    </div>
    <p class="quiz-question">What does a compiler do?</p>
    <ul class="quiz-options">
      <li><button class="quiz-option" type="button"><span class="quiz-opt-letter">A</span>Runs your code directly on the CPU</button></li>
      <li><button class="quiz-option" data-correct="true" type="button"><span class="quiz-opt-letter">B</span>Translates human-readable code into binary</button></li>
      <li><button class="quiz-option" type="button"><span class="quiz-opt-letter">C</span>Connects your computer to the internet</button></li>
      <li><button class="quiz-option" type="button"><span class="quiz-opt-letter">D</span>Stores data in memory</button></li>
    </ul>
    <button class="quiz-reveal-btn" type="button" aria-expanded="false">Show Answer <span class="quiz-chevron">▾</span></button>
    <div class="quiz-answer">
      <div class="quiz-answer-inner">
        <div class="quiz-answer-highlight">✓ Correct: <strong>(B) Translates human-readable code into binary</strong></div>
        <p class="quiz-answer-text">A compiler takes the code you write (in C, Java, etc.) and translates it into binary — the only language a CPU understands.</p>
      </div>
    </div>
  </div>

  <div class="quiz-card">
    <div class="quiz-card-header">
      <span class="quiz-q-num">Q 02</span>
    </div>
    <p class="quiz-question">What is an instruction set?</p>
    <ul class="quiz-options">
      <li><button class="quiz-option" type="button"><span class="quiz-opt-letter">A</span>A list of apps installed on your computer</button></li>
      <li><button class="quiz-option" type="button"><span class="quiz-opt-letter">B</span>The operating system's startup sequence</button></li>
      <li><button class="quiz-option" data-correct="true" type="button"><span class="quiz-opt-letter">C</span>The fixed vocabulary of commands a CPU understands</button></li>
      <li><button class="quiz-option" type="button"><span class="quiz-opt-letter">D</span>A programming language like Python or Java</button></li>
    </ul>
    <button class="quiz-reveal-btn" type="button" aria-expanded="false">Show Answer <span class="quiz-chevron">▾</span></button>
    <div class="quiz-answer">
      <div class="quiz-answer-inner">
        <div class="quiz-answer-highlight">✓ Correct: <strong>(C) The fixed vocabulary of commands a CPU understands</strong></div>
        <p class="quiz-answer-text">Every CPU has a fixed set of commands it knows — ADD, MOV, CMP, JMP, etc. This vocabulary is its instruction set. Different CPU families speak different instruction sets.</p>
      </div>
    </div>
  </div>

  <div class="quiz-card">
    <div class="quiz-card-header">
      <span class="quiz-q-num">Q 03</span>
    </div>
    <p class="quiz-question">Which two instruction sets cover the vast majority of all computing devices?</p>
    <ul class="quiz-options">
      <li><button class="quiz-option" type="button"><span class="quiz-opt-letter">A</span>RISC-V and MIPS</button></li>
      <li><button class="quiz-option" type="button"><span class="quiz-opt-letter">B</span>ARM64 and RISC-V</button></li>
      <li><button class="quiz-option" data-correct="true" type="button"><span class="quiz-opt-letter">C</span>x86_64 and ARM64</button></li>
      <li><button class="quiz-option" type="button"><span class="quiz-opt-letter">D</span>x86_64 and MIPS</button></li>
    </ul>
    <button class="quiz-reveal-btn" type="button" aria-expanded="false">Show Answer <span class="quiz-chevron">▾</span></button>
    <div class="quiz-answer">
      <div class="quiz-answer-inner">
        <div class="quiz-answer-highlight">✓ Correct: <strong>(C) x86_64 and ARM64</strong></div>
        <p class="quiz-answer-text">x86_64 (Intel/AMD) dominates desktops, laptops, and servers. ARM64 dominates phones, tablets, and newer laptops. Together they power virtually every device you use.</p>
      </div>
    </div>
  </div>

  <div class="quiz-card">
    <div class="quiz-card-header">
      <span class="quiz-q-num">Q 04</span>
    </div>
    <p class="quiz-question">Who created the 64-bit extension for the x86 instruction set?</p>
    <ul class="quiz-options">
      <li><button class="quiz-option" type="button"><span class="quiz-opt-letter">A</span>Intel</button></li>
      <li><button class="quiz-option" data-correct="true" type="button"><span class="quiz-opt-letter">B</span>AMD</button></li>
      <li><button class="quiz-option" type="button"><span class="quiz-opt-letter">C</span>ARM Holdings</button></li>
      <li><button class="quiz-option" type="button"><span class="quiz-opt-letter">D</span>Qualcomm</button></li>
    </ul>
    <button class="quiz-reveal-btn" type="button" aria-expanded="false">Show Answer <span class="quiz-chevron">▾</span></button>
    <div class="quiz-answer">
      <div class="quiz-answer-inner">
        <div class="quiz-answer-highlight">✓ Correct: <strong>(B) AMD</strong></div>
        <p class="quiz-answer-text">AMD created the 64-bit extension (AMD64) in 2003. Intel then adopted AMD's design — which is why x86_64 is also called amd64.</p>
      </div>
    </div>
  </div>

  </div>
</section>

<!-- NEXT PART -->
