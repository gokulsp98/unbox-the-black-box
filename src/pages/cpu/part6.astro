---
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { cpuSeries } from '../../data/series';
const inlineStyle = `
::selection{background:#feca57;color:#2d3436}

.part6-hero{background:linear-gradient(135deg,#feca57 0%,#0984e3 50%,#6c5ce7 100%)}

.part6-num{color:#0984e3;background:#e3f2fd}

/* ── Hero Art: Browser Window ── */
.hero-browser{margin:2.5rem auto 0;animation:fadeInUp 1.5s ease;max-width:20rem}
.hb-chrome{background:rgba(255,255,255,0.12);border-radius:0.75rem 0.75rem 0 0;padding:0.5rem 0.75rem;display:flex;align-items:center;gap:0.375rem}
.hb-dot{width:8px;height:8px;border-radius:50%}
.hb-dot:nth-child(1){background:rgba(255,107,107,0.7)}
.hb-dot:nth-child(2){background:rgba(254,202,87,0.7)}
.hb-dot:nth-child(3){background:rgba(0,184,148,0.7)}
.hb-bar{flex:1;background:rgba(255,255,255,0.1);border-radius:0.375rem;height:1.125rem;margin-left:0.375rem;display:flex;align-items:center;padding:0 0.5rem;font-family:'Fira Code',monospace;font-size:0.55rem;color:rgba(255,255,255,0.5)}
.hb-body{background:rgba(255,255,255,0.06);border-radius:0 0 0.75rem 0.75rem;padding:1.25rem 1rem;display:flex;align-items:center;justify-content:center;gap:0.75rem;flex-wrap:wrap}
.hb-tag{font-family:'Fira Code',monospace;font-size:0.75rem;font-weight:700;padding:0.375rem 0.875rem;border-radius:0.5rem}
.hb-js{background:rgba(254,202,87,0.2);color:#feca57;border:1px solid rgba(254,202,87,0.3)}
.hb-v8{background:rgba(0,184,148,0.2);color:#55efc4;border:1px solid rgba(0,184,148,0.3)}
.hb-bin{background:rgba(108,92,231,0.2);color:#a29bfe;border:1px solid rgba(108,92,231,0.3)}
.hb-arrow{color:rgba(255,255,255,0.35);font-size:1rem}
.hero-label-text{font-family:'Fira Code',monospace;font-size:0.8rem;color:rgba(255,255,255,0.65);letter-spacing:2px;text-align:center;margin-top:0.75rem}

/* ── Browser Window Illustration ── */
.browser-window{max-width:32.5rem;margin:2.5rem auto;padding:0 1.5rem}
.bw-chrome{background:#2d3436;border-radius:1rem 1rem 0 0;padding:0.75rem 1rem;display:flex;align-items:center;gap:0.5rem}
.bw-dot{width:10px;height:10px;border-radius:50%}
.bw-dot:nth-child(1){background:#ff6b6b}
.bw-dot:nth-child(2){background:#feca57}
.bw-dot:nth-child(3){background:#00b894}
.bw-bar{flex:1;background:#636e72;border-radius:0.5rem;height:1.625rem;margin-left:0.5rem;display:flex;align-items:center;padding:0 0.75rem;font-family:'Fira Code',monospace;font-size:0.7rem;color:#b2bec3}
.bw-body{background:linear-gradient(145deg,#1e1e2e,#2d3436);border-radius:0 0 1rem 1rem;padding:2rem 1.5rem;position:relative}
.bw-flow{display:flex;flex-direction:column;align-items:center;gap:0.75rem}
.bw-step{display:flex;align-items:center;gap:0.75rem;width:100%}
.bw-step-num{font-family:'Fira Code',monospace;font-size:0.65rem;font-weight:700;color:#636e72;min-width:1rem}
.bw-step-box{flex:1;font-family:'Fira Code',monospace;font-size:0.8rem;font-weight:600;padding:0.625rem 1rem;border-radius:0.625rem}
.bw-js{background:rgba(254,202,87,0.15);color:#feca57;border:1px solid rgba(254,202,87,0.25)}
.bw-byte{background:rgba(108,92,231,0.15);color:#a29bfe;border:1px solid rgba(108,92,231,0.25)}
.bw-jit{background:rgba(232,67,147,0.15);color:#fd79a8;border:1px solid rgba(232,67,147,0.25)}
.bw-bin{background:rgba(0,184,148,0.15);color:#55efc4;border:1px solid rgba(0,184,148,0.25)}
.bw-step-arrow{color:rgba(255,255,255,0.25);text-align:center;font-size:0.9rem}
.bw-v8-badge{position:absolute;top:0.75rem;right:1rem;font-family:'Fira Code',monospace;font-size:0.65rem;font-weight:700;color:#feca57;background:rgba(254,202,87,0.1);padding:0.25rem 0.625rem;border-radius:0.375rem;border:1px solid rgba(254,202,87,0.2);letter-spacing:1px}

/* ── Node.js callout ── */
.node-callout{max-width:37.5rem;margin:2rem auto;padding:0 1.5rem}
.node-box{background:#2d3436;border-radius:1rem;padding:1.5rem;display:flex;align-items:center;gap:1.25rem;border:2px solid #636e72}
.node-icon{font-size:2.5rem;flex-shrink:0}
.node-text{font-size:0.9rem;color:#dfe6e9;line-height:1.7}
.node-text strong{color:#00b894}

/* ── Quiz theming: Episode 6 ── */
.quiz-ep6 .quiz-q-num{color:#6c5ce7;background:#f0efff}
.quiz-ep6 .quiz-reveal-btn{color:#6c5ce7}
.quiz-ep6 .quiz-opt-letter{color:#6c5ce7}
.quiz-ep6 .quiz-option:hover{border-color:#6c5ce7;background:#f8f7ff}
.quiz-ep6 .quiz-answer-highlight{background:#f0efff;border-left:0.25rem solid #6c5ce7}
`;
const bodyHtml = `

<!-- HERO -->
<section class="hero part6-hero">
  <div class="hero-badge">Episode 6 of 7</div>
  <h1>JavaScript: Binary<br>Inside Your Browser</h1>
  <p style="color:rgba(255,255,255,0.95)">You don't install anything. No compiler, no JVM, no interpreter. The browser is the runtime — and every computer already has one.</p>

  <div class="hero-browser">
    <div class="hb-chrome">
      <div class="hb-dot"></div>
      <div class="hb-dot"></div>
      <div class="hb-dot"></div>
      <div class="hb-bar">yoursite.com</div>
    </div>
    <div class="hb-body">
      <span class="hb-tag hb-js">.js</span>
      <span class="hb-arrow">&#10132;</span>
      <span class="hb-tag hb-v8">V8</span>
      <span class="hb-arrow">&#10132;</span>
      <span class="hb-tag hb-bin">binary</span>
    </div>
  </div>
  <div class="hero-label-text">the browser is the runtime</div>
</section>

<!-- SECTION 17: JAVASCRIPT -->
<section class="section reveal">
  <span class="section-num part6-num">17</span>
  <h2>Ship Source Code, Not Binary</h2>
  <p>JavaScript is unique — it's the only major language where <span class="highlight">you ship source code directly to the user</span>. When you visit a website, your browser downloads <code>.js</code> files — raw source code — and runs them.</p>
  <p>There's no compile step, no bytecode file, nothing installed on the user's machine. The browser does everything.</p>
  <p>But how does it become binary? Chrome's <span class="highlight-orange">V8 engine</span> handles the entire journey:</p>
</section>

<!-- FLOW DIAGRAM -->
<div class="reveal" style="max-width:56.25rem;margin:0 auto;padding:0 1.5rem">
  <div class="flow">
    <div class="flow-box fb-purple">app.js<br><small>source</small></div>
    <div class="flow-arrow">&#10132;</div>
    <div class="flow-box fb-orange">V8 engine<br><small>in browser</small></div>
    <div class="flow-arrow">&#10132;</div>
    <div class="flow-box fb-purple">bytecode<br><small>in memory</small></div>
    <div class="flow-arrow">&#10132;</div>
    <div class="flow-box fb-dark">JIT<br><small>compiles</small></div>
    <div class="flow-arrow">&#10132;</div>
    <div class="flow-box fb-green">CPU<br><small>binary in memory</small></div>
  </div>
</div>

<!-- BROWSER WINDOW ILLUSTRATION -->
<div class="browser-window reveal">
  <div class="bw-chrome">
    <div class="bw-dot"></div>
    <div class="bw-dot"></div>
    <div class="bw-dot"></div>
    <div class="bw-bar">yoursite.com/app.js</div>
  </div>
  <div class="bw-body">
    <div class="bw-v8-badge">V8 ENGINE</div>
    <div class="bw-flow">
      <div class="bw-step">
        <span class="bw-step-num">1</span>
        <div class="bw-step-box bw-js">Download .js source code</div>
      </div>
      <div class="bw-step-arrow">&darr;</div>
      <div class="bw-step">
        <span class="bw-step-num">2</span>
        <div class="bw-step-box bw-byte">Parse &rarr; bytecode in memory</div>
      </div>
      <div class="bw-step-arrow">&darr;</div>
      <div class="bw-step">
        <span class="bw-step-num">3</span>
        <div class="bw-step-box bw-jit">JIT compiles hot paths</div>
      </div>
      <div class="bw-step-arrow">&darr;</div>
      <div class="bw-step">
        <span class="bw-step-num">4</span>
        <div class="bw-step-box bw-bin">Native binary &rarr; CPU runs it</div>
      </div>
    </div>
  </div>
</div>

<section class="section reveal">
  <p>V8 works a lot like Java's JVM — it interprets bytecode first, then JIT compiles frequently-run code into native binary. The JIT is so aggressive that JavaScript sometimes runs <span class="highlight-green">faster than Java</span>.</p>
  <p>The key difference from every other language: <span class="highlight">you don't install anything</span>. No compiler, no JVM, no interpreter. The browser <em>is</em> the runtime. Every computer with a browser can run JavaScript — that's why it powers the entire web.</p>
</section>

<!-- NODE.JS CALLOUT -->
<div class="node-callout reveal">
  <div class="node-box">
    <div class="node-icon">&#9881;</div>
    <div class="node-text">
      <strong>What about Node.js?</strong> It took V8 out of the browser and put it on servers. Same engine, same JIT — but now JavaScript runs anywhere, not just in browsers. That's how JavaScript became a full-stack language.
    </div>
  </div>
</div>

<!-- RECAP -->
<section class="section reveal">
  <span class="section-num">RECAP</span>
  <h2>What We Learned</h2>

  <div style="display:grid;gap:1rem;margin-top:1.25rem">
    <div style="background:#e3f2fd;padding:1.25rem 1.5rem;border-radius:0.875rem;border-left:4px solid #0984e3">
      <strong style="color:#0984e3">JavaScript ships source code</strong> — you don't compile, you don't build bytecode. The browser downloads raw .js files and the engine handles everything.
    </div>
    <div style="background:#fef5e7;padding:1.25rem 1.5rem;border-radius:0.875rem;border-left:4px solid #feca57">
      <strong style="color:#e17055">V8 uses JIT</strong> — just like Java's JVM. It interprets bytecode first, then compiles hot paths to native binary. So aggressive it sometimes beats Java.
    </div>
    <div style="background:#e8f8f5;padding:1.25rem 1.5rem;border-radius:0.875rem;border-left:4px solid #00b894">
      <strong style="color:#00b894">No installation needed</strong> — the browser is the runtime. Every computer with a browser can run JavaScript. That's why it powers the entire web.
    </div>
    <div style="background:#f0efff;padding:1.25rem 1.5rem;border-radius:0.875rem;border-left:4px solid #6c5ce7">
      <strong style="color:#6c5ce7">Node.js took V8 to the server</strong> — same engine, same JIT, but now JavaScript runs anywhere — not just in browsers.
    </div>
  </div>
</section>

<!-- CHECKPOINT QUIZ -->
<section class="section reveal quiz-ep6">
  <span class="section-num">CHECKPOINT</span>
  <h2>Probe Your Thinking</h2>
  <p class="quiz-subtitle">No pressure. Just see what stuck.</p>

  <div class="quiz-grid">

  <div class="quiz-card">
    <div class="quiz-card-header">
      <span class="quiz-q-num">Q 01</span>
    </div>
    <p class="quiz-question">What is the V8 engine?</p>
    <ul class="quiz-options">
      <li><button class="quiz-option" type="button"><span class="quiz-opt-letter">A</span>A car engine used by Google employees</button></li>
      <li><button class="quiz-option" data-correct="true" type="button"><span class="quiz-opt-letter">B</span>The JavaScript engine inside Chrome that compiles JS to native binary using JIT</button></li>
      <li><button class="quiz-option" type="button"><span class="quiz-opt-letter">C</span>A Python interpreter built by Google</button></li>
      <li><button class="quiz-option" type="button"><span class="quiz-opt-letter">D</span>A tool for compressing JavaScript files</button></li>
    </ul>
    <button class="quiz-reveal-btn" type="button" aria-expanded="false">Show Answer <span class="quiz-chevron">▾</span></button>
    <div class="quiz-answer">
      <div class="quiz-answer-inner">
        <div class="quiz-answer-highlight">✓ Correct: <strong>(B) The JavaScript engine inside Chrome that compiles JS to native binary using JIT</strong></div>
        <p class="quiz-answer-text">V8 is Google Chrome's JavaScript engine. It uses aggressive JIT compilation to turn JavaScript source code into optimized native binary — sometimes making JS faster than Java.</p>
      </div>
    </div>
  </div>

  <div class="quiz-card">
    <div class="quiz-card-header">
      <span class="quiz-q-num">Q 02</span>
    </div>
    <p class="quiz-question">Why doesn't JavaScript need users to install a runtime?</p>
    <ul class="quiz-options">
      <li><button class="quiz-option" type="button"><span class="quiz-opt-letter">A</span>JavaScript compiles to native binary like C</button></li>
      <li><button class="quiz-option" type="button"><span class="quiz-opt-letter">B</span>JavaScript runs directly on the CPU without any runtime</button></li>
      <li><button class="quiz-option" data-correct="true" type="button"><span class="quiz-opt-letter">C</span>The browser IS the runtime — every computer already has one</button></li>
      <li><button class="quiz-option" type="button"><span class="quiz-opt-letter">D</span>The operating system includes a JS interpreter</button></li>
    </ul>
    <button class="quiz-reveal-btn" type="button" aria-expanded="false">Show Answer <span class="quiz-chevron">▾</span></button>
    <div class="quiz-answer">
      <div class="quiz-answer-inner">
        <div class="quiz-answer-highlight">✓ Correct: <strong>(C) The browser IS the runtime — every computer already has one</strong></div>
        <p class="quiz-answer-text">Unlike Python (needs an interpreter) or Java (needs a JVM), JavaScript's runtime is the web browser — which is already installed on virtually every device. You ship source code and the browser handles execution.</p>
      </div>
    </div>
  </div>

  <div class="quiz-card">
    <div class="quiz-card-header">
      <span class="quiz-q-num">Q 03</span>
    </div>
    <p class="quiz-question">What is Node.js?</p>
    <ul class="quiz-options">
      <li><button class="quiz-option" type="button"><span class="quiz-opt-letter">A</span>A new programming language based on JavaScript</button></li>
      <li><button class="quiz-option" data-correct="true" type="button"><span class="quiz-opt-letter">B</span>V8 extracted from the browser so JavaScript can run on servers</button></li>
      <li><button class="quiz-option" type="button"><span class="quiz-opt-letter">C</span>A JavaScript compiler that produces native binaries</button></li>
      <li><button class="quiz-option" type="button"><span class="quiz-opt-letter">D</span>A web browser made by Node Inc.</button></li>
    </ul>
    <button class="quiz-reveal-btn" type="button" aria-expanded="false">Show Answer <span class="quiz-chevron">▾</span></button>
    <div class="quiz-answer">
      <div class="quiz-answer-inner">
        <div class="quiz-answer-highlight">✓ Correct: <strong>(B) V8 extracted from the browser so JavaScript can run on servers</strong></div>
        <p class="quiz-answer-text">Node.js takes Chrome's V8 engine and runs it outside the browser — letting you use JavaScript for server-side code, command-line tools, and more.</p>
      </div>
    </div>
  </div>

  <div class="quiz-card">
    <div class="quiz-card-header">
      <span class="quiz-q-num">Q 04</span>
    </div>
    <p class="quiz-question">How can JavaScript sometimes run faster than Java?</p>
    <ul class="quiz-options">
      <li><button class="quiz-option" type="button"><span class="quiz-opt-letter">A</span>JavaScript uses less memory</button></li>
      <li><button class="quiz-option" type="button"><span class="quiz-opt-letter">B</span>Browsers have special CPU instructions for JavaScript</button></li>
      <li><button class="quiz-option" data-correct="true" type="button"><span class="quiz-opt-letter">C</span>V8's aggressive JIT optimization compiles hot paths to highly optimized native binary</button></li>
      <li><button class="quiz-option" type="button"><span class="quiz-opt-letter">D</span>JavaScript skips the bytecode step entirely</button></li>
    </ul>
    <button class="quiz-reveal-btn" type="button" aria-expanded="false">Show Answer <span class="quiz-chevron">▾</span></button>
    <div class="quiz-answer">
      <div class="quiz-answer-inner">
        <div class="quiz-answer-highlight">✓ Correct: <strong>(C) V8's aggressive JIT optimization compiles hot paths to highly optimized native binary</strong></div>
        <p class="quiz-answer-text">V8 doesn't just compile — it aggressively optimizes. It uses techniques like hidden classes and inline caching to produce native binary that's sometimes faster than Java's JIT output.</p>
      </div>
    </div>
  </div>

  </div>
</section>

<!-- NEXT EPISODE -->
<section class="next-part" style="background:linear-gradient(135deg,#feca57,#0984e3)">
  <h2>Ready for the Finale?</h2>
  <p>We've seen all four paths to binary. Now let's put them side by side — the full comparison, what you need installed, and why each language exists.</p>
  <a href="part7.html" class="btn btn-white" style="color:#0984e3">Continue to Episode 7 &#10132;</a>
</section>
`;
---
<ArticleLayout title="How Your Code Runs — Episode 6: JavaScript — Binary Inside Your Browser | Unbox the Black Box" inlineStyle={inlineStyle} series={cpuSeries} episodeNum={6} hasQuiz={true}>
<Fragment set:html={bodyHtml} />
</ArticleLayout>
