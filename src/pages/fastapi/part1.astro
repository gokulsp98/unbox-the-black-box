<section class="section reveal">
  <h3 style="margin-top:2rem;font-size:1.2rem;color:#6c5ce7">Production</h3>
</section>

<div class="prod-stack reveal">
  <div class="ps-box">
    <div style="font-family:'Fira Code',monospace;font-size:0.65rem;color:#b2bec3;margin-bottom:0.5rem;letter-spacing:0.0625rem;text-align:center">SERVER / POD</div>
