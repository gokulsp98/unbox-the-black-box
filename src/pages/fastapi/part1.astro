---
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { fastapiSeries } from '../../data/series';
const inlineStyle = `
::selection{background:#00b894;color:#fff}

.part1-hero{background:linear-gradient(135deg,#00b894 0%,#0984e3 60%,#6c5ce7 100%)}

.part1-num{color:#00b894;background:#e8f8f5}

/* ── Hero Art: Stack Layers (staggered slide-in) ── */
.stack-art{margin:2.5rem auto 0;animation:fadeInUp 1.5s ease;display:flex;flex-direction:column;align-items:center;gap:0;max-width:16rem}
.stack-layer{font-family:'Fira Code',monospace;font-size:0.75rem;font-weight:700;padding:0.625rem 1.25rem;border-radius:0.625rem;text-align:center;width:100%;position:relative;opacity:0}
.sl-browser{background:rgba(255,255,255,0.15);color:#fff;border:0.0625rem solid rgba(255,255,255,0.35);width:100%;backdrop-filter:blur(0.25rem)}
.sl-gunicorn{background:rgba(108,92,231,0.4);color:#fff;border:0.0625rem solid rgba(162,155,254,0.5);width:88%}
.sl-uvicorn{background:rgba(9,132,227,0.4);color:#fff;border:0.0625rem solid rgba(116,185,255,0.5);width:76%}
.sl-fastapi{background:rgba(0,184,148,0.4);color:#fff;border:0.0625rem solid rgba(85,239,196,0.5);width:64%;box-shadow:0 0 1.5rem rgba(0,184,148,0.15)}
.stack-arrow{color:rgba(255,255,255,0.5);font-size:0.8rem;opacity:0;padding:0.125rem 0}
.stack-layer-1{animation:stackSlideIn 0.6s ease 0.5s forwards}
.stack-arrow-1{animation:stackSlideIn 0.4s ease 0.9s forwards}
.stack-layer-2{animation:stackSlideIn 0.6s ease 1.2s forwards}
.stack-arrow-2{animation:stackSlideIn 0.4s ease 1.6s forwards}
.stack-layer-3{animation:stackSlideIn 0.6s ease 1.9s forwards}
.stack-arrow-3{animation:stackSlideIn 0.4s ease 2.3s forwards}
.stack-layer-4{animation:stackSlideIn 0.6s ease 2.6s forwards,stackPulse 3s ease-in-out 3.5s infinite}
@keyframes stackSlideIn{from{opacity:0;transform:translateY(0.75rem)}to{opacity:1;transform:translateY(0)}}
@keyframes stackPulse{0%,100%{box-shadow:0 0 1.5rem rgba(0,184,148,0.15)}50%{box-shadow:0 0 1.5rem 0.375rem rgba(0,184,148,0.3)}}
.hero-label-text{font-family:'Fira Code',monospace;font-size:0.75rem;color:rgba(255,255,255,0.85);letter-spacing:0.125rem;text-align:center;margin-top:0.75rem}

/* ── Stage Cards ── */
.stage-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1.25rem;max-width:50rem;margin:2rem auto;padding:0 1.5rem}
.stage-card{background:#1e272e;border-radius:1rem;padding:1.5rem;text-align:left;transition:transform 0.3s;border:0.0625rem solid #485460}
.stage-card:hover{transform:translateY(-0.25rem)}
.stage-badge{font-family:'Fira Code',monospace;font-size:0.7rem;font-weight:700;padding:0.3rem 0.75rem;border-radius:0.375rem;display:inline-block;margin-bottom:0.75rem;letter-spacing:0.0625rem}
.sb-dev{background:rgba(0,184,148,0.3);color:#55efc4;border:0.0625rem solid #55efc4}
.sb-simple{background:rgba(9,132,227,0.3);color:#74b9ff;border:0.0625rem solid #74b9ff}
.sb-prod{background:rgba(108,92,231,0.3);color:#a29bfe;border:0.0625rem solid #a29bfe}
.stage-cmd{font-family:'Fira Code',monospace;font-size:0.8rem;color:#fff;margin-bottom:0.75rem;line-height:1.5;font-weight:600}
.stage-tree{font-family:'Fira Code',monospace;font-size:0.75rem;color:#dfe6e9;line-height:1.7}
.stage-tree strong{color:#fff;font-weight:800}
@media(max-width:37.5rem){.stage-grid{grid-template-columns:1fr}}

/* ── Layer Cards ── */
.layer-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:1rem;max-width:50rem;margin:2rem auto;padding:0 1.5rem}
.layer-card{border-radius:1rem;padding:1.25rem 1.5rem;display:flex;align-items:flex-start;gap:1rem}
.layer-icon{font-size:1.5rem;flex-shrink:0;margin-top:0.125rem}
.layer-card h4{font-size:1rem;font-weight:800;margin-bottom:0.25rem}
.layer-card p{font-size:0.85rem;line-height:1.6;color:#555}
.lc-gunicorn{background:#f0efff;border:0.125rem solid #d5ccff}
.lc-gunicorn h4{color:#6c5ce7}
.lc-uvicorn{background:#e3f2fd;border:0.125rem solid #90caf9}
.lc-uvicorn h4{color:#0984e3}
.lc-fastapi{background:#e8f8f5;border:0.125rem solid #b8f0e0}
.lc-fastapi h4{color:#00b894}
.lc-yours{background:#fef5e7;border:0.125rem solid #fdd9b5}
.lc-yours h4{color:#e17055}
@media(max-width:37.5rem){.layer-grid{grid-template-columns:1fr}}

/* ── Production Stack Diagram ── */
.prod-stack{max-width:32rem;margin:2rem auto;padding:0 1.5rem}
.ps-box{background:#1e272e;border-radius:1rem;padding:1.5rem;position:relative;border:0.0625rem solid #485460}
.ps-label{font-family:'Fira Code',monospace;font-size:0.75rem;font-weight:700;color:#fff;margin-bottom:0.75rem;letter-spacing:0.0625rem}
.ps-workers{display:grid;grid-template-columns:1fr 1fr;gap:0.75rem}
.ps-worker{background:rgba(9,132,227,0.2);border:0.0625rem solid #74b9ff;border-radius:0.75rem;padding:0.875rem;text-align:center}
.ps-worker-label{font-family:'Fira Code',monospace;font-size:0.7rem;font-weight:700;color:#74b9ff;margin-bottom:0.375rem}
.ps-worker-inner{font-family:'Fira Code',monospace;font-size:0.65rem;color:#dfe6e9;line-height:1.6}
.ps-worker-inner span{color:#55efc4;font-weight:700}
@media(max-width:37.5rem){.ps-workers{grid-template-columns:1fr}}

/* ── Unwrap: what fastapi dev does ── */
.unwrap{max-width:30rem;margin:2rem auto;padding:0 1.5rem}
.uw-box{background:#1e272e;border-radius:1rem;padding:1.5rem;border:0.0625rem solid #485460}
.uw-cmd{font-family:'Fira Code',monospace;font-size:0.85rem;font-weight:700;color:#55efc4;text-align:center;margin-bottom:1rem}
.uw-checks{list-style:none;padding:0;margin:0 0 1rem}
.uw-checks li{font-family:'Fira Code',monospace;font-size:0.75rem;color:#dfe6e9;padding:0.375rem 0;padding-left:1.5rem;position:relative}
.uw-checks li::before{content:'✓';position:absolute;left:0;color:#55efc4;font-weight:700}
.uw-then{text-align:center;font-family:'Fira Code',monospace;font-size:0.7rem;color:#636e72;margin:0.25rem 0 0.75rem}
.uw-result{font-family:'Fira Code',monospace;font-size:0.8rem;color:#74b9ff;text-align:center;background:rgba(9,132,227,0.15);padding:0.625rem;border-radius:0.5rem;border:0.0625rem solid rgba(9,132,227,0.3)}

/* ── Story Flow: vertical request journey ── */
.story-flow{max-width:28rem;margin:2rem auto;padding:0 1.5rem;display:flex;flex-direction:column;align-items:center}
.sf-step{width:100%;border-radius:0.75rem;padding:0.875rem 1.25rem;text-align:center}
.sf-label{font-family:'Fira Code',monospace;font-size:0.7rem;font-weight:700;letter-spacing:0.0625rem;margin-bottom:0.25rem}
.sf-desc{font-family:'Fira Code',monospace;font-size:0.75rem;line-height:1.6}
.sf-connector{display:flex;flex-direction:column;align-items:center;padding:0.25rem 0}
.sf-conn-line{width:0.125rem;height:0.5rem;background:#ddd}
.sf-conn-text{font-family:'Fira Code',monospace;font-size:0.65rem;color:#636e72;background:#f8f8f8;padding:0.1875rem 0.625rem;border-radius:1rem;white-space:nowrap}
.sf-client{background:#2d3436;border:0.0625rem solid #636e72}
.sf-client .sf-label,.sf-client .sf-desc{color:#dfe6e9}
.sf-gunicorn{background:#f0efff;border:0.125rem solid #d5ccff}
.sf-gunicorn .sf-label{color:#6c5ce7}.sf-gunicorn .sf-desc{color:#555}
.sf-uvicorn{background:#e3f2fd;border:0.125rem solid #90caf9}
.sf-uvicorn .sf-label{color:#0984e3}.sf-uvicorn .sf-desc{color:#555}
.sf-fastapi{background:#e8f8f5;border:0.125rem solid #b8f0e0}
.sf-fastapi .sf-label{color:#00b894}.sf-fastapi .sf-desc{color:#555}
.sf-yourcode{background:#fef5e7;border:0.125rem solid #fdd9b5}
.sf-yourcode .sf-label{color:#e17055}.sf-yourcode .sf-desc{color:#555}
.sf-return{margin-top:0.75rem;width:100%;text-align:center;padding:0.75rem;border-radius:0.75rem;background:#f9f9f9;border:0.0625rem dashed #ccc}
.sf-return-title{font-family:'Fira Code',monospace;font-size:0.65rem;font-weight:700;color:#636e72;margin-bottom:0.25rem;letter-spacing:0.0625rem}
.sf-return-text{font-family:'Fira Code',monospace;font-size:0.7rem;color:#555}

/* ── Annotation labels for mental model ── */
.mm-note{font-family:'Fira Code',monospace;font-size:0.6rem;color:#b2bec3;letter-spacing:0.0625rem;margin-top:0.375rem;text-align:center}
.mm-note-green{color:#55efc4}.mm-note-blue{color:#74b9ff}.mm-note-purple{color:#a29bfe}

/* ── Quiz theming: Episode 1 ── */
.quiz-ep1 .quiz-q-num{color:#00b894;background:#e8f8f5}
.quiz-ep1 .quiz-reveal-btn{color:#00b894}
.quiz-ep1 .quiz-opt-letter{color:#00b894}
.quiz-ep1 .quiz-option:hover{border-color:#00b894;background:#f0fdf9}
.quiz-ep1 .quiz-answer-highlight{background:#e8f8f5;border-left:0.25rem solid #00b894}
.quiz-ep1 .quiz-sequence-item:hover{border-color:#00b894;background:#f0fdf9}
`;
const bodyHtml = `

<!-- HERO -->
<section class="hero part1-hero">
  <div class="hero-badge">Episode 1 of 7</div>
  <h1>What Happens When<br>You Hit It</h1>
  <p style="color:rgba(255,255,255,0.95)">You run <code style="background:rgba(255,255,255,0.25);padding:0.125rem 0.5rem;border-radius:0.25rem">fastapi dev</code> and it works. But what's actually happening between your terminal and that JSON response?</p>

  <div class="stack-art">
    <div class="stack-layer sl-browser stack-layer-1">Browser / Client</div>
    <div class="stack-arrow stack-arrow-1">&#8595;</div>
    <div class="stack-layer sl-gunicorn stack-layer-2">Gunicorn</div>
    <div class="stack-arrow stack-arrow-2">&#8595;</div>
    <div class="stack-layer sl-uvicorn stack-layer-3">Uvicorn</div>
    <div class="stack-arrow stack-arrow-3">&#8595;</div>
    <div class="stack-layer sl-fastapi stack-layer-4">FastAPI + Your Code</div>
  </div>
  <div class="hero-label-text">every request passes through layers</div>
</section>

<!-- SECTION 01: DEV MODE -->
<section class="section reveal">
  <span class="section-num part1-num">01</span>
  <h2>How You Run It in Development</h2>
  <p>Here's the app everyone starts with:</p>

  <div class="code-block">
    <pre><span class="code-keyword">from</span> fastapi <span class="code-keyword">import</span> FastAPI

app = FastAPI()

<span class="code-keyword">@app.get</span>(<span class="code-string">"/hello"</span>)
<span class="code-keyword">async def</span> <span class="code-string">hello</span>():
    <span class="code-keyword">return</span> {<span class="code-string">"message"</span>: <span class="code-string">"Hello, world!"</span>}</pre>
  </div>

  <p>In development, you run it like this:</p>

  <div class="code-block">
    <pre><span class="code-keyword">fastapi dev</span> main.py</pre>
  </div>

  <p>That's it. You open <code>http://localhost:8000/hello</code> and see a JSON response. No server config, no setup, no extra tools.</p>
  <p>But here's the thing — <code>fastapi dev</code> is a convenience wrapper. Under the hood, it's doing this:</p>
</section>

<div class="unwrap reveal">
  <div class="uw-box">
    <div class="uw-cmd">$ fastapi dev main.py</div>
    <ul class="uw-checks">
      <li>Finds your <strong style="color:#fff">app</strong> object automatically</li>
      <li>Enables <strong style="color:#feca57">--reload</strong> (hot reload on file changes)</li>
      <li>Binds to <strong style="color:#74b9ff">127.0.0.1</strong> (localhost only)</li>
      <li>Sets port <strong style="color:#74b9ff">8000</strong></li>
    </ul>
    <div class="uw-then">&#8595; then secretly runs &#8595;</div>
    <div class="uw-result">uvicorn main:app --reload --host 127.0.0.1 --port 8000</div>
  </div>
</div>

<section class="section reveal">
  <p>It starts <span class="highlight">Uvicorn</span> for you — with auto-reload enabled so changes reflect instantly. It also auto-discovers your <code>app</code> object, so you don't need to specify <code>main:app</code> yourself. You just don't see any of it.</p>
  <p>So why not use <code>fastapi dev</code> in production? Because it forces <span class="highlight-orange">auto-reload ON</span> (wastes CPU, causes brief restarts on every file change) and binds to <span class="highlight-orange">127.0.0.1 only</span> (localhost — external traffic can't reach your server). In production, you run Uvicorn directly with <code>--host 0.0.0.0</code> and no reload.</p>
  <p>So even in dev mode, there's already a hidden layer: <span class="highlight">Uvicorn, an HTTP server</span>. FastAPI never touches the network directly.</p>
</section>

<!-- SECTION 02: THREE STAGES -->
<section class="section reveal">
  <span class="section-num part1-num">02</span>
  <h2>From Dev to Production: The Three Stages</h2>
  <p>As your app grows from your laptop to serving real users, the stack grows too:</p>
</section>

<div class="stage-grid reveal">
  <div class="stage-card">
    <span class="stage-badge sb-dev">DEVELOPMENT</span>
    <div class="stage-cmd">fastapi dev main.py</div>
    <div class="stage-tree">
      <strong>Uvicorn</strong> (1 worker, reload ON)<br>
      &nbsp;&nbsp;&#9492;&#9472; FastAPI app
    </div>
  </div>
  <div class="stage-card">
    <span class="stage-badge sb-simple">SIMPLE PRODUCTION</span>
    <div class="stage-cmd">uvicorn main:app<br>--host 0.0.0.0 --port 8000</div>
    <div class="stage-tree">
      <strong>Uvicorn</strong> (1 worker, no reload)<br>
      &nbsp;&nbsp;&#9492;&#9472; FastAPI app
    </div>
  </div>
  <div class="stage-card">
    <span class="stage-badge sb-prod">REAL PRODUCTION</span>
    <div class="stage-cmd">gunicorn main:app<br>-k uvicorn.workers.UvicornWorker -w 4</div>
    <div class="stage-tree">
      <strong>Gunicorn</strong> (process manager)<br>
      &nbsp;&nbsp;&#9500;&#9472; Uvicorn Worker 1 &#8594; FastAPI<br>
      &nbsp;&nbsp;&#9500;&#9472; Uvicorn Worker 2 &#8594; FastAPI<br>
      &nbsp;&nbsp;&#9500;&#9472; Uvicorn Worker 3 &#8594; FastAPI<br>
      &nbsp;&nbsp;&#9492;&#9472; Uvicorn Worker 4 &#8594; FastAPI
    </div>
  </div>
</div>

<section class="section reveal">
  <p>One process handling requests in dev. One hardened process in simple production. <span class="highlight-green">Four parallel workers</span> in real production — four requests getting CPU time simultaneously.</p>
  <p>But what does each piece actually do? Let's break it down.</p>
</section>

<!-- SECTION 03: WHO DOES WHAT -->
<section class="section reveal">
  <span class="section-num part1-num">03</span>
  <h2>The Stack: Who Does What</h2>
  <p>Every request passes through multiple layers. Each layer has exactly one job:</p>
</section>

<div class="story-flow reveal">
  <div class="sf-step sf-client">
    <div class="sf-label">BROWSER / CLIENT</div>
    <div class="sf-desc">GET /hello HTTP/1.1</div>
  </div>
  <div class="sf-connector">
    <div class="sf-conn-line"></div>
    <div class="sf-conn-text">raw HTTP bytes over TCP</div>
    <div class="sf-conn-line"></div>
  </div>
  <div class="sf-step sf-gunicorn">
    <div class="sf-label">GUNICORN</div>
    <div class="sf-desc">"Which worker is free?" &#8594; forwards to Worker 3</div>
  </div>
  <div class="sf-connector">
    <div class="sf-conn-line"></div>
    <div class="sf-conn-text">connection handed to worker process</div>
    <div class="sf-conn-line"></div>
  </div>
  <div class="sf-step sf-uvicorn">
    <div class="sf-label">UVICORN</div>
    <div class="sf-desc">Parses HTTP bytes &#8594; creates Python dict (scope)</div>
  </div>
  <div class="sf-connector">
    <div class="sf-conn-line"></div>
    <div class="sf-conn-text">ASGI call: scope + receive + send</div>
    <div class="sf-conn-line"></div>
  </div>
  <div class="sf-step sf-fastapi">
    <div class="sf-label">FASTAPI</div>
    <div class="sf-desc">Matches @app.get("/hello") &#8594; validates &#8594; calls hello()</div>
  </div>
  <div class="sf-connector">
    <div class="sf-conn-line"></div>
    <div class="sf-conn-text">calls your function</div>
    <div class="sf-conn-line"></div>
  </div>
  <div class="sf-step sf-yourcode">
    <div class="sf-label">YOUR FUNCTION</div>
    <div class="sf-desc">return {"message": "Hello, world!"}</div>
  </div>
  <div class="sf-return">
    <div class="sf-return-title">&#8593; RESPONSE FLOWS BACK UP &#8593;</div>
    <div class="sf-return-text">dict &#8594; JSON &#8594; HTTP bytes &#8594; Client</div>
  </div>
</div>

<div class="layer-grid reveal">
  <div class="layer-card lc-gunicorn">
    <div class="layer-icon">&#128188;</div>
    <div>
      <h4>Gunicorn — The Manager</h4>
      <p>Spawns and supervises multiple worker processes. Restarts them if they crash. Doesn't handle HTTP itself.</p>
    </div>
  </div>
  <div class="layer-card lc-uvicorn">
    <div class="layer-icon">&#128066;</div>
    <div>
      <h4>Uvicorn — The Ears</h4>
      <p>Listens for HTTP, parses requests, sends responses. Each worker runs one Uvicorn instance.</p>
    </div>
  </div>
  <div class="layer-card lc-fastapi">
    <div class="layer-icon">&#129504;</div>
    <div>
      <h4>FastAPI — The Brain</h4>
      <p>Routes requests, validates data, generates docs. The intelligence layer.</p>
    </div>
  </div>
  <div class="layer-card lc-yours">
    <div class="layer-icon">&#9997;</div>
    <div>
      <h4>Your Function — The Hands</h4>
      <p>Does the actual work — DB queries, calculations, API calls.</p>
    </div>
  </div>
</div>

<div class="analogy reveal">
  <p>Imagine a <strong>restaurant</strong>. The <strong>owner</strong> (Gunicorn) hires multiple waitstaff and makes sure shifts are covered — but never takes orders himself. Each <strong>waiter</strong> (Uvicorn) stands at the door, seats customers, and carries plates. The <strong>menu system</strong> (FastAPI) checks if the order is valid and routes it to the right kitchen station. The <strong>chef</strong> (your function) actually cooks.</p>
</div>

<!-- SECTION 04: WHY THREE LAYERS -->
<section class="section reveal">
  <span class="section-num part1-num">04</span>
  <h2>Why Three Layers? Can't One Do Everything?</h2>
  <p>This is the question everyone asks. Let's see why each layer exists:</p>

  <h3 style="margin-top:2rem;font-size:1.2rem;color:#0984e3">Why can't FastAPI handle HTTP?</h3>
  <p>Handling HTTP connections is hard, low-level work — opening TCP sockets, managing thousands of simultaneous connections, parsing raw HTTP bytes, handling keep-alive and timeouts. This has nothing to do with your business logic. So FastAPI doesn't — it delegates to Uvicorn.</p>

  <h3 style="margin-top:2rem;font-size:1.2rem;color:#6c5ce7">Can Uvicorn run in production without Gunicorn?</h3>
  <p>Yes — and many apps do, especially in containers where Kubernetes or ECS handles restarts and scaling. Uvicorn even has a <code>--workers 4</code> flag to spawn multiple processes.</p>
  <p>But Uvicorn is primarily a <span class="highlight">single-process ASGI server</span> — process management isn't its core strength. Gunicorn is purpose-built for it: battle-tested process management, pre-fork model, and mature signal handling. For high-traffic production without a container orchestrator, Gunicorn adds that layer of robustness.</p>

  <h3 style="margin-top:2rem;font-size:1.2rem;color:#00b894">Why not just use Gunicorn alone?</h3>
  <p>Gunicorn was built for <span class="highlight-orange">WSGI</span> — the older, synchronous Python web standard. It doesn't natively speak <span class="highlight">ASGI</span> (the async standard FastAPI uses). So Gunicorn manages the processes, but each process runs a Uvicorn worker that handles the actual async HTTP.</p>
</section>

<div class="analogy reveal">
  <p>Your phone has a <strong>cellular radio</strong> (connects to towers), an <strong>operating system</strong> (manages apps), and <strong>apps</strong> (do useful things). The apps don't connect to towers. The radio doesn't manage apps. The OS doesn't display your photos. Three layers, each with a clear purpose.</p>
</div>

<!-- SECTION 05: LIFE OF A REQUEST -->
<section class="section reveal">
  <span class="section-num part1-num">05</span>
  <h2>Step by Step: The Life of a Request</h2>
  <p>Let's trace exactly what happens when your browser hits <code>GET /hello</code>:</p>
</section>

<div class="timeline reveal" style="max-width:43.75rem;margin:2.5rem auto;padding:0 1.5rem 0 4rem">
  <div class="timeline-item">
    <div class="timeline-year">Step 1 — Browser</div>
    <div class="timeline-text">Browser sends a raw HTTP request over TCP to port 8000</div>
  </div>
  <div class="timeline-item">
    <div class="timeline-year">Step 2 — Uvicorn receives</div>
    <div class="timeline-text">Uvicorn accepts the TCP connection, parses the HTTP — extracts method (<code>GET</code>), path (<code>/hello</code>), headers</div>
  </div>
  <div class="timeline-item">
    <div class="timeline-year">Step 3 — Uvicorn creates scope</div>
    <div class="timeline-text">Creates a Python dict called a <strong>scope</strong> — a standardized way to represent the request</div>
  </div>
  <div class="timeline-item">
    <div class="timeline-year">Step 4 — ASGI handoff</div>
    <div class="timeline-text">Calls your FastAPI app using the <strong>ASGI interface</strong> <span class="timeline-chip">the contract</span></div>
  </div>
  <div class="timeline-item">
    <div class="timeline-year">Step 5 — FastAPI routes</div>
    <div class="timeline-text">FastAPI matches the URL, validates input, resolves dependencies, calls your function</div>
  </div>
  <div class="timeline-item">
    <div class="timeline-year">Step 6 — Your function runs</div>
    <div class="timeline-text">Returns <code>{"message": "Hello, world!"}</code> — just a plain Python dict</div>
  </div>
  <div class="timeline-item">
    <div class="timeline-year">Step 7 — FastAPI responds</div>
    <div class="timeline-text">Serializes your dict to JSON, sets status <code>200 OK</code> and <code>Content-Type: application/json</code></div>
  </div>
  <div class="timeline-item">
    <div class="timeline-year">Step 8 — Uvicorn sends back</div>
    <div class="timeline-text">Formats it as raw HTTP bytes and sends the response back over TCP</div>
  </div>
</div>

<section class="section reveal">
  <p>The raw HTTP request your browser sends:</p>
  <div class="code-block">
    <pre><span class="code-keyword">GET</span> /hello <span class="code-comment">HTTP/1.1</span>
<span class="code-string">Host:</span> localhost:8000
<span class="code-string">Accept:</span> application/json</pre>
  </div>

  <p>The raw HTTP response Uvicorn sends back:</p>
  <div class="code-block">
    <pre><span class="code-comment">HTTP/1.1</span> <span class="code-keyword">200 OK</span>
<span class="code-string">Content-Type:</span> application/json
<span class="code-string">Content-Length:</span> 27

<span class="code-keyword">{"message":"Hello, world!"}</span></pre>
  </div>

  <p>Total time: can be <span class="highlight-green">under 1 millisecond</span> for a simple endpoint on modern hardware.</p>
</section>

<!-- SECTION 06: ASGI -->
<section class="section reveal">
  <span class="section-num part1-num">06</span>
  <h2>What is ASGI? The Contract Between Server and App</h2>
  <p>For Uvicorn and FastAPI to work together, they need a shared contract — a standard that says "here's how a server talks to an app." That contract is <span class="highlight">ASGI</span> — <strong>Asynchronous Server Gateway Interface</strong>.</p>
  <p>ASGI says: the server will call your app as a Python callable, passing three things:</p>

  <div class="code-block">
    <pre><span class="code-comment"># What an ASGI app looks like at the lowest level</span>
<span class="code-keyword">async def</span> <span class="code-string">app</span>(scope, receive, send):
    <span class="code-comment"># scope   = dict with request info (method, path, headers)</span>
    <span class="code-comment"># receive = async function to read request body</span>
    <span class="code-comment"># send    = async function to send response</span>
    ...</pre>
  </div>

  <p>FastAPI implements this interface. So does Django Channels. So does Starlette. Uvicorn can talk to any of them — because it only cares about the interface, not the framework.</p>
</section>

<div class="reveal" style="max-width:50rem;margin:0 auto;padding:0 1.5rem">
  <div class="flow">
    <div class="flow-box fb-orange">Uvicorn<br><small>server</small></div>
    <div class="flow-arrow">&#10132;</div>
    <div class="flow-box fb-dark">ASGI<br><small>contract</small></div>
    <div class="flow-arrow">&#10132;</div>
    <div class="flow-box fb-green">Any Framework<br><small>FastAPI / Django / Starlette</small></div>
  </div>
</div>

<section class="section reveal">
  <p>This is why <code>uvicorn main:app</code> works — Uvicorn imports <code>app</code> from <code>main.py</code> and calls it using the ASGI protocol. It doesn't know it's FastAPI.</p>

  <h3 style="margin-top:2rem;font-size:1.2rem;color:#e17055">What about WSGI?</h3>
  <p>Before ASGI, Python had <span class="highlight-orange">WSGI</span> — the synchronous version. Flask and traditional Django use WSGI.</p>

  <div class="code-block">
    <pre><span class="code-comment">              WSGI                    ASGI</span>
<span class="code-keyword">Style</span>         Synchronous             Asynchronous
<span class="code-keyword">One request</span>   Blocks the thread       Can pause, let others run
<span class="code-keyword">Concurrency</span>   One request per thread   Thousands per thread
<span class="code-keyword">Server</span>        Gunicorn (native)       Uvicorn
<span class="code-keyword">Frameworks</span>    Flask, Django           FastAPI, Starlette, Django 3.0+</pre>
  </div>

  <p>ASGI exists because async Python (<code>async</code>/<code>await</code>) made it possible to handle many requests with a single thread — which is exactly what makes FastAPI fast. We'll dig deep into this in Episodes 3 and 4.</p>
</section>

<!-- SECTION 07: STARLETTE -->
<section class="section reveal">
  <span class="section-num part1-num">07</span>
  <h2>The Hidden Layer: Starlette</h2>
  <p>Here's a detail most tutorials skip: FastAPI is built on top of <span class="highlight">another framework</span>.</p>
</section>

<div class="reveal" style="max-width:50rem;margin:0 auto;padding:0 1.5rem">
  <div class="flow">
    <div class="flow-box fb-green">FastAPI<br><small>your interface</small></div>
    <div class="flow-arrow">&#10132;</div>
    <div class="flow-box fb-purple">Starlette<br><small>ASGI framework</small></div>
  </div>
  <p style="font-size:0.8rem;color:#636e72;text-align:center;margin-top:0.75rem;font-family:'Fira Code',monospace">Note: Starlette uses AnyIO internally for async compatibility — AnyIO is not a layer requests pass through.</p>
</div>

<section class="section reveal">
  <p>And for data validation:</p>
</section>

<div class="reveal" style="max-width:30rem;margin:0 auto;padding:0 1.5rem">
  <div class="flow">
    <div class="flow-box fb-green">FastAPI<br><small>uses</small></div>
    <div class="flow-arrow">&#10132;</div>
    <div class="flow-box fb-orange">Pydantic<br><small>data validation</small></div>
  </div>
</div>

<section class="section reveal">
  <p><span class="highlight">Starlette</span> handles the core web stuff — routing, middleware, request/response objects, WebSockets. FastAPI adds the magic on top — automatic validation from type hints, dependency injection, and auto-generated OpenAPI docs.</p>
  <p>You rarely interact with Starlette directly. But knowing it's there explains why FastAPI is fast — Starlette is one of the <span class="highlight-green">fastest Python web frameworks</span>, and FastAPI inherits all of that.</p>
</section>

<!-- SECTION 08: COMPLETE MENTAL MODEL -->
<section class="section reveal">
  <span class="section-num part1-num">08</span>
  <h2>The Complete Mental Model</h2>
  <p>Here's the full picture — from the machine (or pod) all the way down to your code:</p>

  <h3 style="margin-top:2rem;font-size:1.2rem;color:#00b894">Development</h3>
</section>

<div class="reveal" style="max-width:26rem;margin:0 auto;padding:0 1.5rem">
