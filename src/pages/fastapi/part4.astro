---
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { fastapiSeries } from '../../data/series';
const inlineStyle = `
::selection{background:#6c5ce7;color:#fff}

.part4-hero{background:linear-gradient(135deg,#6c5ce7 0%,#0984e3 50%,#00b894 100%)}

.part4-num{color:#6c5ce7;background:#f0efff}

/* ── Hero Art: Interleaved Gantt Bars ── */
.gantt-art{margin:2.5rem auto 0;animation:fadeInUp 1.5s ease;max-width:20rem;width:100%}
.gantt-frame{background:rgba(255,255,255,0.1);border:0.0625rem solid rgba(255,255,255,0.2);border-radius:0.875rem;padding:1.25rem 1.5rem;display:flex;flex-direction:column;gap:0.75rem}
.gantt-row{display:flex;align-items:center;gap:0.625rem}
.gantt-label{font-family:'Fira Code',monospace;font-size:0.65rem;font-weight:700;color:rgba(255,255,255,0.7);width:4rem;flex-shrink:0;letter-spacing:0.03125rem}
.gantt-track{flex:1;height:1.25rem;border-radius:0.25rem;background:rgba(255,255,255,0.08);position:relative;overflow:visible;display:flex;align-items:center}
.gantt-seg{height:100%;border-radius:0.25rem;position:absolute;top:0}
.gantt-seg.run{opacity:0.9}
.gantt-seg.paused{opacity:0;border:0.125rem dashed;background:transparent !important}

/* Coroutine A — purple */
.ca-r1{background:#a29bfe;left:0%;width:20%;animation:ganttFill 3s ease-in-out infinite}
.ca-p1{border-color:rgba(162,155,254,0.6);left:20%;width:30%;animation:ganttPause 3s ease-in-out infinite}
.ca-r2{background:#a29bfe;left:50%;width:20%;animation:ganttFill2 3s ease-in-out infinite}
.ca-p2{border-color:rgba(162,155,254,0.6);left:70%;width:30%;animation:ganttPause2 3s ease-in-out infinite}

/* Coroutine B — blue */
.cb-p1{border-color:rgba(116,185,255,0.6);left:0%;width:20%;animation:ganttPause 3s ease-in-out infinite}
.cb-r1{background:#74b9ff;left:20%;width:20%;animation:ganttFill 3s ease-in-out 0.2s infinite}
.cb-p2{border-color:rgba(116,185,255,0.6);left:40%;width:20%;animation:ganttPause2 3s ease-in-out infinite}
.cb-r2{background:#74b9ff;left:60%;width:20%;animation:ganttFill2 3s ease-in-out 0.2s infinite}
.cb-p3{border-color:rgba(116,185,255,0.6);left:80%;width:20%;animation:ganttPause 3s ease-in-out 0.4s infinite}

/* Coroutine C — teal */
.cc-p1{border-color:rgba(85,239,196,0.6);left:0%;width:30%;animation:ganttPause 3s ease-in-out infinite}
.cc-r1{background:#55efc4;left:30%;width:20%;animation:ganttFill 3s ease-in-out 0.4s infinite}
.cc-p2{border-color:rgba(85,239,196,0.6);left:50%;width:20%;animation:ganttPause2 3s ease-in-out infinite}
.cc-r2{background:#55efc4;left:70%;width:20%;animation:ganttFill2 3s ease-in-out 0.4s infinite}

@keyframes ganttFill{0%,100%{opacity:0.6}50%{opacity:1}}
@keyframes ganttFill2{0%,100%{opacity:1}50%{opacity:0.6}}
@keyframes ganttPause{0%,100%{opacity:0.35}50%{opacity:0.7}}
@keyframes ganttPause2{0%,100%{opacity:0.7}50%{opacity:0.35}}

.gantt-legend{display:flex;gap:1rem;justify-content:center;margin-top:0.875rem;flex-wrap:wrap}
.gantt-legend-item{font-family:'Fira Code',monospace;font-size:0.6rem;color:rgba(255,255,255,0.6);display:flex;align-items:center;gap:0.375rem}
.gantt-legend-dot{width:0.625rem;height:0.625rem;border-radius:0.125rem}
.gantt-legend-dashed{width:0.625rem;height:0.625rem;border-radius:0.125rem;border:0.09375rem dashed rgba(255,255,255,0.5)}
.hero-label-text{font-family:'Fira Code',monospace;font-size:0.75rem;color:rgba(255,255,255,0.6);letter-spacing:0.125rem;text-align:center;margin-top:0.75rem}

/* ── Sequential vs Parallel Timeline ── */
.timing-compare{display:grid;grid-template-columns:1fr 1fr;gap:1.25rem;max-width:50rem;margin:2rem auto;padding:0 1.5rem}
.timing-card{background:#2d3436;border-radius:1rem;padding:1.5rem}
.timing-label{font-family:'Fira Code',monospace;font-size:0.7rem;font-weight:700;letter-spacing:0.0625rem;margin-bottom:1rem}
.timing-label.bad{color:#e17055}
.timing-label.good{color:#00b894}
.timing-row{display:flex;align-items:center;gap:0.5rem;margin-bottom:0.5rem}
.timing-name{font-family:'Fira Code',monospace;font-size:0.65rem;color:#636e72;width:5.5rem;flex-shrink:0}
.timing-track{flex:1;height:1.5rem;background:rgba(255,255,255,0.05);border-radius:0.25rem;position:relative;overflow:hidden}
.timing-bar{height:100%;border-radius:0.25rem;display:flex;align-items:center;justify-content:center}
.timing-ms{font-family:'Fira Code',monospace;font-size:0.6rem;font-weight:700;color:#fff}
.timing-total{font-family:'Fira Code',monospace;font-size:0.75rem;font-weight:700;margin-top:0.875rem;padding-top:0.75rem;border-top:0.0625rem solid rgba(255,255,255,0.08)}
.timing-total.bad{color:#e17055}
.timing-total.good{color:#00b894}
@media(max-width:37.5rem){.timing-compare{grid-template-columns:1fr}}

/* ── #1 Mistake Warning Block ── */
.warning-block{background:linear-gradient(135deg,#2d0a0a,#1a1a2e);border:0.09375rem solid rgba(231,76,60,0.4);border-radius:1rem;max-width:50rem;margin:2rem auto;padding:2rem 1.5rem}
.warning-header{display:flex;align-items:center;gap:0.75rem;margin-bottom:1.5rem}
.warning-icon{font-size:1.5rem}
.warning-title{font-size:1.1rem;font-weight:800;color:#e74c3c}
.code-pair{display:grid;grid-template-columns:1fr 1fr;gap:1rem}
.code-pair-block{border-radius:0.75rem;overflow:hidden}
.code-pair-label{font-family:'Fira Code',monospace;font-size:0.65rem;font-weight:700;padding:0.5rem 1rem;letter-spacing:0.0625rem}
.code-pair-label.bad{background:rgba(231,76,60,0.2);color:#e74c3c}
.code-pair-label.good{background:rgba(0,184,148,0.2);color:#00b894}
.code-pair pre{margin:0;padding:1rem;background:rgba(0,0,0,0.4);font-size:0.72rem;line-height:1.65;overflow-x:auto}
@media(max-width:37.5rem){.code-pair{grid-template-columns:1fr}}

/* ── Four-Rule Matrix ── */
.rule-matrix{display:grid;grid-template-columns:1fr 1fr;gap:1rem;max-width:50rem;margin:2rem auto;padding:0 1.5rem}
.rule-card{border-radius:1rem;padding:1.25rem 1.5rem}
.rule-card.good{background:#e8f8f5;border:0.125rem solid #b8f0e0}
.rule-card.bad{background:#fff5f5;border:0.125rem solid #fec5c5}
.rule-badge{font-family:'Fira Code',monospace;font-size:0.65rem;font-weight:700;padding:0.25rem 0.625rem;border-radius:0.375rem;display:inline-block;margin-bottom:0.75rem;letter-spacing:0.0625rem}
.rule-badge.good{background:rgba(0,184,148,0.15);color:#00b894;border:0.0625rem solid rgba(0,184,148,0.3)}
.rule-badge.bad{background:rgba(231,76,60,0.12);color:#e74c3c;border:0.0625rem solid rgba(231,76,60,0.25)}
.rule-card h4{font-size:0.9rem;font-weight:800;margin-bottom:0.375rem}
.rule-card.good h4{color:#00695c}
.rule-card.bad h4{color:#c0392b}
.rule-card p{font-size:0.82rem;line-height:1.55;color:#555;margin:0}
.rule-card code{font-family:'Fira Code',monospace;font-size:0.78rem;background:rgba(0,0,0,0.07);padding:0.1rem 0.35rem;border-radius:0.25rem}
@media(max-width:37.5rem){.rule-matrix{grid-template-columns:1fr}}

/* ── Comparison Table ── */
.compare-table{max-width:50rem;margin:2rem auto;padding:0 1.5rem;overflow-x:auto}
.compare-table table{width:100%;border-collapse:collapse;font-size:0.85rem;background:#2d3436;border-radius:1rem;overflow:hidden}
.compare-table th{background:rgba(108,92,231,0.2);color:#a29bfe;font-family:'Fira Code',monospace;font-size:0.7rem;font-weight:700;padding:0.75rem 1rem;text-align:left;letter-spacing:0.03125rem}
.compare-table td{padding:0.75rem 1rem;border-top:0.0625rem solid rgba(255,255,255,0.05);color:#dfe6e9;font-size:0.82rem;line-height:1.5}
.compare-table tr:first-child td{border-top:none}
.compare-table td:first-child{font-family:'Fira Code',monospace;font-size:0.78rem;color:#a29bfe;font-weight:700}
.compare-table code{font-family:'Fira Code',monospace;font-size:0.75rem;background:rgba(255,255,255,0.08);padding:0.1rem 0.35rem;border-radius:0.25rem}

/* ── Section 07 Decision Tree ── */
.decision-tree{max-width:28rem;margin:2rem auto;padding:0 1.5rem;display:flex;flex-direction:column;align-items:center}
.dt-box{width:100%;border-radius:0.75rem;padding:0.875rem 1.25rem;text-align:center}
.dt-connector{display:flex;flex-direction:column;align-items:center;padding:0.25rem 0}
.dt-conn-line{width:0.125rem;height:0.5rem;background:#ddd}
.dt-conn-text{font-family:'Fira Code',monospace;font-size:0.65rem;color:#888;background:#f8f8f8;padding:0.1875rem 0.625rem;border-radius:1rem}
.dt-branches{display:grid;grid-template-columns:1fr 1fr;gap:1rem;width:100%;margin-top:0.5rem}
.dt-branch{border-radius:0.75rem;padding:0.875rem;text-align:center}
.dt-label{font-family:'Fira Code',monospace;font-size:0.7rem;font-weight:700;display:block;margin-bottom:0.3rem}
.dt-desc{font-family:'Fira Code',monospace;font-size:0.72rem;display:block;line-height:1.5}
.dt-box-dark{background:#2d3436;color:#dfe6e9}
.dt-box-purple{background:#f0efff;color:#6c5ce7;border:0.0625rem solid #d6d3fc}
.dt-branch-yes{background:#e8f8f5;border:0.0625rem solid #b8f0e0}
.dt-branch-no{background:#e3f2fd;border:0.0625rem solid #b3d9f7}

/* ── Timing card annotation ── */
.timing-annotation{font-family:'Fira Code',monospace;font-size:0.6rem;color:#636e72;margin-top:0.5rem;text-align:center}

/* ── Quiz theming: Episode 4 ── */
.quiz-ep4 .quiz-q-num{color:#6c5ce7;background:#f0efff}
.quiz-ep4 .quiz-reveal-btn{color:#6c5ce7}
.quiz-ep4 .quiz-opt-letter{color:#6c5ce7}
.quiz-ep4 .quiz-option:hover{border-color:#6c5ce7;background:#f7f5ff}
.quiz-ep4 .quiz-answer-highlight{background:#f0efff;border-left:0.25rem solid #6c5ce7}
.quiz-ep4 .quiz-sequence-item:hover{border-color:#6c5ce7;background:#f7f5ff}
`;
const bodyHtml = `

<!-- HERO -->
<section class="hero part4-hero">
  <div class="hero-badge">Episode 4 of 7</div>
  <h1>Coroutines — How<br>async/await Powers FastAPI</h1>
  <p style="color:rgba(255,255,255,0.95)">You've seen <code style="background:rgba(255,255,255,0.15);padding:0.125rem 0.5rem;border-radius:0.25rem">async def</code> a hundred times. But what is it actually doing — and why does getting it wrong silently cripple your app?</p>

  <!-- Gantt Art -->
  <div class="gantt-art">
    <div class="gantt-frame">
      <div class="gantt-row">
        <span class="gantt-label">Coroutine A</span>
        <div class="gantt-track">
          <div class="gantt-seg run ca-r1"></div>
          <div class="gantt-seg paused ca-p1"></div>
          <div class="gantt-seg run ca-r2"></div>
          <div class="gantt-seg paused ca-p2"></div>
        </div>
      </div>
      <div class="gantt-row">
        <span class="gantt-label">Coroutine B</span>
        <div class="gantt-track">
          <div class="gantt-seg paused cb-p1"></div>
          <div class="gantt-seg run cb-r1"></div>
          <div class="gantt-seg paused cb-p2"></div>
          <div class="gantt-seg run cb-r2"></div>
          <div class="gantt-seg paused cb-p3"></div>
        </div>
      </div>
      <div class="gantt-row">
        <span class="gantt-label">Coroutine C</span>
        <div class="gantt-track">
          <div class="gantt-seg paused cc-p1"></div>
          <div class="gantt-seg run cc-r1"></div>
          <div class="gantt-seg paused cc-p2"></div>
          <div class="gantt-seg run cc-r2"></div>
        </div>
      </div>
    </div>
    <div class="gantt-legend">
      <span class="gantt-legend-item"><span class="gantt-legend-dot" style="background:#a29bfe"></span>running</span>
      <span class="gantt-legend-item"><span class="gantt-legend-dashed"></span>awaiting I/O</span>
    </div>
  </div>
  <div class="hero-label-text">coroutines taking turns on one thread</div>
</section>

<!-- SECTION 01: WHAT IS A COROUTINE -->
<section class="section reveal">
  <span class="section-num part4-num">01</span>
  <h2>What Is a Coroutine?</h2>
  <p>A normal Python function runs start to finish. You call it, it executes every line, it returns. No pauses, no interruptions.</p>

  <div class="code-block">
    <pre><span class="code-keyword">def</span> <span class="code-string">get_user</span>(id):
    user = db.fetch_user(id)   <span class="code-comment"># waits here — CPU sits idle while DB responds</span>
    <span class="code-keyword">return</span> user</pre>
  </div>

  <p>A <strong>coroutine</strong> is different. It's a function that can <em>pause itself</em> midway and say: "I'm waiting for something — let someone else run while I wait. Resume me when my result is ready."</p>

  <div class="code-block">
    <pre><span class="code-keyword">async def</span> <span class="code-string">get_user</span>(id):
    user = <span class="code-keyword">await</span> db.fetch_user(id)   <span class="code-comment"># pauses here — but doesn't block the thread</span>
    <span class="code-keyword">return</span> user</pre>
  </div>

  <p>In Python, any function defined with <code>async def</code> is a coroutine. The <code>async</code> keyword doesn't make it run faster — it makes it <em>pauseable</em>.</p>
</section>

<div class="analogy reveal">
  <p>A normal function is like reading a book from page 1 to the end without stopping. A coroutine is like a bookmark — you can put it down at any page, do something else, and pick it up exactly where you left off.</p>
</div>

<section class="section reveal">
  <p>The critical thing: when a coroutine pauses, <strong>the thread is free</strong>. Something else can run. This is the entire point.</p>
</section>

<!-- SECTION 02: HOW AWAIT WORKS -->
<section class="section reveal">
  <span class="section-num part4-num">02</span>
  <h2>How await Works, Step by Step</h2>
  <p><code>await</code> is the pause button. Let's trace exactly what happens when Python executes it.</p>

  <div class="code-block">
    <pre><span class="code-keyword">async def</span> <span class="code-string">get_user</span>(id: int):
    print(<span class="code-string">"Starting request"</span>)
    user = <span class="code-keyword">await</span> db.fetch_user(id)    <span class="code-comment"># &lt;-- await point</span>
    print(<span class="code-string">"Got user:"</span>, user.name)
    <span class="code-keyword">return</span> user</pre>
  </div>
</section>

<div class="timeline reveal" style="max-width:43.75rem;margin:2.5rem auto;padding:0 1.5rem 0 4rem">
  <div class="timeline-item">
    <div class="timeline-year">Step 1</div>
    <div class="timeline-text"><code>get_user()</code> starts running, prints "Starting request"</div>
  </div>
  <div class="timeline-item">
    <div class="timeline-year">Step 2 — await hit</div>
    <div class="timeline-text">Hits <code>await db.fetch_user(id)</code> — coroutine <strong>pauses</strong> and suspends right here</div>
  </div>
  <div class="timeline-item">
    <div class="timeline-year">Step 3 — loop takes over</div>
    <div class="timeline-text">Control returns to the event loop — it runs <strong>other coroutines</strong> (other requests, other tasks)</div>
  </div>
  <div class="timeline-item">
    <div class="timeline-year">Step 4 — result ready</div>
    <div class="timeline-text">DB responds. Event loop <strong>resumes</strong> <code>get_user()</code> right after the <code>await</code></div>
  </div>
  <div class="timeline-item">
    <div class="timeline-year">Step 5 — continues</div>
    <div class="timeline-text"><code>user</code> now holds the result. Prints "Got user: Alice", returns</div>
  </div>
</div>

<section class="section reveal">
  <p>The coroutine doesn't know it was paused. From its perspective, it just called <code>db.fetch_user(id)</code> and got a result back. The pause is invisible to the code inside the function.</p>
  <p>You can have multiple <code>await</code> points in one function — each one is a potential pause:</p>

  <div class="code-block">
    <pre><span class="code-keyword">async def</span> <span class="code-string">get_dashboard</span>(user_id: int):
    print(<span class="code-string">"Step 1"</span>)
    user     = <span class="code-keyword">await</span> db.get_user(user_id)         <span class="code-comment"># pause #1</span>

    print(<span class="code-string">"Step 2"</span>)
    settings = <span class="code-keyword">await</span> db.get_settings(user_id) <span class="code-comment"># pause #2</span>

    print(<span class="code-string">"Step 3"</span>)
    token    = <span class="code-keyword">await</span> auth.validate(user)         <span class="code-comment"># pause #3</span>

    <span class="code-keyword">return</span> {<span class="code-string">"user"</span>: user, <span class="code-string">"settings"</span>: settings, <span class="code-string">"token"</span>: token}</pre>
  </div>

  <p>Each <code>await</code> is a moment where the event loop can squeeze in work from other requests. The function itself runs top to bottom — it just takes breaks.</p>
</section>

<div class="analogy reveal">
  <p>Imagine you're cooking and you have pasta boiling, a sauce simmering, and garlic bread in the oven. You don't stand in front of each one staring until it's done. You start the pasta, set a timer (<code>await</code>), chop vegetables while it boils, check the sauce, set another timer (<code>await</code>), stir it. You are one person doing multiple things — not because you work faster, but because you use the waiting time wisely.</p>
</div>

<!-- SECTION 03: COROUTINES VS THREADS -->
<section class="section reveal">
  <span class="section-num part4-num">03</span>
  <h2>Coroutines vs Threads</h2>
  <p>There are two ways to handle "waiting": coroutines and threads. They solve the same problem differently.</p>

  <h3 style="margin-top:2rem;font-size:1.2rem;color:#0984e3">Threads</h3>
  <p>When you use threads, the operating system manages everything. Each thread has its own execution stack — its own memory space where it tracks local variables, call history, and where it's up to. The OS decides <em>when</em> to switch between threads. This is called <strong>preemptive</strong> scheduling — the OS can interrupt a thread at any point, mid-execution.</p>
  <p>The cost: each thread needs its own stack — roughly <span class="highlight-orange">8MB of memory</span> on Linux (1MB on Windows). 1,000 threads = up to 8GB of memory just for stacks. And context-switching between threads isn't free — the OS has to save and restore state.</p>

  <h3 style="margin-top:2rem;font-size:1.2rem;color:#6c5ce7">Coroutines</h3>
  <p>Coroutines run on a single thread. The event loop runs them one at a time. But each coroutine can <em>voluntarily</em> pause at <code>await</code> points, letting the event loop pick the next one. You decide when to switch, by choosing where to <code>await</code>. This is called <strong>cooperative</strong> scheduling.</p>
  <p>The cost: coroutines are <span class="highlight-green">extremely lightweight</span>. A few kilobytes each. No OS involvement, no context-switch overhead.</p>
</section>

<div class="compare-table reveal">
  <table>
    <thead>
      <tr>
        <th></th>
        <th>Threads</th>
        <th>Coroutines</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td>Switching</td>
        <td>OS decides (preemptive)</td>
        <td>You decide via <code>await</code> (cooperative)</td>
      </tr>
      <tr>
        <td>Memory per unit</td>
        <td>~8MB (Linux) / ~1MB (Windows)</td>
        <td>~kilobytes</td>
      </tr>
      <tr>
        <td>10,000 units</td>
        <td>Crash or severe thrash</td>
        <td>Fine</td>
      </tr>
      <tr>
        <td>Blocking I/O</td>
        <td>Each thread waits independently</td>
        <td>Blocks the whole event loop</td>
      </tr>
      <tr>
        <td>Parallel CPU work</td>
        <td>Yes (different cores)</td>
        <td>No (single thread)</td>
      </tr>
    </tbody>
  </table>
</div>

<div class="analogy reveal">
  <p>Threads are like hiring 10,000 employees and giving each one their own desk, computer, and coffee machine. They all work independently, but you're paying for 10,000 desks. Coroutines are like one very efficient employee with a to-do list who switches tasks whenever they hit a "waiting for reply" moment. Same amount of work gets done, one desk.</p>
</div>

<section class="section reveal">
  <p>Coroutines win for <span class="highlight">I/O-heavy workloads</span> (databases, HTTP calls, file reads) — which is most web API work.</p>
</section>

<!-- SECTION 04: sync def vs async def -->
<section class="section reveal">
  <span class="section-num part4-num">04</span>
  <h2><code>def</code> vs <code>async def</code> in FastAPI</h2>
  <p>FastAPI supports both. And the difference matters more than you think.</p>

  <h3 style="margin-top:2rem;font-size:1.2rem;color:#6c5ce7"><code>async def</code> — runs on the event loop</h3>
  <div class="code-block">
    <pre><span class="code-keyword">@app.get</span>(<span class="code-string">"/users/{id}"</span>)
<span class="code-keyword">async def</span> <span class="code-string">get_user</span>(id: int):
    user = <span class="code-keyword">await</span> db.get_user(id)   <span class="code-comment"># async DB driver (asyncpg, motor, etc.)</span>
    <span class="code-keyword">return</span> user</pre>
  </div>
  <p>FastAPI runs this directly on the event loop. The <code>await</code> calls let the loop do other work during I/O. This is the high-performance path. The rule: if you use <code>async def</code>, every I/O call inside it must be <code>await</code>-ed with an async library.</p>

  <h3 style="margin-top:2rem;font-size:1.2rem;color:#0984e3"><code>def</code> — runs in a thread pool</h3>
  <div class="code-block">
    <pre><span class="code-keyword">@app.get</span>(<span class="code-string">"/users/{id}"</span>)
<span class="code-keyword">def</span> <span class="code-string">get_user</span>(id: int):
    user = db.get_user(id)   <span class="code-comment"># sync DB driver (psycopg2, SQLAlchemy default, etc.)</span>
    <span class="code-keyword">return</span> user</pre>
  </div>
  <p>FastAPI detects that this is a regular function (no <code>async</code>). It automatically runs it in a <strong>thread pool</strong> via <code>run_in_threadpool</code> (which uses <code>anyio.to_thread.run_sync</code> under the hood). The function gets its own thread, so blocking calls are fine — they block that thread, not the event loop. This is FastAPI being smart — it doesn't force you into async-everything.</p>

  <h3 style="margin-top:2rem;font-size:1.1rem;color:#2d3436">When to use which</h3>
  <div class="code-block">
    <pre>You have async libraries (asyncpg, httpx, aiofiles, motor)?
  → use <span class="code-keyword">async def</span>

You have sync libraries (psycopg2, requests, SQLAlchemy sync)?
  → use <span class="code-keyword">def</span>

You have mixed? → separate them, or use run_in_executor manually</pre>
  </div>
</section>

<div class="analogy reveal">
  <p><code>async def</code> is like a chef who can multitask — they start a dish, let it simmer (<code>await</code>), and work on another while waiting. <code>def</code> is like a chef in a separate kitchen — they can take as long as they need because they're not blocking the main kitchen at all.</p>
</div>

<!-- SECTION 05: MULTIPLE AWAITS / asyncio.gather -->
<section class="section reveal">
  <span class="section-num part4-num">05</span>
  <h2>Multiple Awaits in One Request</h2>
  <p>A single endpoint can do multiple I/O operations. Each <code>await</code> is a chance for the event loop to breathe.</p>

  <h3 style="margin-top:2rem;font-size:1.15rem;color:#2d3436">Sequential awaits</h3>
  <div class="code-block">
    <pre><span class="code-keyword">@app.get</span>(<span class="code-string">"/dashboard/{user_id}"</span>)
<span class="code-keyword">async def</span> <span class="code-string">get_dashboard</span>(user_id: int):
    user          = <span class="code-keyword">await</span> db.get_user(user_id)         <span class="code-comment"># pause, resume</span>
    orders        = <span class="code-keyword">await</span> db.get_orders(user_id)       <span class="code-comment"># pause, resume</span>
    notifications = <span class="code-keyword">await</span> get_notifications()          <span class="code-comment"># pause, resume</span>
    <span class="code-keyword">return</span> {<span class="code-string">"user"</span>: user, <span class="code-string">"orders"</span>: orders, <span class="code-string">"notifications"</span>: notifications}</pre>
  </div>
  <p>Three I/O calls. At each <code>await</code>, other requests get to run. But these three calls happen <strong>one after another</strong> — total time is roughly the sum of all three.</p>

  <h3 style="margin-top:2rem;font-size:1.15rem;color:#6c5ce7">Concurrent awaits with <code>asyncio.gather</code></h3>
  <p>If those three calls don't depend on each other, run them concurrently:</p>
  <div class="code-block">
    <pre><span class="code-keyword">import</span> asyncio

<span class="code-keyword">@app.get</span>(<span class="code-string">"/dashboard/{user_id}"</span>)
<span class="code-keyword">async def</span> <span class="code-string">get_dashboard</span>(user_id: int):
    user, orders, notifications = <span class="code-keyword">await</span> asyncio.gather(
        db.get_user(user_id),
        db.get_orders(user_id),
        get_notifications()
    )
    <span class="code-keyword">return</span> {<span class="code-string">"user"</span>: user, <span class="code-string">"orders"</span>: orders, <span class="code-string">"notifications"</span>: notifications}</pre>
  </div>
  <p><code>asyncio.gather</code> fires all three coroutines concurrently — they interleave on the same thread, each pausing at its own <code>await</code> points. This is concurrency, not parallelism: one thread, tasks taking turns, total time determined by the slowest one.</p>
</section>

<!-- Sequential vs Parallel timing visual -->
