          <div class="fs-worker-lbl">Uvicorn W2</div>
          <div class="fs-worker-chain">TCP · HTTP<br>ASGI loop<br>&#8595;<br><span>FastAPI</span><br>&#8595;<br>Your Code</div>
        </div>
        <div class="fs-worker">
          <div class="fs-worker-lbl">Uvicorn W3</div>
