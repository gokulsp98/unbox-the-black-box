---
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { fastapiSeries } from '../../data/series';
const inlineStyle = `
::selection{background:#6c5ce7;color:#fff}

.part7-hero{background:linear-gradient(135deg,#6c5ce7 0%,#0984e3 40%,#00b894 100%)}

.part7-num{color:#6c5ce7;background:#f0efff}

/* ── Hero Art: Production Stack Tower ── */
.tower-art{margin:2.5rem auto 0;animation:fadeInUp 1.5s ease;display:flex;flex-direction:column;align-items:center;gap:0;max-width:20rem;width:100%}
.tower-band{width:100%;text-align:center;padding:0.6rem 1rem;font-family:'Fira Code',monospace;font-size:0.72rem;font-weight:700;letter-spacing:0.03125rem;position:relative}
.tower-band:first-child{border-radius:0.75rem 0.75rem 0 0}
.tower-band:last-child{border-radius:0 0 0.75rem 0.75rem}
.tb-internet{background:rgba(255,255,255,0.18);color:#fff;border:0.0625rem solid rgba(255,255,255,0.3)}
.tb-nginx{background:rgba(0,206,201,0.3);color:#81ecec;border:0.0625rem solid rgba(0,206,201,0.4)}
.tb-gunicorn{background:rgba(108,92,231,0.35);color:#d6ccff;border:0.0625rem solid rgba(108,92,231,0.45)}
.tb-uvicorn{background:rgba(9,132,227,0.3);color:#74b9ff;border:0.0625rem solid rgba(9,132,227,0.4)}
.tb-uvicorn-inner{display:flex;justify-content:center;gap:0.35rem;margin-top:0.3rem}
.tb-uv-box{background:rgba(9,132,227,0.25);border:0.0625rem solid rgba(9,132,227,0.4);border-radius:0.3rem;padding:0.2rem 0.4rem;font-size:0.6rem;color:#a8d8ff}
.tb-fastapi{background:rgba(0,184,148,0.3);color:#55efc4;border:0.0625rem solid rgba(0,184,148,0.4)}
.tower-arrow{color:rgba(255,255,255,0.35);font-size:0.7rem;line-height:1;margin:0;padding:0}
.hero-label-text{font-family:'Fira Code',monospace;font-size:0.75rem;color:rgba(255,255,255,0.6);letter-spacing:0.125rem;text-align:center;margin-top:0.875rem}

/* ── Dev vs Prod table ── */
.dvp-table{width:100%;border-collapse:collapse;margin-top:1.5rem;font-size:0.9rem}
.dvp-table th{text-align:left;padding:0.6rem 1rem;background:#f0efff;color:#6c5ce7;font-weight:800;font-size:0.8rem;letter-spacing:0.03125rem}
.dvp-table td{padding:0.6rem 1rem;border-bottom:0.0625rem solid #f1f3f4;vertical-align:top;line-height:1.5}
.dvp-table tr:last-child td{border-bottom:none}
.dvp-table .td-concern{font-weight:700;color:#2d3436;width:36%}
.dvp-table .td-dev{color:#636e72;width:32%}
.dvp-table .td-prod{color:#00b894;font-weight:600;width:32%}
.dvp-table tr:hover td{background:#fafafa}

/* ── Nginx config ── */
.nginx-block{background:#1e272e;border-radius:1rem;overflow:hidden;margin:1.5rem 0}
.nginx-section-label{font-family:'Fira Code',monospace;font-size:0.65rem;font-weight:700;letter-spacing:0.09375rem;padding:0.35rem 1rem;display:block}
.nginx-label-static{background:rgba(0,184,148,0.18);color:#55efc4;border-left:0.1875rem solid #00b894}
.nginx-label-proxy{background:rgba(9,132,227,0.18);color:#74b9ff;border-left:0.1875rem solid #0984e3}
.nginx-label-upstream{background:rgba(108,92,231,0.18);color:#a29bfe;border-left:0.1875rem solid #6c5ce7}

/* ── Full stack diagram ── */
.fullstack{max-width:36rem;margin:2rem auto;padding:0 1.5rem}
.fs-outer{background:#1a1f2e;border-radius:1.25rem;padding:1.5rem;border:0.0625rem solid rgba(108,92,231,0.3)}
.fs-internet{background:rgba(255,255,255,0.07);border:0.0625rem solid rgba(255,255,255,0.15);border-radius:0.75rem;padding:0.75rem 1rem;text-align:center;margin-bottom:0.5rem}
.fs-internet-lbl{font-family:'Fira Code',monospace;font-size:0.75rem;font-weight:700;color:#dfe6e9}
.fs-arrow{text-align:center;font-size:0.8rem;color:rgba(255,255,255,0.25);padding:0.2rem 0;font-family:'Fira Code',monospace}
.fs-nginx{background:rgba(0,206,201,0.1);border:0.0625rem solid rgba(0,206,201,0.3);border-radius:0.875rem;padding:0.875rem 1rem;margin-bottom:0.5rem}
.fs-layer-title{font-family:'Fira Code',monospace;font-size:0.72rem;font-weight:700;letter-spacing:0.03125rem;margin-bottom:0.3rem}
.fs-nginx .fs-layer-title{color:#81ecec}
.fs-layer-details{font-family:'Fira Code',monospace;font-size:0.6rem;color:#636e72;line-height:1.7}
.fs-gunicorn{background:rgba(108,92,231,0.1);border:0.0625rem solid rgba(108,92,231,0.3);border-radius:0.875rem;padding:0.875rem 1rem;margin-bottom:0.5rem}
.fs-gunicorn .fs-layer-title{color:#a29bfe}
.fs-workers-row{display:grid;grid-template-columns:repeat(4,1fr);gap:0.5rem;margin-top:0.625rem}
.fs-worker{background:rgba(9,132,227,0.1);border:0.0625rem solid rgba(9,132,227,0.25);border-radius:0.625rem;padding:0.5rem 0.35rem;text-align:center}
.fs-worker-lbl{font-family:'Fira Code',monospace;font-size:0.58rem;font-weight:700;color:#74b9ff;margin-bottom:0.25rem}
.fs-worker-chain{font-family:'Fira Code',monospace;font-size:0.52rem;color:#636e72;line-height:1.6}
.fs-worker-chain span{color:#55efc4}
@media(max-width:37.5rem){.fs-workers-row{grid-template-columns:repeat(2,1fr)}}

/* ── Cloud deployment cards ── */
.cloud-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(14rem,1fr));gap:1.25rem;max-width:56rem;margin:2rem auto;padding:0 1.5rem}
.cloud-card{border-radius:1rem;padding:1.5rem;transition:transform 0.3s}
.cloud-card:hover{transform:translateY(-0.25rem)}
.cloud-card h4{font-size:1rem;font-weight:800;margin-bottom:0.5rem}
.cloud-card p{font-size:0.82rem;line-height:1.6}
.cloud-badge{font-family:'Fira Code',monospace;font-size:0.65rem;font-weight:700;padding:0.25rem 0.625rem;border-radius:0.375rem;display:inline-block;margin-bottom:0.625rem;letter-spacing:0.0625rem}
.cloud-flow{font-family:'Fira Code',monospace;font-size:0.62rem;line-height:1.8;color:#636e72;margin-top:0.75rem;background:#f8f9fa;border-radius:0.5rem;padding:0.625rem 0.75rem}
.cc-aws{background:#fff3cd;border:0.125rem solid #ffc107}
.cc-aws h4{color:#856404}
.cc-aws .cloud-badge{background:rgba(255,193,7,0.2);color:#856404;border:0.0625rem solid rgba(255,193,7,0.4)}
.cc-simple{background:#e8f8f5;border:0.125rem solid #b8f0e0}
.cc-simple h4{color:#00b894}
.cc-simple .cloud-badge{background:rgba(0,184,148,0.15);color:#00b894;border:0.0625rem solid rgba(0,184,148,0.35)}
.cc-serverless{background:#f0efff;border:0.125rem solid #d5ccff}
.cc-serverless h4{color:#6c5ce7}
.cc-serverless .cloud-badge{background:rgba(108,92,231,0.15);color:#6c5ce7;border:0.0625rem solid rgba(108,92,231,0.3)}

/* ── Layer ownership table ── */
.layer-own{width:100%;border-collapse:collapse;margin-top:1.5rem;font-size:0.87rem}
.layer-own th{text-align:left;padding:0.625rem 1rem;background:#2d3436;color:#dfe6e9;font-weight:700;font-size:0.78rem;letter-spacing:0.03125rem}
.layer-own td{padding:0.625rem 1rem;border-bottom:0.0625rem solid #f1f3f4;vertical-align:top;line-height:1.5}
.layer-own tr:last-child td{border-bottom:none}
.layer-own tr:hover td{background:#fafafa}
.lo-name{font-weight:800}
.lo-nginx{color:#00cec9}
.lo-gunicorn{color:#6c5ce7}
.lo-uvicorn{color:#0984e3}
.lo-fastapi{color:#00b894}
.lo-code{color:#e17055}

/* ── Series recap timeline ── */
.recap-timeline{max-width:44rem;margin:2rem auto;padding:0 1.5rem}
.recap-item{display:grid;grid-template-columns:5rem 1fr;gap:1rem;padding:1.25rem 0;border-bottom:0.0625rem solid #f1f3f4;align-items:start}
.recap-item:last-child{border-bottom:none}
.recap-ep{font-family:'Fira Code',monospace;font-size:0.7rem;font-weight:700;color:#fff;background:#6c5ce7;border-radius:0.5rem;padding:0.375rem 0.5rem;text-align:center;line-height:1.3;flex-shrink:0}
.recap-body h4{font-size:0.95rem;font-weight:800;color:#2d3436;margin-bottom:0.25rem}
.recap-body p{font-size:0.83rem;color:#636e72;line-height:1.55;margin:0}

/* ── Finale Banner ── */
.finale-banner{background:linear-gradient(135deg,#6c5ce7,#0984e3,#00b894);padding:5rem 1.5rem;text-align:center;color:#fff;position:relative;overflow:hidden}
.finale-banner::before{content:'';position:absolute;width:25rem;height:25rem;border-radius:50%;background:rgba(255,255,255,0.04);top:-6.25rem;right:-6.25rem;animation:float 8s ease-in-out infinite}
.finale-banner h2{color:#fff;font-size:clamp(1.8rem,4vw,2.8rem);margin-bottom:0.75rem}
.finale-banner p{color:rgba(255,255,255,0.9);max-width:34.375rem;margin:0 auto 1.75rem;font-size:1.05rem}
.finale-badge{display:inline-block;background:rgba(255,255,255,0.2);border:0.0625rem solid rgba(255,255,255,0.3);padding:0.5rem 1.25rem;border-radius:1.875rem;font-size:0.85rem;font-weight:700;letter-spacing:0.0625rem;margin-bottom:1.25rem}

/* ── Quiz theming: Episode 7 ── */
.quiz-ep7 .quiz-q-num{color:#6c5ce7;background:#f0efff}
.quiz-ep7 .quiz-reveal-btn{color:#6c5ce7}
.quiz-ep7 .quiz-opt-letter{color:#6c5ce7}
.quiz-ep7 .quiz-option:hover{border-color:#6c5ce7;background:#f7f5ff}
.quiz-ep7 .quiz-answer-highlight{background:#f0efff;border-left:0.25rem solid #6c5ce7}
.quiz-ep7 .quiz-sequence-item:hover{border-color:#6c5ce7;background:#f7f5ff}
`;
const bodyHtml = `

<!-- HERO -->
<section class="hero part7-hero">
  <div class="hero-badge">Episode 7 of 7 &mdash; Finale</div>
  <h1>The Full<br>Production Stack</h1>
  <p style="color:rgba(255,255,255,0.95)">In development, one command hides everything. In production, there are 4–5 layers between the internet and your function. This is where it all comes together.</p>

  <div class="tower-art">
    <div class="tower-band tb-internet">Internet (HTTPS)</div>
    <div class="tower-arrow">&#8595;</div>
    <div style="font-family:'Fira Code',monospace;font-size:0.55rem;color:rgba(255,255,255,0.4);text-align:center;margin:-0.125rem 0">HTTPS request</div>
    <div class="tower-band tb-nginx">Nginx — SSL · static files · rate limiting · reverse proxy</div>
    <div class="tower-arrow">&#8595;</div>
    <div style="font-family:'Fira Code',monospace;font-size:0.55rem;color:rgba(255,255,255,0.4);text-align:center;margin:-0.125rem 0">HTTP (SSL stripped)</div>
    <div class="tower-band tb-gunicorn">Gunicorn — process manager · graceful restarts · supervision</div>
    <div class="tower-arrow">&#8595;</div>
    <div style="font-family:'Fira Code',monospace;font-size:0.55rem;color:rgba(255,255,255,0.4);text-align:center;margin:-0.125rem 0">connection forwarded to worker</div>
    <div class="tower-band tb-uvicorn">
      Uvicorn Workers — HTTP · ASGI · event loop
      <div class="tb-uvicorn-inner">
        <span class="tb-uv-box">W1</span>
        <span class="tb-uv-box">W2</span>
        <span class="tb-uv-box">W3</span>
        <span class="tb-uv-box">W4</span>
      </div>
    </div>
    <div class="tower-arrow">&#8595;</div>
    <div style="font-family:'Fira Code',monospace;font-size:0.55rem;color:rgba(255,255,255,0.4);text-align:center;margin:-0.125rem 0">ASGI call: scope + receive + send</div>
    <div class="tower-band tb-fastapi">FastAPI + Your Code — routing · validation · business logic</div>
  </div>
  <div class="hero-label-text">every layer does exactly one job</div>
</section>

<!-- SECTION 01: FROM LAPTOP TO PRODUCTION -->
<section class="section reveal">
  <span class="section-num part7-num">01</span>
  <h2>From Laptop to Production</h2>
  <p>When you run <code>fastapi dev main.py</code> in development, a lot gets hidden:</p>
  <ul style="margin:1rem 0 1rem 1.5rem;line-height:2">
    <li>A single Uvicorn worker starts behind the scenes</li>
    <li>Auto-reload watches your files for changes</li>
    <li>It only listens on <code>127.0.0.1</code> — only you can reach it</li>
    <li>There is no SSL, no load balancing, no static file serving, no process supervision</li>
  </ul>
  <p>This is great for writing code. It is terrible for serving real users.</p>
  <p>Here is what changes when you go to production:</p>

  <div style="overflow-x:auto;margin-top:1.25rem">
    <table class="dvp-table">
      <thead>
        <tr>
          <th class="td-concern">Concern</th>
          <th class="td-dev">Development</th>
          <th class="td-prod">Production</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td class="td-concern">SSL / HTTPS</td>
          <td class="td-dev">No</td>
          <td class="td-prod">Nginx or cloud load balancer</td>
        </tr>
        <tr>
          <td class="td-concern">Static files</td>
          <td class="td-dev">Served by Python</td>
          <td class="td-prod">Nginx — Python never touched</td>
        </tr>
        <tr>
          <td class="td-concern">Multiple workers</td>
          <td class="td-dev">1</td>
          <td class="td-prod">4+ (Gunicorn + Uvicorn)</td>
        </tr>
        <tr>
          <td class="td-concern">Crashed worker recovery</td>
          <td class="td-dev">You notice and restart</td>
          <td class="td-prod">Gunicorn restarts automatically</td>
        </tr>
        <tr>
          <td class="td-concern">Zero-downtime deploys</td>
          <td class="td-dev">Restart = downtime</td>
          <td class="td-prod">Gunicorn graceful reload</td>
        </tr>
        <tr>
          <td class="td-concern">External traffic</td>
          <td class="td-dev">Localhost only</td>
          <td class="td-prod">Public interface, firewall, rate limits</td>
        </tr>
      </tbody>
    </table>
  </div>

  <p style="margin-top:1.25rem">Every one of those production concerns is handled by a different layer. You don't bolt them all onto FastAPI — you add the right tool for the right job.</p>
</section>

<div class="analogy reveal">
  <p><code>fastapi dev</code> is like cooking a meal in your kitchen for yourself. Production is like running a restaurant. You need a front-of-house, a kitchen manager, line cooks, and a host at the door. The chef (your code) is still the same — but the supporting structure around them is completely different.</p>
</div>

<!-- SECTION 02: NGINX — THE FRONT DOOR -->
<section class="section reveal">
  <span class="section-num part7-num">02</span>
  <h2>Nginx — The Front Door</h2>
  <p>The first thing that receives a request from the internet is not Python. It is not even Gunicorn. It is <span class="highlight">Nginx</span> — a battle-hardened, high-performance reverse proxy written in C. It handles the kinds of work that Python should never have to touch.</p>

  <h3 style="margin-top:2rem;font-size:1.2rem;color:#00cec9">SSL/TLS Termination</h3>
  <p>HTTPS is encrypted. Someone has to decrypt it before your app can read the request. That someone is Nginx.</p>
</section>

<div class="reveal" style="max-width:50rem;margin:0 auto;padding:0 1.5rem">
  <div class="flow">
    <div class="flow-box fb-dark">Client<br><small>HTTPS encrypted</small></div>
    <div class="flow-arrow">&#10132;</div>
    <div class="flow-box" style="background:#e0fafa;border:0.125rem solid #b2ebf2;color:#2d3436">Nginx<br><small>decrypt TLS</small></div>
    <div class="flow-arrow">&#10132;</div>
    <div class="flow-box fb-purple">Gunicorn<br><small>HTTP plain</small></div>
  </div>
</div>

<section class="section reveal">
  <p>Nginx holds your TLS certificate, handles the handshake, decrypts the traffic, and forwards plain HTTP to your app internally. Your Python code never deals with TLS. TLS handshakes are expensive — Nginx is extremely fast at them. FastAPI is not designed for this at all.</p>

  <h3 style="margin-top:2rem;font-size:1.2rem;color:#00b894">Static File Serving</h3>
  <p>In development, FastAPI's <code>StaticFiles</code> mount handles static assets fine. In production, this is wasteful — you are spinning up a Python event loop to serve a file that sits on disk. Nginx serves static files directly from the filesystem without touching Python at all. For a 200 KB image, Nginx reads the file and sends it — Python never wakes up.</p>

  <h3 style="margin-top:2rem;font-size:1.2rem;color:#0984e3">The Config</h3>
</section>

<div class="fullstack reveal" style="max-width:44rem">
  <div class="nginx-block">
    <span class="nginx-section-label nginx-label-static"># STATIC FILES — served by Nginx, Python never touched</span>
    <div class="code-block" style="margin:0;border-radius:0">
      <pre>server {
    location /static/ {
        root /app;
        expires 1y;
        add_header Cache-Control <span class="code-string">"public, immutable"</span>;
    }</pre>
    </div>
    <span class="nginx-section-label nginx-label-proxy"># API REQUESTS — forwarded to Gunicorn/Uvicorn</span>
    <div class="code-block" style="margin:0;border-radius:0">
      <pre>    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}</pre>
    </div>
  </div>
</div>

<section class="section reveal">
  <h3 style="font-size:1.2rem;color:#6c5ce7">Load Balancing</h3>
  <p>If you are running multiple app servers (multiple machines, not just multiple workers), Nginx distributes requests across them:</p>

  <div class="nginx-block" style="max-width:36rem">
    <span class="nginx-section-label nginx-label-upstream"># MULTIPLE SERVERS — round-robin by default</span>
    <div class="code-block" style="margin:0;border-radius:0">
      <pre>upstream fastapi_servers {
    server 10.0.0.1:8000;
    server 10.0.0.2:8000;
    server 10.0.0.3:8000;
}

server {
    location / {
        proxy_pass http://fastapi_servers;
    }
}</pre>
    </div>
  </div>

  <h3 style="margin-top:2rem;font-size:1.2rem;color:#e17055">Protection</h3>
  <p>Nginx sits between the raw internet and your app. It provides:</p>
  <div class="info-grid" style="margin-top:1rem">
    <div class="info-card">
      <div class="info-icon">&#128683;</div>
      <h4>Rate Limiting</h4>
      <p>Blocks clients making too many requests per second before they reach Python.</p>
    </div>
    <div class="info-card">
      <div class="info-icon">&#128260;</div>
      <h4>Request Buffering</h4>
      <p>Reads the full request before forwarding to Python — protects against slowloris attacks.</p>
    </div>
    <div class="info-card">
      <div class="info-icon">&#128274;</div>
      <h4>Connection Limits</h4>
      <p>Caps how many simultaneous connections any single IP can hold open.</p>
    </div>
    <div class="info-card">
      <div class="info-icon">&#9878;</div>
      <h4>Request Size Limits</h4>
      <p>Rejects oversized request bodies before they ever reach your app.</p>
    </div>
  </div>
</section>

<!-- SECTION 03: GUNICORN — THE PROCESS MANAGER -->
<section class="section reveal">
  <span class="section-num part7-num">03</span>
  <h2>Gunicorn — The Process Manager</h2>
  <p>Nginx forwards traffic to your app. But your app isn't a single Python process — it is a fleet of workers managed by <span class="highlight">Gunicorn</span>. In a production context, it earns its place in a few specific ways.</p>

  <h3 style="margin-top:2rem;font-size:1.2rem;color:#6c5ce7">The Command</h3>

  <div class="code-block">
    <pre>gunicorn main:app <span class="code-keyword">-k</span> uvicorn.workers.UvicornWorker <span class="code-keyword">-w</span> 4 <span class="code-keyword">--bind</span> 0.0.0.0:8000</pre>
  </div>

  <div style="display:grid;gap:0.75rem;margin-top:1rem;grid-template-columns:repeat(auto-fit,minmax(14rem,1fr))">
    <div style="background:#f0efff;border-radius:0.75rem;padding:1rem 1.25rem;border-left:0.1875rem solid #6c5ce7">
      <code style="color:#6c5ce7;font-size:0.8rem;font-weight:700">main:app</code>
      <p style="font-size:0.82rem;margin-top:0.375rem;color:#555">Import <code>app</code> from <code>main.py</code></p>
    </div>
    <div style="background:#e3f2fd;border-radius:0.75rem;padding:1rem 1.25rem;border-left:0.1875rem solid #0984e3">
      <code style="color:#0984e3;font-size:0.8rem;font-weight:700">-k uvicorn.workers.UvicornWorker</code>
      <p style="font-size:0.82rem;margin-top:0.375rem;color:#555">Each worker is a Uvicorn worker, not a standard sync worker</p>
    </div>
    <div style="background:#e8f8f5;border-radius:0.75rem;padding:1rem 1.25rem;border-left:0.1875rem solid #00b894">
      <code style="color:#00b894;font-size:0.8rem;font-weight:700">-w 4</code>
      <p style="font-size:0.82rem;margin-top:0.375rem;color:#555">Spawn 4 worker processes — rule of thumb: 2&times;CPU cores + 1</p>
    </div>
    <div style="background:#fef5e7;border-radius:0.75rem;padding:1rem 1.25rem;border-left:0.1875rem solid #e17055">
      <code style="color:#e17055;font-size:0.8rem;font-weight:700">--bind 0.0.0.0:8000</code>
      <p style="font-size:0.82rem;margin-top:0.375rem;color:#555">Listen on all network interfaces, port 8000</p>
    </div>
  </div>

  <h3 style="margin-top:2rem;font-size:1.2rem;color:#6c5ce7">Graceful Restarts</h3>
  <p>When you deploy a new version, you need to restart workers. Without care, in-flight requests get dropped mid-response. Gunicorn handles this with a signal:</p>

  <div class="code-block">
    <pre>kill <span class="code-keyword">-HUP</span> &lt;gunicorn_master_pid&gt;</pre>
  </div>
</section>

<div class="timeline reveal" style="max-width:43.75rem;margin:1.5rem auto;padding:0 1.5rem 0 4rem">
  <div class="timeline-item">
    <div class="timeline-year">Step 1 + 2<br><small style="font-weight:400;opacity:0.7">(simultaneous)</small></div>
    <div class="timeline-text">Old workers stop accepting new connections and begin draining in-flight requests. Gunicorn immediately spawns new workers with the updated code.</div>
  </div>
  <div class="timeline-item">
    <div class="timeline-year">Step 3</div>
    <div class="timeline-text">New workers initialize — incoming requests may queue briefly until the new workers are ready to accept traffic. The duration depends on your app's startup time.</div>
  </div>
  <div class="timeline-item">
    <div class="timeline-year">Result</div>
    <div class="timeline-text">In-flight requests on old workers complete cleanly. For apps with fast startup, the gap is negligible. For slow-starting apps, use <code>SIGUSR2</code> instead — it keeps the old master and workers alive and serving traffic while spinning up an entirely new master and worker fleet, achieving true zero-downtime restarts.</div>
  </div>
</div>

<section class="section reveal">
  <h3 style="font-size:1.2rem;color:#6c5ce7">Crashed Worker Recovery</h3>
  <p>Workers crash. Memory errors, unhandled exceptions, operating system kills. Gunicorn watches each worker process. If one dies, it spawns a replacement immediately — before the next request arrives needing that slot. Without a process manager, a crashed worker is gone until you notice and manually restart it.</p>

  <h3 style="margin-top:2rem;font-size:1.2rem;color:#6c5ce7">Pre-Fork Model</h3>
  <p>Gunicorn uses the <span class="highlight">pre-fork model</span>: it forks all workers before any traffic arrives. The workers are sitting ready, not spinning up on demand. When a request comes in, a worker is already waiting. This keeps response times predictable even under a burst of simultaneous requests.</p>
</section>

<!-- SECTION 04: THE COMPLETE STACK -->
<section class="section reveal">
  <span class="section-num part7-num">04</span>
  <h2>The Complete Stack</h2>
  <p>Here is every layer, end to end. Everything this series has covered lives inside one of these boxes.</p>
</section>

<div class="fullstack reveal">
  <div class="fs-outer">
    <div class="fs-internet">
      <div class="fs-internet-lbl">&#127760; Internet (HTTPS)</div>
    </div>
