---
import HomepageLayout from '../layouts/HomepageLayout.astro';

const base = import.meta.env.BASE_URL;

const inlineStyle = `
/* ── HOMEPAGE HERO ── */
.home-hero{background:linear-gradient(135deg,#2d3436 0%,#0c2461 50%,#6c5ce7 100%);position:relative}
.home-hero h1{font-size:clamp(2.2rem,5.5vw,3.8rem);margin-bottom:1.5rem}
.home-hero h1 span{display:block;background:linear-gradient(90deg,#a29bfe,#74b9ff,#55efc4);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
.home-hero p{max-width:32.5rem;color:rgba(255,255,255,0.95);font-size:clamp(1rem,2.5vw,1.2rem)}
.home-hero .hero-label{font-family:'Fira Code',monospace;font-size:0.8rem;color:#a29bfe;letter-spacing:3px;text-transform:uppercase;margin-bottom:0.75rem;animation:fadeInDown 0.8s ease}

/* ── SCROLL CUE ── */
.scroll-cue{margin-top:2.5rem;animation:softBounce 2.5s ease infinite}
.scroll-cue svg{opacity:0.4;transition:opacity 0.3s}
.scroll-cue:hover svg{opacity:0.7}
@keyframes softBounce{0%,100%{transform:translateY(0)}50%{transform:translateY(8px)}}

/* ── SERIES SECTION ── */
.series-section{padding:5rem 1.5rem;max-width:56.25rem;margin:0 auto}
.series-section h2{text-align:center;margin-bottom:0.5rem}
.series-section>p{text-align:center;max-width:31.25rem;margin:0 auto 3rem;color:#888;font-size:1rem}

.series-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(18.75rem,1fr));gap:1.75rem}

.series-card{background:#fff;border-radius:1.25rem;overflow:hidden;transition:all 0.4s cubic-bezier(0.25,0.46,0.45,0.94);border:1px solid #eee;text-decoration:none;color:#2d3436;display:flex;flex-direction:column}
.series-card:hover{transform:translateY(-8px);box-shadow:0 24px 60px rgba(0,0,0,0.08);border-color:transparent}

.card-banner{height:11.25rem;display:flex;align-items:center;justify-content:center;position:relative;overflow:hidden}
.card-banner .card-icon{font-size:3.5rem;z-index:2;filter:drop-shadow(0 4px 12px rgba(0,0,0,0.15))}
.card-banner::after{content:'';position:absolute;width:8.75rem;height:8.75rem;border-radius:50%;background:rgba(255,255,255,0.08);bottom:-2.5rem;right:-2.5rem}

.card-body{padding:1.5rem 1.75rem;flex:1;display:flex;flex-direction:column}
.card-series-label{font-family:'Fira Code',monospace;font-size:0.7rem;font-weight:600;text-transform:uppercase;letter-spacing:2px;margin-bottom:0.5rem}
.card-body h3{font-size:1.25rem;font-weight:800;margin-bottom:0.5rem;line-height:1.3}
.card-body p{font-size:0.9rem;color:#777;line-height:1.7;flex:1}
.card-meta{display:flex;gap:0.5rem;margin-top:1rem;flex-wrap:wrap}
.card-tag{font-size:0.7rem;font-weight:700;padding:0.25rem 0.75rem;border-radius:1.25rem;background:#f5f5f5;color:#888}

/* ── ABOUT SECTION ── */
.about-section{background:#fafafa;padding:5rem 1.5rem;border-top:1px solid #f0f0f0}
.about-inner{max-width:37.5rem;margin:0 auto;text-align:center}
.about-inner h2{margin-bottom:0.75rem;font-size:1.6rem}
.about-inner p{color:#888;font-size:0.95rem;line-height:1.8}

/* ── STATS ── */
.stats{display:flex;justify-content:center;gap:3.5rem;margin-top:2.25rem;flex-wrap:wrap}
.stat{text-align:center}
.stat-num{font-size:2.2rem;font-weight:900;color:#6c5ce7;display:block}
.stat-label{font-size:0.8rem;color:#aaa;font-weight:700;text-transform:uppercase;letter-spacing:1px}

/* ── CONTACT SECTION ── */
.contact-section{padding:2rem 1.5rem;text-align:center;background:#fafafa;border-top:1px solid #f0f0f0}
.contact-inner{max-width:31.25rem;margin:0 auto;display:flex;align-items:center;justify-content:center;gap:1rem;flex-wrap:wrap}
.contact-inner p{color:#888;font-size:0.9rem;margin-bottom:0}
.contact-btn{font-weight:700;font-size:0.85rem;color:#6c5ce7;text-decoration:none;padding:0.375rem 1.25rem;border:2px solid #6c5ce7;border-radius:1.25rem;transition:all 0.3s}
.contact-btn:hover{background:#6c5ce7;color:#fff}
`;
---
<HomepageLayout title="Unbox the Black Box — From confusion to clarity" inlineStyle={inlineStyle}>

<!-- HERO -->
<section class="hero home-hero">
  <div class="hero-label">Gokul's Learning Journal</div>
  <h1><span>Unbox the Black Box</span></h1>
  <p>Complex topics broken down into simple, visual, and memorable stories.</p>

  <a href="#series" class="scroll-cue" style="text-decoration:none">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round"><path d="M7 10l5 5 5-5"/></svg>
  </a>
</section>

<!-- SERIES -->
<section class="series-section" id="series">
  <h2>Learning Series</h2>
  <p>Each series takes one big topic and breaks it into digestible parts.</p>

  <div class="series-grid">

    <!-- CPU SERIES -->
    <a href={`${base}cpu/part1.html`} class="series-card">
      <div class="card-banner" style="background:linear-gradient(135deg,#6c5ce7,#0984e3)">
        <span class="card-icon">&#129504;</span>
      </div>
      <div class="card-body">
        <div class="card-series-label" style="color:#6c5ce7">SERIES 01</div>
        <h3>How Your Code Runs</h3>
        <p>From source code to binary — how C, Java, Python, and JavaScript each take a different path to make your CPU do things.</p>
        <div class="card-meta">
          <span class="card-tag">7 Episodes</span>
          <span class="card-tag">45 min read</span>
          <span class="card-tag">Beginner</span>
        </div>
      </div>
    </a>

    <!-- FASTAPI SERIES -->
    <a href={`${base}fastapi/part1.html`} class="series-card">
      <div class="card-banner" style="background:linear-gradient(135deg,#00b894,#0984e3)">
        <span class="card-icon">&#9889;</span>
      </div>
      <div class="card-body">
        <div class="card-series-label" style="color:#00b894">SERIES 02</div>
        <h3>How FastAPI Works</h3>
        <p>From <code style="font-size:0.85rem">fastapi dev</code> to production — Uvicorn, ASGI, event loops, coroutines, workers, and every layer in between.</p>
        <div class="card-meta">
          <span class="card-tag">7 Episodes</span>
          <span class="card-tag">50 min read</span>
          <span class="card-tag">Intermediate</span>
        </div>
      </div>
    </a>

    <!-- CLAUDE CODE SERIES -->
    <a href={`${base}claude-code/part1.html`} class="series-card">
      <div class="card-banner" style="background:linear-gradient(135deg,#7b68ee,#4682b4)">
        <svg class="card-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100" width="56" height="56" fill="#F4845F" style="filter:drop-shadow(0 4px 12px rgba(0,0,0,0.15))"><path d="m19.6 66.5 19.7-11 .3-1-.3-.5h-1l-3.3-.2-11.2-.3L14 53l-9.5-.5-2.4-.5L0 49l.2-1.5 2-1.3 2.9.2 6.3.5 9.5.6 6.9.4L38 49.1h1.6l.2-.7-.5-.4-.4-.4L29 41l-10.6-7-5.6-4.1-3-2-1.5-2-.6-4.2 2.7-3 3.7.3.9.2 3.7 2.9 8 6.1L37 36l1.5 1.2.6-.4.1-.3-.7-1.1L33 25l-6-10.4-2.7-4.3-.7-2.6c-.3-1-.4-2-.4-3l3-4.2L28 0l4.2.6L33.8 2l2.6 6 4.1 9.3L47 29.9l2 3.8 1 3.4.3 1h.7v-.5l.5-7.2 1-8.7 1-11.2.3-3.2 1.6-3.8 3-2L61 2.6l2 2.9-.3 1.8-1.1 7.7L59 27.1l-1.5 8.2h.9l1-1.1 4.1-5.4 6.9-8.6 3-3.5L77 13l2.3-1.8h4.3l3.1 4.7-1.4 4.9-4.4 5.6-3.7 4.7-5.3 7.1-3.2 5.7.3.4h.7l12-2.6 6.4-1.1 7.6-1.3 3.5 1.6.4 1.6-1.4 3.4-8.2 2-9.6 2-14.3 3.3-.2.1.2.3 6.4.6 2.8.2h6.8l12.6 1 3.3 2 1.9 2.7-.3 2-5.1 2.6-6.8-1.6-16-3.8-5.4-1.3h-.8v.4l4.6 4.5 8.3 7.5L89 80.1l.5 2.4-1.3 2-1.4-.2-9.2-7-3.6-3-8-6.8h-.5v.7l1.8 2.7 9.8 14.7.5 4.5-.7 1.4-2.6 1-2.7-.6-5.8-8-6-9-4.7-8.2-.5.4-2.9 30.2-1.3 1.5-3 1.2-2.5-2-1.4-3 1.4-6.2 1.6-8 1.3-6.4 1.2-7.9.7-2.6v-.2H49L43 72l-9 12.3-7.2 7.6-1.7.7-3-1.5.3-2.8L24 86l10-12.8 6-7.9 4-4.6-.1-.5h-.3L17.2 77.4l-4.7.6-2-2 .2-3 1-1 8-5.5Z"/></svg>
      </div>
      <div class="card-body">
        <div class="card-series-label" style="color:#7b68ee">SERIES 03</div>
        <h3>How Claude Code Works</h3>
        <p>From tokens to compaction — how your AI conversations actually work under the hood.</p>
        <div class="card-meta">
          <span class="card-tag">7 Episodes</span>
          <span class="card-tag">40 min read</span>
          <span class="card-tag">Beginner</span>
        </div>
      </div>
    </a>

    <!-- FRONTEND SERIES -->
    <a href={`${base}frontend/part1.html`} class="series-card">
      <div class="card-banner" style="background:linear-gradient(135deg,#e17055,#0984e3)">
        <span class="card-icon">🌐</span>
      </div>
      <div class="card-body">
        <div class="card-series-label" style="color:#e17055">SERIES 04</div>
        <h3>How the Frontend Works</h3>
        <p>From the 1991 web to Vite — JavaScript, the DOM, Node.js, npm, frameworks, build tools, and how it all connects.</p>
        <div class="card-meta">
          <span class="card-tag">22 Episodes</span>
          <span class="card-tag">90 min read</span>
          <span class="card-tag">Beginner</span>
        </div>
      </div>
    </a>

  </div>
</section>

<!-- ABOUT -->
<section class="about-section">
  <div class="about-inner">
    <h2>What is Unbox the Black Box?</h2>
    <p>A personal learning journal where complex tech topics become visual, story-driven explanations. Every article starts from zero — no assumed knowledge — and builds to a clear understanding.</p>

    <div class="stats">
      <div class="stat">
        <span class="stat-num">4</span>
        <span class="stat-label">Series</span>
      </div>
      <div class="stat">
        <span class="stat-num">43</span>
        <span class="stat-label">Episodes</span>
      </div>
      <div class="stat">
        <span class="stat-num">60+</span>
        <span class="stat-label">Concepts</span>
      </div>
    </div>
  </div>
</section>

<!-- CONTACT -->
<section class="contact-section">
  <div class="contact-inner">
    <p>Got feedback or a topic suggestion?</p>
    <a href="mailto:gokulprem098@gmail.com" class="contact-btn">Send an Email</a>
  </div>
</section>

</HomepageLayout>
